<Window x:Class="ANLAbel.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel License Master" Width="720" Height="590" WindowStartupLocation="CenterScreen"
        Background="#F4F7FB" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="ANLAbel License Master" FontSize="26" FontWeight="Bold" Foreground="#153B66"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,22" Text="Ứng dụng nội bộ — tạo key kích hoạt đã ký số cho đúng mã máy." Foreground="#52657A"/>
        <StackPanel Grid.Row="2"><TextBlock Text="Mã máy khách hàng" FontWeight="SemiBold"/><TextBox x:Name="MachineCodeBox" Margin="0,6,0,14" Padding="9" FontFamily="Consolas"/></StackPanel>
        <StackPanel Grid.Row="3"><TextBlock Text="Tên khách hàng / công ty" FontWeight="SemiBold"/><TextBox x:Name="CustomerBox" Margin="0,6,0,14" Padding="9"/></StackPanel>
        <Grid Grid.Row="4" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="PermanentBox" Content="Key vĩnh viễn" IsChecked="True" VerticalAlignment="Center" Checked="ExpiryChanged" Unchecked="ExpiryChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Hết hạn:" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="ExpiryPicker" SelectedDate="2030-12-31" IsEnabled="False"/></StackPanel>
        </Grid>
        <StackPanel Grid.Row="5"><Button Content="TẠO KEY KÍCH HOẠT" Height="42" Background="#1769AA" Foreground="White" FontWeight="Bold" Click="Generate_Click"/><TextBlock Text="Key đã ký" Margin="0,15,0,6" FontWeight="SemiBold"/><TextBox x:Name="KeyBox" Height="125" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#52657A" Margin="0,0,16,0"/><Button Content="Sao chép key" Padding="18,8" Click="Copy_Click"/></StackPanel>
    </Grid>
</Window>
