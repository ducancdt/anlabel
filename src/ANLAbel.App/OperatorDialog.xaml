<Window x:Class="ANLAbel.App.OperatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}"
        AutomationProperties.AutomationId="OperatorDialog">
    <!-- Figma: ANLAbel-Shell 36:137 (Plan 13 states), dialogs 36:150 / 36:188 / 36:201 / 36:216 / 37:269. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   AutomationProperties.AutomationId="OperatorDialog.Heading"/>
        <ItemsControl x:Name="LinesList" Focusable="False" AutomationProperties.AutomationId="OperatorDialog.Lines">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="DetailText"
                   FontSize="11"
                   Foreground="{DynamicResource AppMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="Collapsed"
                   AutomationProperties.AutomationId="OperatorDialog.Detail"/>
        <StackPanel x:Name="ButtonsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,6,0,0"
                    AutomationProperties.AutomationId="OperatorDialog.Buttons"/>
    </StackPanel>
</Window>
