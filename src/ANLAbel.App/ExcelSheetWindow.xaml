<Window x:Class="ANLAbel.App.ExcelSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Excel Sheet" Height="260" Width="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sheet" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox x:Name="SheetsList" Grid.Row="1" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="82" Margin="0,0,8,0" Padding="8,5" Click="Cancel_Click"/>
            <Button Content="Import" Width="82" Padding="8,5" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
