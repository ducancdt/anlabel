<Window x:Class="ANLAbel.App.ExcelHeaderRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn hàng tiêu đề Excel" Height="470" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Chọn hàng tiêu đề" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource AppMutedBrush}"
                       Text="Chọn dòng chứa tên cột (ví dụ: Mã hàng, Số lượng). Dữ liệu sẽ bắt đầu ở dòng kế tiếp."/>
        </StackPanel>

        <DataGrid x:Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                <DataGridTextColumn Header="Content" Binding="{Binding PreviewText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Width="82" Margin="0,0,8,0" Padding="8,5" Click="Cancel_Click"/>
            <Button Content="Dùng dòng này" Width="120" Padding="8,5" Click="UseRow_Click" Background="{DynamicResource AppPrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
