<Window x:Class="ANLAbel.App.ExcelHeaderRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Header Row" Height="440" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Click the row that contains the column names (e.g. PartNo, Qty). Rows above it are ignored; data import starts on the row right after it."/>

        <DataGrid x:Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                <DataGridTextColumn Header="Content" Binding="{Binding PreviewText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="82" Margin="0,0,8,0" Padding="8,5" Click="Cancel_Click"/>
            <Button Content="Use This Row" Width="120" Padding="8,5" Click="UseRow_Click"/>
        </StackPanel>
    </Grid>
</Window>
