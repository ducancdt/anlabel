<Window x:Class="ANLAbel.App.DataSourceCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean Up Orphaned Data Sources"
        Height="440" Width="560"
        MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource AppCanvasBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E2EC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppPrimaryBrush}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Dọn nguồn dữ liệu không còn dùng" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="#DBEAFE" Margin="0,4,0,0"
                           Text="Các nguồn này trỏ tới tệp Excel không còn tồn tại và không được dùng trong 30 ngày qua. Chọn những nguồn cần xoá."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Remove Selected" Padding="8,4" Click="RemoveSelected_Click" Margin="0,0,8,0" Foreground="#B91C1C"/>
                <Button Content="Close" Width="96" Height="30" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="OrphanListBox" Margin="14" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="22,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
