<Window x:Class="ANLAbel.App.PrintCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ANLAbel.App.Converters"
        Title="ANLAbel - Trung tâm in"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        PreviewKeyDown="PrintCenterWindow_PreviewKeyDown"
        Loaded="PrintCenterWindow_Loaded">
    <Window.Resources>
        <converters:PrintCenterTextConverter x:Key="PrintCenterText"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Right"
                    Content="Làm mới"
                    Padding="16,7"
                    AutomationProperties.Name="Refresh print recovery"
                    Click="RefreshButton_Click"/>
            <StackPanel>
                <TextBlock Text="Trung tâm in / Phục hồi"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Bằng chứng hàng đợi và quyết định in lại được ghi lại; không hành động nào tự thử lại."
                           Margin="0,4,0,0"
                           Foreground="#475569"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Quét hoặc tìm lệnh:" VerticalAlignment="Center" Foreground="#334155"/>
                    <TextBox x:Name="FilterTextBox"
                             Width="300"
                             Margin="8,0,0,0"
                             Padding="7,4"
                             ToolTip="Quét mã lệnh, hoặc tìm máy in, bộ đệm in, hàng đợi, hoặc bản kê"
                             AutomationProperties.Name="Scan or search print job"
                             TextChanged="FilterTextBox_TextChanged"/>
                    <TextBlock x:Name="FilterSummaryText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               Text="0 lệnh"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="JobsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="JobsGrid_SelectionChanged"
                  HeadersVisibility="Column"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lệnh" Binding="{Binding JobId}" Width="210"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding State, Converter={StaticResource PrintCenterText}}" Width="115"/>
                <DataGridTextColumn Header="Hành động" Binding="{Binding OperatorAction, Converter={StaticResource PrintCenterText}}" Width="135"/>
                <DataGridTextColumn Header="Máy in" Binding="{Binding PrinterName}" Width="150"/>
                <DataGridTextColumn Header="Bộ đệm in" Binding="{Binding SpoolJobId}" Width="70"/>
                <DataGridTextColumn Header="Hàng đợi" Binding="{Binding QueueState, Converter={StaticResource PrintCenterText}, ConverterParameter=Queue}" Width="105"/>
                <DataGridTextColumn Header="Bản kê" Binding="{Binding ManifestFingerprint}" Width="220"/>
                <DataGridTextColumn Header="Lý do" Binding="{Binding Reason, Converter={StaticResource PrintCenterText}, ConverterParameter=Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailsText"
                           Text="Chọn một lệnh để xem bằng chứng bền của nó."
                           TextWrapping="Wrap"
                           Foreground="#334155"
                           MaxHeight="64"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ReconcileButton" Content="Đối soát hàng đợi" Padding="13,6" Margin="0,0,8,0" AutomationProperties.Name="Reconcile selected queue" Click="ReconcileButton_Click"/>
                    <Button x:Name="AcknowledgeButton" Content="Ghi nhận" Padding="13,6" Margin="0,0,8,0" AutomationProperties.Name="Acknowledge selected job" Click="AcknowledgeButton_Click"/>
                    <Button x:Name="VoidButton" Content="Hủy bỏ" Padding="13,6" Margin="0,0,8,0" AutomationProperties.Name="Void selected job" Click="VoidButton_Click"/>
                    <Button x:Name="RequestReprintButton" Content="Yêu cầu in lại" Padding="13,6" Margin="0,0,8,0" AutomationProperties.Name="Request linked reprint" Click="RequestReprintButton_Click"/>
                    <Button x:Name="ApproveButton" Content="Duyệt in lại" Padding="13,6" Margin="0,0,8,0" AutomationProperties.Name="Approve linked reprint" Click="ApproveButton_Click"/>
                    <Button x:Name="PreviewButton" Content="Mở xem trước đã duyệt" Padding="13,6" Margin="0,0,8,0" AutomationProperties.Name="Open approved preview" Click="PreviewButton_Click"/>
                    <Button x:Name="RepairLogButton" Content="Lưu trữ nhật ký hỏng và bắt đầu nhật ký mới" Padding="13,6" Margin="0,0,8,0" Visibility="Collapsed" AutomationProperties.Name="Archive damaged print log" AutomationProperties.AutomationId="PrintCenter.RepairLog" Click="RepairLogButton_Click"/>
                    <Button x:Name="ExportSupportButton" Content="Xuất bằng chứng hỗ trợ" Padding="13,6" AutomationProperties.Name="Export redacted support evidence" Click="ExportSupportButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
