<Window x:Class="ANLAbel.App.OperationsOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel - Local Operations"
        Width="1040"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Loaded="OperationsOverviewWindow_Loaded"
        PreviewKeyDown="OperationsOverviewWindow_PreviewKeyDown"
        AutomationProperties.AutomationId="CC.P1.Overview.Root"
        AutomationProperties.Name="Local operations overview">
    <Window.Resources>
        <Style x:Key="OverviewCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="OverviewSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AppInkBrush}"/>
        </Style>
        <Style x:Key="OverviewMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    MinWidth="100"
                    Content="{Binding RefreshButtonText}"
                    IsEnabled="{Binding CanRefresh}"
                    Click="RefreshButton_Click"
                    AutomationProperties.AutomationId="CC.P1.Overview.Refresh"
                    AutomationProperties.Name="Refresh local operations evidence"/>
            <StackPanel>
                <TextBlock Text="Local Operations" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="One read-only view of queue health and durable print recovery. No action retries automatically."
                           Margin="0,4,0,0" Style="{StaticResource OverviewMuted}"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                            AutomationProperties.AutomationId="CC.P1.Overview.Status">
                    <TextBlock Text="{Binding SourceStatusText}" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text="  •  " Foreground="{StaticResource AppMutedBrush}"/>
                    <TextBlock Text="{Binding RefreshedAtText}" Style="{StaticResource OverviewMuted}"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource OverviewCard}"
                            AutomationProperties.AutomationId="CC.P1.Overview.Queue">
                        <StackPanel>
                            <TextBlock Text="Printer queue" Style="{StaticResource OverviewSectionTitle}"/>
                            <TextBlock Text="{Binding QueueStateText}" Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#173B72"/>
                            <TextBlock Text="{Binding QueueName}" Margin="0,5,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding QueueDetailText}" Margin="0,7,0,0" Style="{StaticResource OverviewMuted}"/>
                            <TextBlock Text="{Binding QueueObservedText}" Margin="0,9,0,0" FontSize="11" Style="{StaticResource OverviewMuted}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource OverviewCard}"
                            AutomationProperties.AutomationId="CC.P1.Overview.Recovery">
                        <StackPanel>
                            <TextBlock Text="Print recovery" Style="{StaticResource OverviewSectionTitle}"/>
                            <TextBlock Text="{Binding RecoveryStateText}" Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#9A3412"/>
                            <TextBlock Text="{Binding RecoveryDetailText}" Margin="0,7,0,0" Style="{StaticResource OverviewMuted}"/>
                            <TextBlock Text="Operator review is explicit; recovery never implies physical output or permission to reprint."
                                       Margin="0,9,0,0" FontSize="11" Style="{StaticResource OverviewMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,14,0,0" Style="{StaticResource OverviewCard}">
                    <StackPanel>
                        <TextBlock Text="Jobs requiring review" Style="{StaticResource OverviewSectionTitle}"/>
                        <DataGrid ItemsSource="{Binding Candidates}"
                                  Margin="0,10,0,0"
                                  MaxHeight="230"
                                  MinHeight="105"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  AutomationProperties.AutomationId="CC.P1.Overview.Jobs"
                                  AutomationProperties.Name="Print jobs requiring review">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding JobId}" Width="190"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding OperatorAction}" Width="135"/>
                                <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="150"/>
                                <DataGridTextColumn Header="Queue" Binding="{Binding QueueState}" Width="105"/>
                                <DataGridTextColumn Header="Last event" Binding="{Binding LastEventUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource OverviewCard}"
                        AutomationProperties.AutomationId="CC.P1.Overview.Diagnostics">
                    <StackPanel>
                        <TextBlock Text="Diagnostics" Style="{StaticResource OverviewSectionTitle}"/>
                        <TextBlock Text="{Binding DiagnosticsText}" Margin="0,9,0,0" Style="{StaticResource OverviewMuted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" MinWidth="84" Click="CloseButton_Click"
                    AutomationProperties.AutomationId="CC.P1.Overview.Close" AutomationProperties.Name="Close local operations overview"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Printer Setup" Margin="0,0,8,0" Click="OpenPrinterSetup_Click"
                        AutomationProperties.AutomationId="CC.P1.Overview.OpenPrinterSetup" AutomationProperties.Name="Open printer setup"/>
                <Button Content="Print Center" Margin="0,0,8,0" Click="OpenPrintCenter_Click"
                        AutomationProperties.AutomationId="CC.P1.Overview.OpenPrintCenter" AutomationProperties.Name="Open print center"/>
                <Button Content="Print History" Click="OpenPrintHistory_Click"
                        AutomationProperties.AutomationId="CC.P1.Overview.OpenHistory" AutomationProperties.Name="Open print history"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
