<Window x:Class="ANLAbel.App.PrinterSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Label Size and Printer Setup" Height="480" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppCanvasBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Kích thước tem và máy in" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Chọn khổ tem chuẩn hoặc nhập kích thước riêng, rồi chọn máy in phù hợp." Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,0,10,0" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppPrimaryBrush}" Padding="12,10" CornerRadius="8,8,0,0">
                        <TextBlock Text="Standard Label Sizes" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
                        <TextBlock Text="Category" FontSize="11"/>
                        <ComboBox x:Name="CategoryBox" SelectionChanged="CategoryBox_SelectionChanged" Margin="0,2,0,6"/>
                    </StackPanel>
                    <ListBox x:Name="PaperSizesList"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="PaperSizesList_SelectionChanged"
                             BorderThickness="0"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppPrimaryBrush}" Padding="12,10" CornerRadius="8,8,0,0">
                        <TextBlock Text="Size and Printer Settings" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Always-visible print essentials: they must not disappear below the paper-size list at high DPI. -->
                    <Grid DockPanel.Dock="Top" Margin="10,8,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DPI" FontSize="11"/>
                            <ComboBox x:Name="DpiBox" SelectedIndex="0" Margin="0,3,0,0">
                                <ComboBoxItem Content="203"/>
                                <ComboBoxItem Content="300"/>
                                <ComboBoxItem Content="305"/>
                                <ComboBoxItem Content="600"/>
                                <ComboBoxItem Content="609"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Printer" FontSize="11"/>
                            <ComboBox x:Name="PrinterBox" DisplayMemberPath="DisplayName" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <!-- Keep all printer settings reachable when the installed printer list is long. -->
                    <ScrollViewer Margin="10,8,10,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Label Width (mm)"/>
                        <TextBox x:Name="WidthBox" Text="100" Margin="0,4,0,10"/>
                        <TextBlock Text="Label Height (mm)"/>
                        <TextBox x:Name="HeightBox" Text="50" Margin="0,4,0,10"/>
                        <TextBlock x:Name="SizeSummaryText" Text="100 × 50 mm" Foreground="#0F4C81" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Orientation"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <RadioButton x:Name="PortraitRadio" Content="Portrait" IsChecked="True" Margin="0,0,16,0"/>
                            <RadioButton x:Name="LandscapeRadio" Content="Landscape"/>
                        </StackPanel>
                        <TextBlock x:Name="DriverText" TextWrapping="Wrap" Foreground="#526070" FontSize="11"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Bỏ qua" Width="86" Margin="0,0,8,0" Padding="8,5" Click="Skip_Click" IsCancel="True"/>
            <Button Content="Áp dụng" Width="120" Padding="8,5" Click="Apply_Click" Background="{DynamicResource AppPrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
