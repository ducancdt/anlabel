<Window x:Class="ANLAbel.App.PrinterSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thuộc tính tem" Height="650" Width="900" MinHeight="600" MinWidth="820" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed" Background="{DynamicResource AppCanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Thuộc tính tem" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Chọn hàng đợi Windows, kích thước tem thiết kế, và giấy/vật liệu của trình điều khiển. Không dùng danh mục khổ có sẵn của phần mềm." Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl Grid.Row="1" x:Name="SetupTabs" TabStripPlacement="Left" AutomationProperties.AutomationId="PrinterSetup.WorkflowTabs" Background="{DynamicResource AppSurfaceBrush}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="MinWidth" Value="160"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Máy in" AutomationProperties.AutomationId="PrinterSetup.PrinterTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="Máy in" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Chọn đúng hàng đợi máy in Windows. Đổi hàng đợi chỉ nạp lại năng lực trình điều khiển; không đổi kích thước tem cho tới khi Áp dụng." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,14"/>
                    <TextBlock Text="Hàng đợi máy in" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PrinterBox" AutomationProperties.AutomationId="PrinterSetup.Queue" DisplayMemberPath="DisplayName" Margin="0,4,0,14" MinWidth="420" SelectionChanged="PrinterBox_SelectionChanged"/>
                    <TextBlock Text="Dùng thuộc tính máy in lưu trong" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                        <RadioButton x:Name="LabelSettingsRadio" GroupName="SettingsSourceGroup" AutomationProperties.AutomationId="PrinterSetup.SettingsSourceLabel" Content="Tem" Margin="0,0,24,0" Checked="SettingsSource_Changed"/>
                        <RadioButton x:Name="DriverSettingsRadio" GroupName="SettingsSourceGroup" AutomationProperties.AutomationId="PrinterSetup.SettingsSourceDriver" Content="Trình điều khiển" Checked="SettingsSource_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="DPI" FontWeight="SemiBold"/><ComboBox x:Name="DpiBox" AutomationProperties.AutomationId="PrinterSetup.Dpi" Margin="0,4,12,0"/></StackPanel>
                        <Button Grid.Column="1" x:Name="DriverPreferencesButton" AutomationProperties.AutomationId="PrinterSetup.DriverPreferences" Content="Thuộc tính máy in" Padding="12,7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="DriverPreferences_Click"/>
                    </Grid>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" CornerRadius="5"><StackPanel>
                        <TextBlock x:Name="DriverText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CapabilityStatusText" AutomationProperties.AutomationId="PrinterSetup.CapabilityStatus" Text="Chọn một máy in để nạp năng lực trình điều khiển." TextWrapping="Wrap" Foreground="#526070" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Kích thước tem" AutomationProperties.AutomationId="PrinterSetup.LabelDimensionsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Kích thước tem thiết kế" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Các kích thước này thuộc tài liệu tem. Chỉ Áp dụng mới ghi nhận. Chọn máy in khác không bao giờ thay đổi chúng." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,16"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Rộng (mm)" FontWeight="SemiBold"/><TextBox x:Name="WidthBox" AutomationProperties.AutomationId="PrinterSetup.Width" Text="100" Margin="0,4,0,0" TextChanged="LabelDimensions_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Cao (mm)" FontWeight="SemiBold"/><TextBox x:Name="HeightBox" AutomationProperties.AutomationId="PrinterSetup.Height" Text="50" Margin="0,4,0,0" TextChanged="LabelDimensions_Changed"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="SizeSummaryText" AutomationProperties.AutomationId="PrinterSetup.SizeSummary" Text="100 × 50 mm" Foreground="#0F4C81" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,14"/>
                    <TextBlock Text="Hướng" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><RadioButton x:Name="PortraitRadio" AutomationProperties.AutomationId="PrinterSetup.OrientationPortrait" GroupName="LabelOrientationGroup" Content="Dọc" IsChecked="True" Margin="0,0,24,0" Checked="Orientation_Changed"/><RadioButton x:Name="LandscapeRadio" AutomationProperties.AutomationId="PrinterSetup.OrientationLandscape" GroupName="LabelOrientationGroup" Content="Ngang" Checked="Orientation_Changed"/></StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Giấy / Vật liệu" AutomationProperties.AutomationId="PrinterSetup.PaperMediaTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="Giấy / Vật liệu" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Tự động: trình điều khiển sở hữu khổ trang (tem trên cuộn). Thủ công: chọn vật liệu trình điều khiển đã công bố, hoặc nhập milimét trên tab Kích thước tem. Không có danh mục khổ có sẵn của phần mềm." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,14"/>
                    <TextBlock Text="Nguồn trang / vật liệu" FontWeight="SemiBold"/>
                    <StackPanel Margin="0,6,0,14">
                        <RadioButton x:Name="DriverAutomaticRadio" GroupName="PageSourceGroup" AutomationProperties.AutomationId="PrinterSetup.PageSourceDriverAutomatic" Content="Tự động đặt khổ trang theo kích thước tem (tem trên cuộn)" Margin="0,0,0,8" Checked="PageSource_Changed"/>
                        <RadioButton x:Name="ManualMediaRadio" GroupName="PageSourceGroup" AutomationProperties.AutomationId="PrinterSetup.PageSourceManual" Content="Đặt khổ trang thủ công (tờ giấy)" IsChecked="True" Checked="PageSource_Changed"/>
                    </StackPanel>
                    <TextBlock Text="Vật liệu do trình điều khiển đã chọn công bố" FontWeight="SemiBold"/>
                    <ComboBox x:Name="DriverMediaBox" AutomationProperties.AutomationId="PrinterSetup.DriverMedia" DisplayMemberPath="DisplayName" Margin="0,4,0,12" MinWidth="500" SelectionChanged="MediaSelection_Changed"/>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Padding="10" CornerRadius="5"><TextBlock Text="Áp dụng kiểm tra vật liệu vật lý so với tem thiết kế. Khi lệch sẽ bị chặn thay vì âm thầm đổi khổ giấy khác." TextWrapping="Wrap" Foreground="#1E3A5F"/></Border>
                    <Border x:Name="CompatibilityCard" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,10,0,0">
                        <StackPanel><TextBlock Text="Tương thích" FontWeight="SemiBold"/><TextBlock x:Name="MediaCompatibilityText" AutomationProperties.AutomationId="PrinterSetup.CompatibilityStatus" Text="Chọn một máy in để kiểm tra tương thích vật liệu." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="Căn chỉnh khổ in" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock Text="Lệch và tỉ lệ là hiệu chỉnh in vật lý sau khi đo tem. Không dùng chúng để đổi kích thước tem thiết kế. Tem trên cuộn: chọn Tự động ở trên để trình điều khiển đặt khổ theo tem." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Lệch X (mm)" FontWeight="SemiBold"/>
                            <TextBox x:Name="OffsetXBox" AutomationProperties.AutomationId="PrinterSetup.OffsetX" Text="0" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lệch Y (mm)" FontWeight="SemiBold"/>
                            <TextBox x:Name="OffsetYBox" AutomationProperties.AutomationId="PrinterSetup.OffsetY" Text="0" Margin="0,4,0,10"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tỉ lệ X" FontWeight="SemiBold"/>
                            <TextBox x:Name="ScaleXBox" AutomationProperties.AutomationId="PrinterSetup.ScaleX" Text="1" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tỉ lệ Y" FontWeight="SemiBold"/>
                            <TextBox x:Name="ScaleYBox" AutomationProperties.AutomationId="PrinterSetup.ScaleY" Text="1" Margin="0,4,0,10"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="In hiệu chỉnh" AutomationProperties.AutomationId="PrinterSetup.PrintCalibration" Padding="8,5" Click="PrintCalibration_Click"/>
                        <Button Content="Đặt lại lệch/tỉ lệ" AutomationProperties.AutomationId="PrinterSetup.ResetCalibration" Padding="8,5" Margin="8,0,0,0" Click="ResetCalibration_Click"/>
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Chưa ghi nhận gì cho tới khi Áp dụng." Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" AutomationProperties.AutomationId="PrinterSetup.Cancel" Width="92" Margin="0,0,8,0" Padding="8,6" Click="Skip_Click" IsCancel="True"/><Button x:Name="ApplyButton" AutomationProperties.AutomationId="PrinterSetup.Apply" Content="Áp dụng" Width="120" Padding="8,6" Click="Apply_Click" Background="{DynamicResource AppPrimaryBrush}" Foreground="White"/></StackPanel>
        </Grid>
    </Grid>
</Window>
