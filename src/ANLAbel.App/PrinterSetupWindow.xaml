<Window x:Class="ANLAbel.App.PrinterSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thuộc tính tem" Height="650" Width="900" MinHeight="600" MinWidth="820" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed" Background="{DynamicResource AppCanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Thuộc tính tem" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Chọn hàng đợi Windows, kích thước tem thiết kế, và giấy/vật liệu của trình điều khiển. Không dùng danh mục khổ có sẵn của phần mềm." Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl Grid.Row="1" x:Name="SetupTabs" TabStripPlacement="Left" AutomationProperties.AutomationId="PrinterSetup.WorkflowTabs" Background="{DynamicResource AppSurfaceBrush}" SelectionChanged="SetupTabs_SelectionChanged">
            <TabControl.Resources>
                <!-- Workflow steps on the left (NiceLabel 10 Label Properties): flat, with an accent bar on the active step -->
                <Style TargetType="TabItem">
                    <Setter Property="MinWidth" Value="160"/>
                    <Setter Property="Padding" Value="12,9"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#334155"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="StepRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="StepRoot" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="StepRoot" Property="Background" Value="#EAF3FF"/>
                                        <Setter TargetName="StepRoot" Property="BorderBrush" Value="#1464D2"/>
                                        <Setter Property="Foreground" Value="#0B4A8B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Máy in" AutomationProperties.AutomationId="PrinterSetup.PrinterTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="Máy in" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Chọn đúng hàng đợi máy in Windows. Đổi hàng đợi chỉ nạp lại năng lực trình điều khiển; không đổi kích thước tem cho tới khi Áp dụng." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,14"/>
                    <TextBlock Text="Hàng đợi máy in" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PrinterBox" AutomationProperties.AutomationId="PrinterSetup.Queue" DisplayMemberPath="DisplayName" Margin="0,4,0,14" MinWidth="420" SelectionChanged="PrinterBox_SelectionChanged"/>
                    <TextBlock Text="Dùng thuộc tính máy in lưu trong" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                        <RadioButton x:Name="LabelSettingsRadio" GroupName="SettingsSourceGroup" AutomationProperties.AutomationId="PrinterSetup.SettingsSourceLabel" Content="Tem" Margin="0,0,24,0" Checked="SettingsSource_Changed"/>
                        <RadioButton x:Name="DriverSettingsRadio" GroupName="SettingsSourceGroup" AutomationProperties.AutomationId="PrinterSetup.SettingsSourceDriver" Content="Trình điều khiển" Checked="SettingsSource_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="DPI" FontWeight="SemiBold"/><ComboBox x:Name="DpiBox" AutomationProperties.AutomationId="PrinterSetup.Dpi" Margin="0,4,12,0"/></StackPanel>
                        <Button Grid.Column="1" x:Name="DriverPreferencesButton" AutomationProperties.AutomationId="PrinterSetup.DriverPreferences" Content="Thuộc tính máy in" Padding="12,7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="DriverPreferences_Click"/>
                    </Grid>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" CornerRadius="5"><StackPanel>
                        <TextBlock x:Name="DriverText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CapabilityStatusText" AutomationProperties.AutomationId="PrinterSetup.CapabilityStatus" Text="Chọn một máy in để nạp năng lực trình điều khiển." TextWrapping="Wrap" Foreground="#526070" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Kích thước tem" AutomationProperties.AutomationId="PrinterSetup.LabelDimensionsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Kích thước tem thiết kế" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Các kích thước này thuộc tài liệu tem. Chỉ Áp dụng mới ghi nhận. Chọn máy in khác không bao giờ thay đổi chúng." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,16"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Rộng (mm)" FontWeight="SemiBold"/><TextBox x:Name="WidthBox" AutomationProperties.AutomationId="PrinterSetup.Width" Text="100" Margin="0,4,0,0" TextChanged="LabelDimensions_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Cao (mm)" FontWeight="SemiBold"/><TextBox x:Name="HeightBox" AutomationProperties.AutomationId="PrinterSetup.Height" Text="50" Margin="0,4,0,0" TextChanged="LabelDimensions_Changed"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="SizeSummaryText" AutomationProperties.AutomationId="PrinterSetup.SizeSummary" Text="100 × 50 mm" Foreground="#0F4C81" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,14"/>
                    <TextBlock Text="Hướng" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><RadioButton x:Name="PortraitRadio" AutomationProperties.AutomationId="PrinterSetup.OrientationPortrait" GroupName="LabelOrientationGroup" Content="Dọc" IsChecked="True" Margin="0,0,24,0" Checked="Orientation_Changed"/><RadioButton x:Name="LandscapeRadio" AutomationProperties.AutomationId="PrinterSetup.OrientationLandscape" GroupName="LabelOrientationGroup" Content="Ngang" Checked="Orientation_Changed"/></StackPanel>

                    <!-- NiceLabel 10 Label Dimensions › Margins: left/top place the first label on the page;
                         right/bottom are what the paper leaves after the labels. -->
                    <TextBlock Text="Lề" FontWeight="SemiBold" Margin="0,18,0,2"/>
                    <TextBlock Text="Lề trái và trên đặt tem đầu tiên trên trang (với tem cuộn đây là độ lệch khi in). Lề phải và dưới tự tính từ khổ giấy." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Trái (mm)"/><TextBox x:Name="OffsetXBox" AutomationProperties.AutomationId="PrinterSetup.OffsetX" Text="0" Margin="0,4,0,10" TextChanged="Layout_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Trên (mm)"/><TextBox x:Name="OffsetYBox" AutomationProperties.AutomationId="PrinterSetup.OffsetY" Text="0" Margin="0,4,0,10" TextChanged="Layout_Changed"/></StackPanel>
                        <StackPanel Grid.Row="1"><TextBlock Text="Phải (mm)"/><TextBox x:Name="RightMarginBox" AutomationProperties.AutomationId="PrinterSetup.RightMargin" IsReadOnly="True" Background="#F1F5F9" Text="—" Margin="0,4,0,10"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Dưới (mm)"/><TextBox x:Name="BottomMarginBox" AutomationProperties.AutomationId="PrinterSetup.BottomMargin" IsReadOnly="True" Background="#F1F5F9" Text="—" Margin="0,4,0,10"/></StackPanel>
                    </Grid>

                    <!-- NiceLabel 10 Label Dimensions › Labels Across (sheets of paper). -->
                    <TextBlock Text="Số tem trên trang" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock x:Name="LabelsAcrossHint" Text="Đặt nhiều tem trên một tờ giấy; mỗi dòng dữ liệu in vào một ô." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,6"/>
                    <Grid x:Name="LabelsAcrossGroup">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Số tem ngang"/><TextBox x:Name="LabelsAcrossBox" AutomationProperties.AutomationId="PrinterSetup.LabelsAcross" Text="1" Margin="0,4,0,10" TextChanged="Layout_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Khoảng cách ngang (mm)"/><TextBox x:Name="HorizontalGapBox" AutomationProperties.AutomationId="PrinterSetup.HorizontalGap" Text="0" Margin="0,4,0,10" TextChanged="Layout_Changed"/></StackPanel>
                        <StackPanel Grid.Row="1"><TextBlock Text="Số tem dọc"/><TextBox x:Name="LabelsDownBox" AutomationProperties.AutomationId="PrinterSetup.LabelsDown" Text="1" Margin="0,4,0,10" TextChanged="Layout_Changed"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Khoảng cách dọc (mm)"/><TextBox x:Name="VerticalGapBox" AutomationProperties.AutomationId="PrinterSetup.VerticalGap" Text="0" Margin="0,4,0,10" TextChanged="Layout_Changed"/></StackPanel>
                        <StackPanel Grid.Row="2"><TextBlock Text="Thứ tự in"/><ComboBox x:Name="ProcessingOrderBox" AutomationProperties.AutomationId="PrinterSetup.ProcessingOrder" DisplayMemberPath="Name" Margin="0,4,0,0" SelectionChanged="ProcessingOrder_Changed"/></StackPanel>
                        <Button Grid.Row="2" Grid.Column="2" x:Name="AutoLabelsAcrossButton" AutomationProperties.AutomationId="PrinterSetup.AutoLabelsAcross" Content="Tính số tem vừa tờ" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="AutoLabelsAcross_Click"
                                ToolTip="Đặt số tem ngang và dọc nhiều nhất vừa khổ giấy từ lề trái/trên (Automatic labels across của NiceLabel)"/>
                    </Grid>
                    <TextBlock x:Name="SheetSummaryText" AutomationProperties.AutomationId="PrinterSetup.SheetSummary" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Giấy" AutomationProperties.AutomationId="PrinterSetup.PaperMediaTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="Giấy" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Chọn tem trên cuộn hoặc tờ giấy của máy in. Khổ giấy lấy từ trình điều khiển máy in; phần mềm không có danh mục khổ riêng." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,14"/>
                    <TextBlock Text="Loại giấy" FontWeight="SemiBold"/>
                    <StackPanel Margin="0,6,0,14">
                        <RadioButton x:Name="DriverAutomaticRadio" GroupName="PageSourceGroup" AutomationProperties.AutomationId="PrinterSetup.PageSourceDriverAutomatic" Content="Tự động đặt khổ trang theo kích thước tem (tem trên cuộn)" Margin="0,0,0,8" Checked="PageSource_Changed"/>
                        <RadioButton x:Name="ManualMediaRadio" GroupName="PageSourceGroup" AutomationProperties.AutomationId="PrinterSetup.PageSourceManual" Content="Đặt khổ trang thủ công (tờ giấy)" IsChecked="True" Checked="PageSource_Changed"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Giấy" FontWeight="SemiBold"/>
                            <ComboBox x:Name="DriverMediaBox" AutomationProperties.AutomationId="PrinterSetup.DriverMedia" DisplayMemberPath="DisplayName" Margin="0,4,0,6" MinWidth="300" SelectionChanged="MediaSelection_Changed"/>
                            <TextBlock x:Name="PaperSizeText" AutomationProperties.AutomationId="PrinterSetup.PaperSize" Foreground="#0F4C81" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Hướng in" FontWeight="SemiBold"/>
                            <CheckBox x:Name="Rotated180Box" AutomationProperties.AutomationId="PrinterSetup.Rotated180" Content="Xoay 180° (in ngược đầu)" Margin="0,6,0,12" Checked="Layout_Toggled" Unchecked="Layout_Toggled"/>
                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Padding="10" CornerRadius="5"><TextBlock Text="Áp dụng kiểm tra giấy vật lý so với tem thiết kế. Khi lệch sẽ bị chặn thay vì âm thầm đổi khổ giấy khác." TextWrapping="Wrap" Foreground="#1E3A5F"/></Border>
                        </StackPanel>
                        <!-- NiceLabel 10 Paper › Preview: the page and where each label lands on it. -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Xem trước" FontWeight="SemiBold"/>
                            <Border Background="#E2E8F0" CornerRadius="4" Margin="0,4,0,0" Padding="8" Height="236">
                                <Canvas x:Name="LayoutPreview" AutomationProperties.AutomationId="PrinterSetup.LayoutPreview" Width="184" Height="220" ClipToBounds="True"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="CompatibilityCard" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,10,0,0">
                        <StackPanel><TextBlock Text="Tương thích" FontWeight="SemiBold"/><TextBlock x:Name="MediaCompatibilityText" AutomationProperties.AutomationId="PrinterSetup.CompatibilityStatus" Text="Chọn một máy in để kiểm tra tương thích giấy." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="Căn chỉnh khổ in" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock Text="Tỉ lệ là hiệu chỉnh in vật lý sau khi đo tem; lề trái/trên ở trang Kích thước tem dời tem trên trang. Không dùng chúng để đổi kích thước tem thiết kế." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tỉ lệ X" FontWeight="SemiBold"/>
                            <TextBox x:Name="ScaleXBox" AutomationProperties.AutomationId="PrinterSetup.ScaleX" Text="1" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tỉ lệ Y" FontWeight="SemiBold"/>
                            <TextBox x:Name="ScaleYBox" AutomationProperties.AutomationId="PrinterSetup.ScaleY" Text="1" Margin="0,4,0,10"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="In hiệu chỉnh" AutomationProperties.AutomationId="PrinterSetup.PrintCalibration" Padding="8,5" Click="PrintCalibration_Click"/>
                        <Button Content="Đặt lại lề và tỉ lệ" AutomationProperties.AutomationId="PrinterSetup.ResetCalibration" Padding="8,5" Margin="8,0,0,0" Click="ResetCalibration_Click"/>
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" Text="Chưa ghi nhận gì cho tới khi Áp dụng." Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" AutomationProperties.AutomationId="PrinterSetup.Cancel" Width="92" Margin="0,0,8,0" Padding="8,6" Click="Skip_Click" IsCancel="True"/><Button x:Name="BackButton" AutomationProperties.AutomationId="PrinterSetup.Back" Content="‹ Quay lại" Width="100" Margin="0,0,8,0" Padding="8,6" Click="Back_Click" Visibility="Collapsed"/><Button x:Name="NextButton" AutomationProperties.AutomationId="PrinterSetup.Next" Content="Tiếp ›" Width="100" Margin="0,0,8,0" Padding="8,6" Click="Next_Click" Visibility="Collapsed"/><Button x:Name="ApplyButton" AutomationProperties.AutomationId="PrinterSetup.Apply" Content="Áp dụng" Width="120" Padding="8,6" Click="Apply_Click" Background="{DynamicResource AppPrimaryBrush}" Foreground="White"/></StackPanel>
        </Grid>
    </Grid>
</Window>
