<Window x:Class="ANLAbel.App.PromptOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ANLAbel.App.Controls"
        Title="Thứ tự nhắc" Width="580" Height="420" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F1F1F1">
    <!-- NiceLabel 10 Variable Prompt Order (datasources/view/variablepromptorderdialogview.xaml):
         the variables in the order they are asked when printing, Move Up / Move Down, OK / Cancel. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ANLAbel.App;component/Themes/Ribbon.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Các câu hỏi hiện ra theo thứ tự này khi in. Chọn một biến rồi đưa lên hoặc xuống."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Đồng ý" MinWidth="90" IsDefault="True" Click="Ok_Click" AutomationProperties.AutomationId="PromptOrder.Ok"/>
            <Button Content="Hủy" MinWidth="90" Margin="8,0,0,0" IsCancel="True" AutomationProperties.AutomationId="PromptOrder.Cancel"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="96">
            <Button x:Name="MoveUpButton" Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.ArrowUp16}" Content="Lên"
                    Click="MoveUp_Click" ToolTip="Hỏi biến này sớm hơn" AutomationProperties.AutomationId="PromptOrder.MoveUp"/>
            <Button x:Name="MoveDownButton" Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.ArrowDown16}" Content="Xuống"
                    Click="MoveDown_Click" ToolTip="Hỏi biến này muộn hơn" AutomationProperties.AutomationId="PromptOrder.MoveDown"/>
        </StackPanel>
        <ListView x:Name="PromptList" SelectionMode="Single" SelectionChanged="PromptList_SelectionChanged"
                  AutomationProperties.Name="Biến nhập khi in" AutomationProperties.AutomationId="PromptOrder.List">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tên biến" Width="170" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Câu nhắc" Width="250" DisplayMemberBinding="{Binding Prompt}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
