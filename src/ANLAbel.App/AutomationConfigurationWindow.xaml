<Window x:Class="ANLAbel.App.AutomationConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Local Automation Configuration" Width="620" Height="570" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="CC.P8.Automation.ConfigurationDialog"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Local file-drop configuration" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Saving settings does not start a watcher, consume a source, select a queue or print." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#64748B"/></StackPanel><ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Trigger ID"/><TextBox Text="{Binding TriggerId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.TriggerId"/><TextBlock Text="Name" Margin="0,8,0,0"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.TriggerName"/><TextBlock Text="Watch root" Margin="0,8,0,0"/><TextBox Text="{Binding WatchRoot,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.WatchRoot"/><TextBlock Text="File pattern" Margin="0,8,0,0"/><TextBox Text="{Binding Pattern,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.Pattern"/><TextBlock Text="Future target template (does not dispatch)" Margin="0,8,0,0"/><TextBox Text="{Binding TargetTemplatePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.TargetTemplate"/><TextBlock Text="Future explicit queue (does not dispatch)" Margin="0,8,0,0"/><TextBox Text="{Binding QueueName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.QueueName"/><TextBlock Text="Future publication policy" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding PrintPolicyModes}" SelectedItem="{Binding PrintPolicyMode}" AutomationProperties.AutomationId="CC.P8.Automation.PrintPolicy"/><CheckBox Content="Include subfolders" IsChecked="{Binding Recursive}" Margin="0,10,0,0"/><CheckBox Content="Enabled when a future runner is installed" IsChecked="{Binding Enabled}" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="CC.P8.Automation.ConfigurationStatus"/></StackPanel></ScrollViewer><DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Close" DockPanel.Dock="Right" Click="Close_Click"/><Button Content="Save local settings" Click="Save_Click" AutomationProperties.AutomationId="CC.P8.Automation.SaveConfiguration"/></DockPanel></Grid></Window>
