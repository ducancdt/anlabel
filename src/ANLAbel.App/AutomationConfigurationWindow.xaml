<Window x:Class="ANLAbel.App.AutomationConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Cấu hình tự động cục bộ" Width="620" Height="570" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="CC.P8.Automation.ConfigurationDialog"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Cấu hình thả tệp cục bộ" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Lưu cài đặt không khởi động bộ theo dõi, không tiêu thụ nguồn, không chọn hàng đợi hay in." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#64748B"/></StackPanel><ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Mã kích hoạt"/><TextBox Text="{Binding TriggerId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.TriggerId"/><TextBlock Text="Tên" Margin="0,8,0,0"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.TriggerName"/><TextBlock Text="Thư mục gốc theo dõi" Margin="0,8,0,0"/><TextBox Text="{Binding WatchRoot,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.WatchRoot"/><TextBlock Text="Mẫu tên tệp" Margin="0,8,0,0"/><TextBox Text="{Binding Pattern,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.Pattern"/><TextBlock Text="Mẫu tem đích tương lai (không điều phối)" Margin="0,8,0,0"/><TextBox Text="{Binding TargetTemplatePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.TargetTemplate"/><TextBlock Text="Hàng đợi tường minh tương lai (không điều phối)" Margin="0,8,0,0"/><TextBox Text="{Binding QueueName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CC.P8.Automation.QueueName"/><TextBlock Text="Chính sách xuất bản tương lai" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding PrintPolicyModes}" SelectedItem="{Binding PrintPolicyMode}" AutomationProperties.AutomationId="CC.P8.Automation.PrintPolicy"/><CheckBox Content="Gồm thư mục con" IsChecked="{Binding Recursive}" Margin="0,10,0,0"/><CheckBox Content="Bật khi cài trình chạy tương lai" IsChecked="{Binding Enabled}" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="CC.P8.Automation.ConfigurationStatus"/></StackPanel></ScrollViewer><DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Đóng" DockPanel.Dock="Right" Click="Close_Click"/><Button Content="Lưu cài đặt cục bộ" Click="Save_Click" AutomationProperties.AutomationId="CC.P8.Automation.SaveConfiguration"/></DockPanel></Grid></Window>
