<Window x:Class="ANLAbel.App.AnalyticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Local Analytics" Width="960" Height="600" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" AutomationProperties.AutomationId="CC.P6.Analytics.Root" AutomationProperties.Name="Local analytics">
<Window.Resources><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="Border" Color="#D9E2EC"/><SolidColorBrush x:Key="Muted" Color="#64748B"/></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="{Binding RefreshButtonText}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" AutomationProperties.AutomationId="CC.P6.Analytics.Refresh" AutomationProperties.Name="Refresh analytics"/><StackPanel><TextBlock Text="Local Analytics" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceHealth}" Margin="0,6,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="CC.P6.Analytics.SourceHealth" AutomationProperties.Name="Analytics source health"/></StackPanel></DockPanel>
<StackPanel Grid.Row="1" Margin="0,18,0,0"><UniformGrid Columns="3"><Border Margin="0,0,10,0" Padding="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="Recorded label rows" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordedLabelRows}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="CSV rows; local timestamp basis" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Margin="0,0,10,0" Padding="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="Recorded jobs" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordedJobs}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Distinct durable JobId values" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Padding="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="Errors / uncertain" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorsOrUncertain}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="State/operation diagnostics" Foreground="{StaticResource Muted}"/></StackPanel></Border></UniformGrid><Border Margin="0,16,0,0" Padding="14" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" AutomationProperties.AutomationId="CC.P6.Analytics.PhysicalDisclaimer" AutomationProperties.Name="Software-counter disclaimer"><TextBlock Text="These are recorded software counters only. CSV rows, queue evidence and ordinary job outcomes do not prove physical labels were printed." TextWrapping="Wrap"/></Border></StackPanel>
<DockPanel Grid.Row="2" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"/><Button Content="Open Print History" Click="History_Click" AutomationProperties.AutomationId="CC.P6.Analytics.OpenHistory" AutomationProperties.Name="Open filtered History"/></DockPanel></Grid></Window>
