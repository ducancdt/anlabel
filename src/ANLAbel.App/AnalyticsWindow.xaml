<Window x:Class="ANLAbel.App.AnalyticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Phân tích cục bộ" Width="960" Height="600" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" AutomationProperties.AutomationId="CC.P6.Analytics.Root" AutomationProperties.Name="Local analytics">
<Window.Resources><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="Border" Color="#D9E2EC"/><SolidColorBrush x:Key="Muted" Color="#64748B"/></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="{Binding RefreshButtonText}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" AutomationProperties.AutomationId="CC.P6.Analytics.Refresh" AutomationProperties.Name="Refresh analytics"/><StackPanel><TextBlock Text="Phân tích cục bộ" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceHealth}" Margin="0,6,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="CC.P6.Analytics.SourceHealth" AutomationProperties.Name="Analytics source health"/></StackPanel></DockPanel>
<StackPanel Grid.Row="1" Margin="0,18,0,0"><UniformGrid Columns="3"><Border Margin="0,0,10,0" Padding="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="Số dòng tem đã ghi" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordedLabelRows}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Dòng CSV; theo mốc thời gian cục bộ" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Margin="0,0,10,0" Padding="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="Số lệnh đã ghi" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordedJobs}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Số giá trị JobId bền khác nhau" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Padding="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="Lỗi / không chắc chắn" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorsOrUncertain}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Chẩn đoán trạng thái/thao tác" Foreground="{StaticResource Muted}"/></StackPanel></Border></UniformGrid><Border Margin="0,16,0,0" Padding="14" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" AutomationProperties.AutomationId="CC.P6.Analytics.PhysicalDisclaimer" AutomationProperties.Name="Software-counter disclaimer"><TextBlock Text="Đây chỉ là bộ đếm phần mềm đã ghi. Dòng CSV, bằng chứng hàng đợi và kết quả lệnh thông thường không chứng minh tem vật lý đã được in." TextWrapping="Wrap"/></Border></StackPanel>
<DockPanel Grid.Row="2" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click"/><Button Content="Mở Lịch sử in" Click="History_Click" AutomationProperties.AutomationId="CC.P6.Analytics.OpenHistory" AutomationProperties.Name="Open filtered History"/></DockPanel></Grid></Window>
