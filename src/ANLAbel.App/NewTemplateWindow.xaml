<Window x:Class="ANLAbel.App.NewTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mẫu tem mới" Height="325" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Tạo mẫu tem mới" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="NameLabel" Text="Tên mẫu tem" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Text="Mẫu ANLAbel" Margin="0,4,0,10" Padding="6,4"/>
            <TextBlock x:Name="WidthLabel" Text="Chiều rộng (mm)" FontWeight="SemiBold"/>
            <TextBox x:Name="WidthBox" Text="100" Margin="0,4,0,10" Padding="6,4"/>
            <TextBlock x:Name="HeightLabel" Text="Chiều cao (mm)" FontWeight="SemiBold"/>
            <TextBox x:Name="HeightBox" Text="50" Margin="0,4,0,10" Padding="6,4"/>
            <TextBlock x:Name="DpiLabel" Text="Độ phân giải (DPI)" FontWeight="SemiBold"/>
            <ComboBox x:Name="DpiBox" SelectedIndex="0" Margin="0,4,0,10" Padding="6,4">
                <ComboBoxItem Content="203"/>
                <ComboBoxItem Content="300"/>
                <ComboBoxItem Content="600"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Hủy" Width="82" Margin="0,0,8,0" Padding="8,5" Click="Cancel_Click"/>
            <Button x:Name="CreateButton" Content="Tạo mẫu" Width="92" Padding="8,5" Click="Create_Click" Background="{DynamicResource AppPrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
