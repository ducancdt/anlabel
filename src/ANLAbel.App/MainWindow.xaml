<Window x:Class="ANLAbel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ANLAbel.App.Controls"
        xmlns:viewModels="clr-namespace:ANLAbel.App.ViewModels"
        xmlns:enums="clr-namespace:ANLAbel.Core.Enums;assembly=ANLAbel.Core"
        xmlns:converters="clr-namespace:ANLAbel.App.Converters"
        xmlns:barcode="clr-namespace:ANLAbel.Core.Barcode;assembly=ANLAbel.Core"
        Title="ANLAbel - Label Designer v0.259"
        Icon="/ANLAbel.App;component/anlabel.ico"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        Background="#EEF2F6"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:EnumEqualsConverter x:Key="EnumEquals"/>
        <controls:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        <CollectionViewSource x:Key="GroupedBarcodeSymbologies" Source="{Binding BarcodeSymbologyOptions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Color x:Key="ColorText">#1E293B</Color>
        <Color x:Key="ColorMuted">#64748B</Color>
        <Color x:Key="ColorLine">#D9E2EC</Color>
        <Color x:Key="ColorPanel">#FFFFFF</Color>
        <Color x:Key="ColorPanelAlt">#F8FAFC</Color>
        <Color x:Key="ColorWorkspace">#EEF2F6</Color>
        <Color x:Key="ColorBlue">#1464D2</Color>
        <Color x:Key="ColorBlueDark">#0F4EA8</Color>
        <Color x:Key="ColorBlueSoft">#EAF3FF</Color>
        <Color x:Key="ColorDanger">#EF4444</Color>

        <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource ColorText}"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource ColorMuted}"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource ColorLine}"/>
        <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource ColorPanel}"/>
        <SolidColorBrush x:Key="AppPanelAltBrush" Color="{StaticResource ColorPanelAlt}"/>
        <SolidColorBrush x:Key="AppWorkspaceBrush" Color="{StaticResource ColorWorkspace}"/>
        <SolidColorBrush x:Key="AppBlueBrush" Color="{StaticResource ColorBlue}"/>
        <SolidColorBrush x:Key="AppBlueDarkBrush" Color="{StaticResource ColorBlueDark}"/>
        <SolidColorBrush x:Key="AppBlueSoftBrush" Color="{StaticResource ColorBlueSoft}"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource ColorDanger}"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#334155"/>
        <DropShadowEffect x:Key="LabelShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#334155"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBlueSoftBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B7D7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconImage" TargetType="Image">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="SmallIconImage" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Ribbon captions are scaled by the containing Viewbox. Fractional glyph metrics and
             an explicit line box prevent descenders from being clipped at 125%/150% display scale. -->
        <Style x:Key="RibbonPrimaryCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style x:Key="RibbonSecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource RibbonPrimaryCaption}">
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
        </Style>

        <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52647D"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="QuickAccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#5B8DD4"/>
        </Style>

        <Style x:Key="RibbonSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5EAF1"/>
        </Style>

        <Style x:Key="RibbonToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5EAF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleRoot" Property="Background" Value="#EAF3FF"/>
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="#A9CEFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleRoot" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="#1464D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DFE8F2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PanelHeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppBlueDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBlueSoftBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBlueDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0B3F86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExcelVerificationButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Checking}">
                    <Setter Property="Background" Value="#EAF4FF"/><Setter Property="BorderBrush" Value="#8CC5FF"/><Setter Property="Foreground" Value="#1267C4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Verified}">
                    <Setter Property="Background" Value="#ECFDF3"/><Setter Property="BorderBrush" Value="#86D8A2"/><Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Stale}">
                    <Setter Property="Background" Value="#FFF7E6"/><Setter Property="BorderBrush" Value="#F3C56B"/><Setter Property="Foreground" Value="#A15C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Failed}">
                    <Setter Property="Background" Value="#FFF1F0"/><Setter Property="BorderBrush" Value="#F3A7A1"/><Setter Property="Foreground" Value="#B42318"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Properties panel: unified section card -->
        <Style x:Key="PropCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C7D2DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Properties panel: section title with colored accent bar -->
        <Style x:Key="PropTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AppBlueDarkBrush}"/>
            <Setter Property="Padding" Value="7,2,0,3"/>
            <Setter Property="Margin" Value="-7,-5,-7,5"/>
            <Setter Property="Background" Value="#EAF3FF"/>
        </Style>

        <!-- Properties panel: field caption (darker for readability) -->
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,3,0,1"/>
        </Style>

        <!-- Properties panel: compact chip button (formula builder, layer order) -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <Style x:Key="FontToolbarCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AlignIconRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FontStyleIcon" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#16304A"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DCEBFF"/>
                    <Setter Property="Foreground" Value="#1464D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EDF5"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F6"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Shell regions map: docs/NICELABEL_DESIGNER_SHELL_RESEARCH.md + Figma Full Shell v1 -->
        <Border DockPanel.Dock="Top" Height="52" Background="#102A56" BorderBrush="#234A83" BorderThickness="0,0,0,1"
                AutomationProperties.AutomationId="Shell.QuickAccess"
                AutomationProperties.Name="Quick access">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="30" Height="30" Margin="0,0,11,0" Source="/ANLAbel.App;component/anlabel.ico"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ANLAbel" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Industrial label workspace" FontSize="10" Foreground="#B9CAE7"/>
                    </StackPanel>
                    <Border Margin="14,0,0,0" Padding="8,3" Background="#1E4D8F" BorderBrush="#5B8DD4" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center">
                        <TextBlock x:Name="BuildChannelText" Text="GPL-3.0 · v0.259" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </Border>
                    <Border Width="1" Height="28" Background="#31598F" Margin="12,0,8,0"/>
                    <Button Style="{StaticResource QuickAccessButton}" Click="New_Click" ToolTip="New label (Ctrl+N)" AutomationProperties.Name="New label" AutomationProperties.AutomationId="Shell.QuickAccess.New">
                        <Image Source="Icons/new.png" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessButton}" Click="Open_Click" ToolTip="Open label (Ctrl+O)" AutomationProperties.Name="Open label" AutomationProperties.AutomationId="Shell.QuickAccess.Open">
                        <Image Source="Icons/open.png" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessButton}" Click="Save_Click" ToolTip="Save label (Ctrl+S)" AutomationProperties.Name="Save label" AutomationProperties.AutomationId="Shell.QuickAccess.Save">
                        <Image Source="Icons/save.png" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" AutomationProperties.AutomationId="Shell.QuickAccess.Undo">
                        <Image Source="Icons/undo.png" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" AutomationProperties.AutomationId="Shell.QuickAccess.Redo">
                        <Image Source="Icons/redo.png" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessButton}" Click="RevisionHistory_Click" ToolTip="Template revisions and backups" AutomationProperties.Name="Template revisions" AutomationProperties.AutomationId="Shell.QuickAccess.Revisions">
                        <Image Source="Icons/revisions.png" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ActivationButton" Content="Kích hoạt" Visibility="Collapsed" Padding="12,4" Margin="0,0,16,0"/>
                    <Border Background="#F8FAFC" BorderBrush="#5B8DD4" BorderThickness="1" CornerRadius="5" Padding="9,4" Margin="0,0,10,0"
                            ToolTip="Selected industrial printer queue (status)"
                            AutomationProperties.AutomationId="Shell.QuickAccess.PrinterStatus">
                        <StackPanel Orientation="Horizontal">
                            <Image Style="{StaticResource SmallIconImage}" Source="Icons/printer_status.png" Width="17" Height="17" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Template.PrinterProfile.PrinterName, TargetNullValue=Printer not selected, FallbackValue=Printer not selected}" FontWeight="SemiBold" Foreground="#173B72"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#173B72" BorderBrush="#31598F" BorderThickness="1" CornerRadius="5" Padding="9,4">
                    <TextBlock FontWeight="SemiBold" Foreground="#E8F0FD">
                        <Run Text="Paper: "/>
                        <Run Text="{Binding Template.WidthMm, StringFormat={}{0:0.##}}"/>
                        <Run Text=" x "/>
                        <Run Text="{Binding Template.HeightMm, StringFormat={}{0:0.##}}"/>
                        <Run Text=" mm"/>
                    </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#F2F6FB" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,5"
                AutomationProperties.AutomationId="Shell.Ribbon"
                AutomationProperties.Name="Ribbon">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <Button Style="{StaticResource RibbonButton}" Click="TemplateLibrary_Click" ToolTip="Mở thư viện mẫu tem có sẵn" AutomationProperties.Name="Templates" AutomationProperties.AutomationId="Shell.Ribbon.Templates">
                            <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/folder.png"/><TextBlock Text="Templates" Style="{StaticResource RibbonPrimaryCaption}"/></StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Library"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Click="ImportExcel_Click" AutomationProperties.Name="Import Excel" AutomationProperties.AutomationId="Shell.Ribbon.ImportExcel">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/import_excel.png"/><TextBlock Text="Import" Style="{StaticResource RibbonPrimaryCaption}"/><TextBlock Text="Excel" Style="{StaticResource RibbonSecondaryCaption}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding RefreshExcelDataCommand}" ToolTip="Reload data from the linked Excel file and sheet" AutomationProperties.Name="Update Excel" AutomationProperties.AutomationId="Shell.Ribbon.UpdateExcel">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/update_excel.png"/><TextBlock Text="Update" Style="{StaticResource RibbonPrimaryCaption}"/><TextBlock Text="Excel" Style="{StaticResource RibbonSecondaryCaption}"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Data"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Click="PrinterSetup_Click" AutomationProperties.Name="Printer Setup" AutomationProperties.AutomationId="Shell.Ribbon.PrinterSetup">
