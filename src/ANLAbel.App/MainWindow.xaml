                                                    <TextBlock Text="Khe giữa ký tự Code 39 (X)" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/>
                                                    <TextBox Text="{Binding SelectedObject.Code39IntercharacterGapModules, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             ToolTip="Khoảng trắng giữa hai ký tự Code 39, tính bằng số lần vạch hẹp (1 - 5, chuẩn là 1)."
                                                             Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Bù loang vạch (chấm)" Foreground="{StaticResource AppMutedBrush}" FontSize="10" VerticalAlignment="Center"
                                                           ToolTip="Số chấm máy in cắt bớt khỏi mỗi vạch đen của mã vạch 1D để bù mực loang khi in nhiệt. 0 = không bù. Phải nhỏ hơn số chấm của vạch hẹp; kiểm tra bằng máy quét trên tem in thật."/>
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding SelectedObject.BarcodeBarWidthReductionDots, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Số chấm cắt bớt mỗi vạch đen (0 - 10)."
                                                         Margin="0,1,0,0"/>
                                            </Grid>
                                            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsSelectedLinearCode, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Vạch bao" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,1"/>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Vạch bao" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/>
                                                        <ComboBox ItemsSource="{Binding BearerBarStyleOptions}" ItemTemplate="{StaticResource DisplayNameItem}"
                                                                  SelectedItem="{Binding SelectedObject.BearerBarStyle, Mode=TwoWay}"
                                                                  ToolTip="Vạch bao (bảo vệ) cho mã vạch tuyến tính đóng gói (ví dụ ITF-14). Trên &amp; dưới hoặc khung bao trọn."
                                                                  Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Độ dày vạch bao (mm)" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/>
                                                        <TextBox Text="{Binding SelectedObject.BearerBarThicknessMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                                                 ToolTip="Độ dày của vạch bao / bảo vệ theo mi-li-mét (mặc định 1.0 mm)."
                                                                 Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Độ dày vạch bao (× vạch hẹp)" Foreground="{StaticResource AppMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding SelectedObject.BearerBarThicknessModules, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             ToolTip="Độ dày vạch bao bằng số lần vạch hẹp hiệu dụng (1 - 10), tự theo cỡ X và DPI. 0 = dùng độ dày mm ở trên."
                                                             Margin="0,1,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PropCard}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Image}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Đổi cỡ ảnh" Style="{StaticResource PropTitle}"/>
                                        <TextBlock Text="Cỡ ảnh" Style="{StaticResource PropLabel}" Margin="0,0,0,1"/>
                                        <ComboBox ItemsSource="{Binding PictureSizings}" ItemTemplate="{StaticResource DisplayNameItem}"
                                                  SelectedItem="{Binding SelectedObject.PictureSizing, Mode=TwoWay}" Margin="0,0,0,4"
                                                  ToolTip="Co giãn theo tỉ lệ: cả ảnh, canh giữa. Kéo đầy khung: ảnh giãn theo khung. Giữ cỡ gốc: cỡ theo điểm ảnh và độ phân giải, cắt ở khung." AutomationProperties.Name="Cỡ ảnh"/>
                                        <WrapPanel Margin="0,0,0,4">
                                            <CheckBox Content="Lật ngang" IsChecked="{Binding SelectedObject.PictureFlipHorizontal, Mode=TwoWay}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Lật dọc" IsChecked="{Binding SelectedObject.PictureFlipVertical, Mode=TwoWay}"/>
                                        </WrapPanel>
                                        <Button Content="Về cỡ gốc" Command="{Binding ResetPictureSizeCommand}" HorizontalAlignment="Left" Padding="8,3"
                                                ToolTip="Đặt khung ảnh bằng cỡ gốc của ảnh"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- NiceLabel 10 floating Properties: the same panel, re-parented here while unpinned -->
            <Popup x:Name="PropertiesPopup" Placement="Relative" PlacementTarget="{Binding ElementName=DesignerCanvas}"
                   StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border x:Name="PropertiesPopupHost" Width="300" Height="560" Background="#FFFFFF" BorderBrush="#1464D2" BorderThickness="1"
                        AutomationProperties.AutomationId="Shell.Properties.Floating">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                </Border>
            </Popup>

        </Grid>
        </DockPanel>

            <!-- NiceLabel 10 backstage (Tệp): covers the ribbon and the workspace under the title bar.
                 Pages on the left (Bắt đầu, Mới, Mở, Giới thiệu) show on the right; commands run and close it. -->
            <Grid x:Name="BackstagePanel" Visibility="Collapsed" Background="{StaticResource BackstagePageBrush}"
                  KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.AutomationId="Shell.Backstage" AutomationProperties.Name="Tệp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource RibbonChromeBrush}">
                    <StackPanel>
                        <Button Style="{StaticResource BackstageBackButton}" Click="CloseBackstage_Click" ToolTip="Quay lại thiết kế (Esc)"
                                AutomationProperties.Name="Back to the designer" AutomationProperties.AutomationId="Shell.Backstage.Back"/>
                        <RadioButton x:Name="BackstageStartTab" Style="{StaticResource BackstageTab}" Content="Bắt đầu" Tag="Start" Checked="BackstageTab_Checked" AutomationProperties.AutomationId="Shell.Backstage.Start"/>
                        <RadioButton x:Name="BackstageNewTab" Style="{StaticResource BackstageTab}" Content="Mới" Tag="New" Checked="BackstageTab_Checked" AutomationProperties.AutomationId="Shell.Backstage.New"/>
                        <RadioButton x:Name="BackstageOpenTab" Style="{StaticResource BackstageTab}" Content="Mở" Tag="Open" Checked="BackstageTab_Checked" AutomationProperties.AutomationId="Shell.Backstage.Open"/>
                        <Button Style="{StaticResource BackstageCommand}" Content="Nhập tem NiceLabel" Click="BackstageImport_Click"
                                ToolTip="Mở tem NiceLabel (.nlbl, .lbl) thành mẫu tem mới" AutomationProperties.AutomationId="Shell.Backstage.Import"/>
                        <Border Style="{StaticResource BackstageSeparator}"/>
                        <Button Style="{StaticResource BackstageCommand}" Content="Lưu" Click="BackstageSave_Click" ToolTip="Lưu tem (Ctrl+S)" AutomationProperties.AutomationId="Shell.Backstage.Save"/>
                        <Button Style="{StaticResource BackstageCommand}" Content="Lưu thành" Click="BackstageSaveAs_Click" ToolTip="Lưu thành tệp khác (Ctrl+Shift+S)" AutomationProperties.AutomationId="Shell.File.SaveAs"/>
                        <Button Style="{StaticResource BackstageCommand}" Content="In" Click="BackstagePrint_Click" ToolTip="Xem trước, chọn dòng và số bản rồi in (Ctrl+P)" AutomationProperties.AutomationId="Shell.Backstage.Print"/>
                        <Button Style="{StaticResource BackstageCommand}" Content="Phiên bản" Click="BackstageRevisions_Click" ToolTip="Phiên bản và bản sao lưu của tem đã lưu" AutomationProperties.AutomationId="Shell.File.Revisions"/>
                        <RadioButton x:Name="BackstageProtectionTab" Style="{StaticResource BackstageTab}" Content="Bảo vệ" Tag="Protection" Checked="BackstageTab_Checked" AutomationProperties.AutomationId="Shell.Backstage.Protection"/>
                        <Border Style="{StaticResource BackstageSeparator}"/>
                        <Button Style="{StaticResource BackstageCommand}" Content="Tùy chọn" Click="BackstageOptions_Click" ToolTip="Cài đặt ANLAbel" AutomationProperties.AutomationId="Shell.File.Settings"/>
                        <RadioButton x:Name="BackstageAboutTab" Style="{StaticResource BackstageTab}" Content="Giới thiệu" Tag="About" Checked="BackstageTab_Checked" AutomationProperties.AutomationId="Shell.Backstage.About"/>
                        <Button Style="{StaticResource BackstageCommand}" Content="Thoát" Click="BackstageExit_Click" ToolTip="Đóng ANLAbel" AutomationProperties.AutomationId="Shell.Backstage.Exit"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <!-- Bắt đầu: NiceLabel landing page - create and open on the left, resources on the right -->
                    <ScrollViewer x:Name="BackstageStartPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="40,30,40,30" MaxWidth="1100" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource BackstagePageTitle}" Text="Bắt đầu"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BackstageCard}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Button Style="{StaticResource BackstageLinkButton}" controls:Ribbon.Icon="{StaticResource Icon.New32}" Content="Tạo tem mới" Click="BackstageNewLabel_Click"
                                                AutomationProperties.AutomationId="Shell.Backstage.Start.New"/>
                                        <Button Style="{StaticResource BackstageLinkButton}" controls:Ribbon.Icon="{StaticResource Icon.SampleFiles32}" Content="Tạo từ mẫu có sẵn" Click="BackstageTemplates_Click"
                                                AutomationProperties.AutomationId="Shell.Backstage.Start.Templates"/>
                                        <Button Style="{StaticResource BackstageLinkButton}" controls:Ribbon.Icon="{StaticResource Icon.Open32}" Content="Mở…" Click="BackstageBrowse_Click"
                                                AutomationProperties.AutomationId="Shell.Backstage.Start.Open"/>
                                        <TextBlock Style="{StaticResource BackstageCardHeader}" Text="Tệp gần đây" Margin="4,14,0,6"/>
                                        <Border Height="1" Background="{StaticResource RibbonLineBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl x:Name="StartRecentList" ItemTemplate="{StaticResource BackstageRecentItem}" AutomationProperties.AutomationId="Shell.Backstage.Start.Recent"/>
                                        <TextBlock x:Name="StartRecentEmpty" Text="Chưa có tệp nào. Tem bạn mở hoặc lưu sẽ hiện ở đây." Foreground="{StaticResource RibbonCaptionBrush}"
                                                   TextWrapping="Wrap" Margin="4,4,4,8"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource BackstageCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BackstageCardHeader}" Text="Tài liệu và trợ giúp" Margin="4,2,0,8"/>
                                            <UniformGrid Columns="5">
                                                <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.UserGuide32}" Content="Hướng dẫn&#10;sử dụng" Click="UserGuides_Click" HorizontalAlignment="Center"/>
                                                <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Help32}" Content="Trợ giúp" Click="Help_Click" HorizontalAlignment="Center"/>
                                                <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.SampleFiles32}" Content="Tệp mẫu" Click="BackstageTemplates_Click" HorizontalAlignment="Center"/>
                                                <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Support32}" Content="Hỗ trợ&#10;kỹ thuật" Click="TechnicalSupport_Click" HorizontalAlignment="Center"/>
                                                <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.HomePage32}" Content="Trang chủ" Click="HomePage_Click" HorizontalAlignment="Center"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BackstageCard}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BackstageCardHeader}" Text="Máy in" Margin="4,2,0,8"/>
                                            <TextBlock TextWrapping="Wrap" Margin="4,0,4,10" Foreground="{StaticResource RibbonTextBrush}">
                                                <Run Text="Tem in qua hàng đợi máy in Windows. Máy in của tem này: "/><Run FontWeight="SemiBold" Text="{Binding Template.PrinterProfile.PrinterName, Mode=OneWay, Converter={StaticResource EmptyText}, ConverterParameter=chưa chọn, FallbackValue=chưa chọn}"/><Run Text="."/>
                                            </TextBlock>
                                            <Button Style="{StaticResource BackstagePrimaryButton}" Content="Thuộc tính tem…" Click="BackstagePrinterSetup_Click" HorizontalAlignment="Left" Margin="4,0,0,4"
                                                    AutomationProperties.AutomationId="Shell.Backstage.Start.PrinterSetup"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Mới -->
                    <StackPanel x:Name="BackstageNewPage" Visibility="Collapsed" Margin="40,30,40,30">
                        <TextBlock Style="{StaticResource BackstagePageTitle}" Text="Mới"/>
                        <StackPanel Margin="20,0,0,0" HorizontalAlignment="Left">
                            <Button Style="{StaticResource BackstageTileButton}" controls:Ribbon.Icon="{StaticResource Icon.New32}" Content="Tem trống" Tag="Chọn tên, kích thước và độ phân giải của tem mới."
                                    Click="BackstageNewLabel_Click" AutomationProperties.AutomationId="Shell.Backstage.New.Blank"/>
                            <Button Style="{StaticResource BackstageTileButton}" controls:Ribbon.Icon="{StaticResource Icon.SampleFiles32}" Content="Từ mẫu có sẵn" Tag="Bắt đầu từ một mẫu tem trong thư viện."
                                    Click="BackstageTemplates_Click" AutomationProperties.AutomationId="Shell.Backstage.New.Templates"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mở: browse on the left, recent documents on the right (NiceLabel Open page) -->
                    <Grid x:Name="BackstageOpenPage" Visibility="Collapsed" Margin="40,30,40,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource BackstagePageTitle}" Text="Mở"/>
                        <DockPanel Grid.Row="1" Margin="20,0,0,0" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left">
                                <Button Style="{StaticResource BackstageTileButton}" controls:Ribbon.Icon="{StaticResource Icon.Open32}" Content="Duyệt…" Tag="Mở tem ANLAbel, NiceLabel hoặc JSON trên máy."
                                        Click="BackstageBrowse_Click" AutomationProperties.AutomationId="Shell.Backstage.Open.Browse"/>
                                <Button Style="{StaticResource BackstageTileButton}" controls:Ribbon.Icon="{StaticResource Icon.Import32}" Content="Nhập tem NiceLabel…" Tag="Tệp .nlbl hoặc .lbl thành mẫu tem mới."
                                        Click="BackstageImport_Click" AutomationProperties.AutomationId="Shell.Backstage.Open.Import"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Left" Width="1" Background="#2A7CC2" Margin="25,10,5,0"/>
                            <DockPanel Margin="25,0,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Tệp gần đây" FontFamily="Segoe UI Light" FontSize="24" FontWeight="Bold" Foreground="#2A579A" Margin="0,0,0,10"/>
                                <TextBlock x:Name="OpenRecentEmpty" DockPanel.Dock="Top" Text="Chưa có tệp nào. Tem bạn mở hoặc lưu sẽ hiện ở đây." Foreground="{StaticResource RibbonCaptionBrush}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left">
                                    <ItemsControl x:Name="OpenRecentList" Width="520" ItemTemplate="{StaticResource BackstageRecentItem}" AutomationProperties.AutomationId="Shell.Backstage.Open.Recent"/>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Grid>

                    <!-- Giới thiệu: version, licence, links -->
                    <!-- Bảo vệ: NiceLabel 10 Info › Protection, "Protect document from editing" -->
                    <StackPanel x:Name="BackstageProtectionPage" Visibility="Collapsed" Margin="40,30,40,30" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource BackstagePageTitle}" Text="Bảo vệ"/>
                        <Border Style="{StaticResource BackstageCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BackstageCardHeader}" Text="Bảo vệ tem khỏi chỉnh sửa" Margin="4,2,0,6"/>
                                <TextBlock TextWrapping="Wrap" Margin="4,0,4,8" Foreground="{StaticResource RibbonTextBrush}"
                                           Text="Tem mở ra ở chế độ chỉ in: không sửa được đối tượng, thuộc tính hay bố cục; vẫn chọn dữ liệu, máy in và in được. Đây là chống sửa nhầm khi vận hành, không mã hóa tệp."/>
                                <TextBlock Text="{Binding EditingProtectionStatusText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="4,0,4,10"
                                           AutomationProperties.AutomationId="Shell.Backstage.Protection.Status"/>
                                <StackPanel IsEnabled="{Binding IsEditingAllowed}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <CheckBox x:Name="ProtectionRequirePasswordBox" Content="Yêu cầu mật khẩu để mở khóa" Margin="4,0,0,8" AutomationProperties.AutomationId="Shell.Backstage.Protection.RequirePassword"/>
                                <Grid Margin="4,0,4,12" IsEnabled="{Binding IsChecked, ElementName=ProtectionRequirePasswordBox}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Mật khẩu (ít nhất 4 ký tự)"/>
                                        <PasswordBox x:Name="ProtectionPasswordBox" Margin="0,3,0,0" AutomationProperties.Name="Mật khẩu bảo vệ"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nhập lại mật khẩu"/>
                                        <PasswordBox x:Name="ProtectionPasswordConfirmBox" Margin="0,3,0,0" AutomationProperties.Name="Nhập lại mật khẩu bảo vệ"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                    <Button Style="{StaticResource BackstagePrimaryButton}" Content="Bật bảo vệ" Click="ProtectionEnable_Click" AutomationProperties.AutomationId="Shell.Backstage.Protection.Enable"/>
                                    <Button Style="{StaticResource BackstageSecondaryButton}" Content="Tắt bảo vệ" Click="ProtectionDisable_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="Shell.Backstage.Protection.Disable"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer x:Name="BackstageAboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30,40,30" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource BackstagePageTitle}" Text="Giới thiệu"/>
                            <Border Style="{StaticResource BackstageCard}" Padding="20,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/ANLAbel.App;component/anlabel.ico" Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static viewModels:MainViewModel.ApplicationTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}"/>
                                            <TextBlock Text="Thiết kế và in tem nhãn công nghiệp" Foreground="{StaticResource RibbonCaptionBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource RibbonTextBrush}"
                                               Text="Tác giả: Duc An. Phần mềm tự do theo Giấy phép Công cộng GNU, chỉ phiên bản 3 (GPL-3.0): bạn được dùng, nghiên cứu, sửa đổi và phân phối lại theo các điều khoản của giấy phép."/>
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource RibbonTextBrush}" FontWeight="SemiBold"
                                               Text="Phần mềm được cung cấp KHÔNG KÈM BẤT KỲ BẢO HÀNH NÀO."/>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Style="{StaticResource BackstagePrimaryButton}" Content="Kiểm tra cập nhật…" Click="CheckUpdates_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="Shell.Backstage.About.Updates"/>
                                        <Button Style="{StaticResource BackstageSecondaryButton}" Content="Trang dự án" Click="HomePage_Click" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource BackstageSecondaryButton}" Content="Giấy phép và thư viện bên thứ ba…" Click="About_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
