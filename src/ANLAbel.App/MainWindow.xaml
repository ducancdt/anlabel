                                            <TextBlock Text="Giá trị nhập khi in và ngày giờ" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,4"
                                                       Text="Dùng {?Tên} trong liên kết dữ liệu để hỏi người vận hành khi bấm In (ví dụ {?Lot}), và {#NOW:dd/MM/yyyy} hoặc {#NOW+30d:dd/MM/yyyy} để in ngày giờ hoặc hạn dùng (đơn vị d, w, mo, y, h). Giá trị được lưu theo lệnh in nên in lại ra đúng như cũ. Khai báo thêm điều kiện cho từng tên ở bảng dưới (không bắt buộc)."/>
                                            <DataGrid ItemsSource="{Binding Template.PromptVariables}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                                      HeadersVisibility="Column" MinHeight="60" MaxHeight="160" FontSize="11">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tên" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                                    <DataGridTextColumn Header="Câu hỏi" Binding="{Binding Prompt, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                                    <DataGridTextColumn Header="Mặc định" Binding="{Binding DefaultValue, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                                    <DataGridTextColumn Header="Tối đa" Binding="{Binding MaxLength, UpdateSourceTrigger=LostFocus}" Width="45"/>
                                                    <DataGridCheckBoxColumn Header="Số" Binding="{Binding DigitsOnly, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                                                    <DataGridCheckBoxColumn Header="Bắt buộc" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Nguồn dữ liệu dùng chung" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,4"
                                                       Text="Dùng lại một tệp/trang Excel cho nhiều mẫu tem. Liên kết lại nguồn dùng chung một lần sẽ sửa cho mọi mẫu tem đang dùng nó."/>
                                            <ItemsControl ItemsSource="{Binding DataSources}" Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Quản lý nguồn dữ liệu..." Click="ManageDataSources_Click" HorizontalAlignment="Left" Padding="6,2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Biến đổi" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="Trường tính toán chạy trước khi xem trước và in." FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                            <ItemsControl ItemsSource="{Binding DataTransforms}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,1" FontSize="10.5" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" = "/><Run Text="{Binding Formula, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    </Expander>
                                    <Border BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                <Style.Triggers>
                                                    <!-- Nothing read from Excel yet: neutral, not a green pass -->
                                                    <DataTrigger Binding="{Binding ReadsExcelFields}" Value="False">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasBindingIssues}" Value="True">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                    <!-- No file linked yet: the columns are to come, nothing is broken -->
                                                    <DataTrigger Binding="{Binding AwaitsExcelData}" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Kiểm tra ràng buộc" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="{Binding BindingIssuesSummary}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <ItemsControl ItemsSource="{Binding BindingIssues}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectBindingIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Margin="0,0,0,6"
                                                                Padding="8,7">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding MissingFieldsSummary}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding AwaitingData}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ErrorsSummary}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem IsEnabled="{Binding IsEditingAllowed}">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource Icon.Layers16}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Lớp"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="4,8">
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                <TreeView>
                                                    <TreeViewItem IsExpanded="True">
                                                        <TreeViewItem.Header>
                                                            <StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Folder16}" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Mẫu tem" FontWeight="SemiBold"/></StackPanel>
                                                        </TreeViewItem.Header>
                                                        <TreeViewItem Header="{Binding Template.Name}"/>
                                                        <TreeViewItem Header="{Binding Template.WidthMm, StringFormat={}{0:0.##} mm}"/>
                                                        <TreeViewItem Header="{Binding Template.HeightMm, StringFormat={}{0:0.##} mm}"/>
                                                    </TreeViewItem>
                                                </TreeView>
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="Đối tượng" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="2,0,0,6"/>
                                                    <TreeView ItemsSource="{Binding Template.Objects}">
                                                        <TreeView.ItemTemplate>
                                                            <HierarchicalDataTemplate>
                                                                <StackPanel x:Name="Row" Margin="0,2">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Type, Converter={StaticResource DisplayName}}" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}"/>
                                                                        <TextBlock x:Name="HiddenNote" Text=" · ẩn" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" Visibility="Collapsed"/>
                                                                        <TextBlock Text=" · khóa vị trí" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding BindingStateDisplayText}" FontSize="10" Foreground="{StaticResource AppBlueDarkBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <HierarchicalDataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter TargetName="HiddenNote" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                                                    </DataTrigger>
                                                                </HierarchicalDataTemplate.Triggers>
                                                            </HierarchicalDataTemplate>
                                                        </TreeView.ItemTemplate>
                                                    </TreeView>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem AutomationProperties.AutomationId="Shell.Workspace.Objects" IsEnabled="{Binding IsEditingAllowed}">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource Icon.Objects16}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Đối tượng"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <DockPanel Margin="4,8">
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBox x:Name="ObjectBrowserSearch" TextChanged="ObjectBrowserSearch_TextChanged"
                                                     ToolTip="Tìm đối tượng theo tên hoặc nội dung" AutomationProperties.Name="Object search"/>
                                            <TextBlock Text="Tìm…" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AppMutedBrush}" IsHitTestVisible="False">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ObjectBrowserSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <ListBox x:Name="ObjectBrowserList" SelectedItem="{Binding SelectedObject, Mode=TwoWay}" BorderThickness="0"
                                                 AutomationProperties.Name="Object browser">
                                            <!-- Screen readers read the object name and type, not the model class name -->
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="AutomationProperties.Name">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                                <Binding Path="Name"/>
                                                                <Binding Path="Type" Converter="{StaticResource DisplayName}"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel x:Name="Row" Margin="0,2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Type, Converter={StaticResource DisplayName}}" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}"/>
                                                            <TextBlock x:Name="HiddenNote" Text=" · ẩn" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" Visibility="Collapsed"/>
                                                            <TextBlock Text=" · khóa vị trí" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                            <Setter TargetName="HiddenNote" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding IsToolboxVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Grid Grid.Column="2" Background="{StaticResource AppWorkspaceBrush}" Margin="0,12,0,0"
                  AutomationProperties.AutomationId="Shell.Canvas"
                  AutomationProperties.Name="Design surface">
                <Grid.LayoutTransform>
                    <RotateTransform Angle="{Binding ViewRotation}"/>
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,1">
                    <TextBlock Text="mm" FontSize="11" Foreground="{StaticResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <ScrollViewer x:Name="HorizontalRulerScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <Grid Margin="92,0,120,0" HorizontalAlignment="Left">
                            <controls:DesignerRuler LengthMm="{Binding Template.WidthMm}" Zoom="{Binding Zoom}" Orientation="Horizontal"
                                                    Width="{Binding ElementName=DesignerCanvas, Path=ActualWidth}" Height="26"
                                                    GuideDragStarted="Ruler_GuideDragStarted"
                                                    GuideDragging="Ruler_GuideDragging"
                                                    GuideDragCompleted="Ruler_GuideDragCompleted"
                                                    GuideDragCanceled="Ruler_GuideDragCanceled"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer x:Name="VerticalRulerScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  Focusable="False">
                        <Grid Margin="0,72,0,100" VerticalAlignment="Top">
                            <controls:DesignerRuler LengthMm="{Binding Template.HeightMm}" Zoom="{Binding Zoom}" Orientation="Vertical"
                                                    Width="38" Height="{Binding ElementName=DesignerCanvas, Path=ActualHeight}"
                                                    GuideDragStarted="Ruler_GuideDragStarted"
                                                    GuideDragging="Ruler_GuideDragging"
                                                    GuideDragCompleted="Ruler_GuideDragCompleted"
                                                    GuideDragCanceled="Ruler_GuideDragCanceled"/>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <ScrollViewer x:Name="DesignerScrollViewer"
                              Grid.Row="1" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="DesignerScrollViewer_ScrollChanged"
                              PreviewMouseWheel="DesignerScrollViewer_PreviewMouseWheel"
                              Background="{StaticResource AppWorkspaceBrush}">
                    <Grid Margin="92,72,120,100">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <controls:LabelDesignerCanvas x:Name="DesignerCanvas"
                                                          IsEnabled="{Binding IsEditingAllowed}"
                                                          Template="{Binding Template}"
                                                          SelectedObject="{Binding SelectedObject, Mode=TwoWay}"
                                                          PreviewRow="{Binding DesignPreviewRow}"
                                                          DrawingTool="{Binding DrawingTool, Mode=TwoWay}"
                                                          DrawingCommandText="{Binding DrawingCommandText, Mode=TwoWay}"
                                                          InteractionStatusText="{Binding StatusText, Mode=TwoWay}"
                                                          SizeChanged="DesignerCanvas_SizeChanged"
                                                          Zoom="{Binding Zoom}"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <!-- NiceLabel 10 Protection: a protected label is for printing until unlocked -->
                <Border Grid.Row="1" Grid.Column="1" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,7"
                        Background="#FFF7E6" BorderBrush="#E2A93A" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding IsEditingLocked, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="Shell.ProtectionBanner" AutomationProperties.Name="Tem được bảo vệ">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Icon.Lock16}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Tem được bảo vệ khỏi chỉnh sửa: chỉ chọn dữ liệu, máy in và in." VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox x:Name="UnlockPasswordBox" Width="120" VerticalAlignment="Center" Margin="0,0,6,0" KeyDown="UnlockPasswordBox_KeyDown"
                                     Visibility="{Binding HasEditingPassword, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Mật khẩu mở khóa" AutomationProperties.AutomationId="Shell.ProtectionBanner.Password"/>
                        <Button Content="Mở khóa" Padding="10,3" Click="UnlockEditing_Click" AutomationProperties.AutomationId="Shell.ProtectionBanner.Unlock"/>
                    </StackPanel>
                </Border>
                <!-- NiceLabel 10 document tab strip under the design surface (TabStripPlacement Bottom) -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#F2F6FB" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0"
                        AutomationProperties.AutomationId="Shell.DocumentTabs" AutomationProperties.Name="Document tabs">
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1,0,1,1" Padding="12,3" CornerRadius="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Thiết kế tem" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Template.Name, StringFormat={} · {0}}" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding IsPropertiesDocked, Converter={StaticResource BoolToVisibility}}"/>

            <Border x:Name="PropertiesPanel" Grid.Column="4" Margin="0,12,12,12" Style="{StaticResource PanelCard}" Visibility="{Binding IsPropertiesVisible, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="Shell.Properties"
                    AutomationProperties.Name="Object Properties">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="Local" Height="42" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelHeaderButton}" KeyboardNavigation.TabIndex="2" Command="{Binding HidePropertiesCommand}" ToolTip="Đóng thuộc tính" AutomationProperties.AutomationId="Shell.Properties.Close">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" FontSize="11"/>
                            </Button>
                            <ToggleButton DockPanel.Dock="Right" KeyboardNavigation.TabIndex="1" Width="26" Height="24" Margin="0,0,2,0" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsPropertiesPinned, Mode=TwoWay}" Click="PropertiesPin_Click"
                                          ToolTip="Ghim bảng thuộc tính bên phải (F4). Bỏ ghim: bảng nổi cạnh đối tượng khi nhấp đúp, như NiceLabel."
                                          AutomationProperties.Name="Pin properties" AutomationProperties.AutomationId="Shell.Properties.Pin">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE718;" FontSize="12"/>
                            </ToggleButton>
                            <!-- The title fills what the pin and close buttons leave and trims; it never runs under them -->
                            <Grid VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           AutomationProperties.AutomationId="Shell.Properties.Title">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}Thuộc tính - {0} [{1}]{2}">
                                                        <Binding Path="SelectedObject.Name"/>
                                                        <Binding Path="SelectedObjectTypeText"/>
                                                        <Binding Path="SelectionScopeText"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Thuộc tính"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel VerticalAlignment="Top" Margin="12">
                                <Border Background="#EAF3FF" BorderBrush="#9BC4F5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="5" Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Top">
                                            <Image Source="{StaticResource Icon.Pointer16}" Width="16" Height="16"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Chưa chọn đối tượng" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="Chọn một đối tượng để sửa vị trí, nội dung và kiểu." FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Image Source="{StaticResource Icon.Folder16}" Width="16" Height="16" Margin="0,1,7,0"/>
                                            <TextBlock Text="Tài liệu" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                        </StackPanel>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Kích thước tem" Foreground="{StaticResource AppMutedBrush}"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold">
                                                <Run Text="{Binding Template.WidthMm, StringFormat={}{0:0.##}, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Template.HeightMm, StringFormat={}{0:0.##}, Mode=OneWay}"/><Run Text=" mm"/>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Margin="0,5,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Máy in" Foreground="{StaticResource AppMutedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PrinterDisplayName}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#B45309" TextTrimming="CharacterEllipsis" MaxWidth="142"/>
                                        </Grid>
                                        <Grid Margin="0,5,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Dữ liệu" Foreground="{StaticResource AppMutedBrush}"/>
