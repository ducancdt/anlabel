                                          AutomationProperties.AutomationId="Shell.Ribbon.SnapObjects"
                                          ToolTip="Snap object edges and centers while dragging. Hold Alt to bypass temporarily.">
                                <ToggleButton.Resources>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="FontSize" Value="18">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Resources>
                                <StackPanel>
                                    <Image Style="{StaticResource IconImage}" Source="Icons/snap_objects.png"/>
                                    <TextBlock Text="Objects" FontSize="10" TextAlignment="Center"/>
                                    <TextBlock Text="snap" FontSize="9" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggleButton}" Width="62"
                                          IsChecked="{Binding ElementName=DesignerCanvas, Path=IsSnapToGridEnabled, Mode=TwoWay}"
