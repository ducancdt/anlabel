                                          AutomationProperties.AutomationId="Shell.Ribbon.SnapGrid"
                                          ToolTip="Snap object edges to the configured physical grid step. Drag from a ruler to create a persistent guide; right-click the canvas to lock/delete guides or choose the step; hold Alt to bypass temporarily.">
                                <StackPanel>
                                    <Image Style="{StaticResource IconImage}" Source="Icons/snap_grid.png"/>
                                    <TextBlock Text="Grid" FontSize="10" TextAlignment="Center"/>
                                    <TextBlock Text="snap" FontSize="9" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Workspace"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <Button Style="{StaticResource RibbonButton}" Command="controls:LabelDesignerCanvas.DeleteSelectionCommand" AutomationProperties.Name="Delete Selection" AutomationProperties.AutomationId="Shell.Ribbon.DeleteSelection">
                            <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/delete_selection.png"/><TextBlock Text="Delete" Style="{StaticResource RibbonPrimaryCaption}"/><TextBlock Text="Selection" Style="{StaticResource RibbonSecondaryCaption}"/></StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Selection"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Click="Help_Click" AutomationProperties.Name="Help" AutomationProperties.AutomationId="Shell.Ribbon.Help">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/help.png"/><TextBlock Text="Help" Style="{StaticResource RibbonPrimaryCaption}"/><TextBlock Text="F1" Style="{StaticResource RibbonSecondaryCaption}" FontSize="9"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Click="CheckUpdates_Click" ToolTip="Kiểm tra bản cập nhật mới từ GitHub Releases" AutomationProperties.Name="Check for Updates" AutomationProperties.AutomationId="Shell.Ribbon.CheckUpdates">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/app_update.png"/><TextBlock Text="Update" Style="{StaticResource RibbonPrimaryCaption}"/><TextBlock Text="GitHub" Style="{StaticResource RibbonSecondaryCaption}" FontSize="9"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Help"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="34" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0"
                AutomationProperties.AutomationId="Shell.Status"
                AutomationProperties.Name="Printer and status bar">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Foreground="#173B72" VerticalAlignment="Center" Margin="0,0,14,0"
                               MaxWidth="220" TextTrimming="CharacterEllipsis">
                        <Run Text="Printer: "/>
                        <Run Text="{Binding Template.PrinterProfile.PrinterName, TargetNullValue=—, FallbackValue=—}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center"/>
                    <Button Click="PrinterQueueWarning_Click"
                            Visibility="{Binding HasPrinterQueueWarning, Converter={StaticResource BoolToVisibility}}"
                            Margin="12,0,0,0"
                            Padding="7,2"
                            Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            Foreground="#B91C1C"
                            ToolTip="{Binding PrinterQueueStatusMessage}">
                        <TextBlock Text="{Binding PrinterQueueStatusText}" FontWeight="SemiBold"/>
                    </Button>
                    <Button Click="ReviewPrintRecovery_Click"
                            Visibility="{Binding HasPendingPrintRecovery, Converter={StaticResource BoolToVisibility}}"
                            Margin="12,0,0,0"
                            Padding="7,2"
                            Background="#FFF7ED"
                            BorderBrush="#FDBA74"
                            Foreground="#9A3412"
                            ToolTip="Review uncertain print jobs; automatic retry is disabled">
                        <TextBlock Text="{Binding PrintRecoveryStatusText}" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.AutomationId="Shell.Status.Zoom">
                    <TextBlock Text="{Binding ZoomPercent, StringFormat=Zoom: {0}%}" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Image Style="{StaticResource SmallIconImage}" Source="Icons/zoom_minus.png"/>
                    <Slider Width="132" Minimum="0.25" Maximum="4" SmallChange="0.1" LargeChange="0.25" Value="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" AutomationProperties.Name="Zoom" AutomationProperties.AutomationId="Shell.Status.ZoomSlider"/>
                    <Image Style="{StaticResource SmallIconImage}" Source="Icons/zoom_plus.png"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.Background>
                <VisualBrush TileMode="Tile" Viewport="0,0,600,300" ViewportUnits="Absolute">
                    <VisualBrush.Visual>
                        <TextBlock Text="cre: Duc An" FontSize="56" FontWeight="Bold" Foreground="#64748B" Opacity="0.18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsToolboxVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=268}"/>
                <ColumnDefinition Width="{Binding IsToolboxVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=6}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding IsPropertiesVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=6}"/>
                <ColumnDefinition Width="{Binding IsPropertiesVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=280}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12,12,0,12" Style="{StaticResource PanelCard}" Visibility="{Binding IsToolboxVisible, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="Shell.LeftColumn"
                    AutomationProperties.Name="Objects and workspace">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="286" MinHeight="220"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0"
                            AutomationProperties.AutomationId="Shell.Toolbox"
                            AutomationProperties.Name="Insert objects">
                        <DockPanel>
                            <TextBlock Text="Insert objects" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelHeaderButton}" Command="{Binding HideToolboxCommand}" ToolTip="Hide toolbox">
                                <Image Style="{StaticResource SmallIconImage}" Source="Icons/collapse_chevron.png"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="8,8,8,8">
                        <UniformGrid Columns="2" Rows="4">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddTextCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/static_text.png"/><TextBlock Text="Static Text" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddTextBoxCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/text_box.png"/><TextBlock Text="Text Box" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddBarcodeCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/barcode.png"/><TextBlock Text="Barcode" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddLineCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/line.png"/><TextBlock Text="Line" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddRectangleCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/rectangle.png"/><TextBlock Text="Rectangle" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddEllipseCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/ellipse.png"/><TextBlock Text="Ellipse" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddImageCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/image.png"/><TextBlock Text="Image" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="{Binding DrawingCommandText}" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" TextWrapping="Wrap" Margin="4,8,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDrawingTool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                    <GridSplitter Grid.Row="2"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#EEF2F6"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True"/>

                    <Border Grid.Row="3" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" MinHeight="160"
                            AutomationProperties.AutomationId="Shell.Workspace"
                            AutomationProperties.Name="Workspace Layers and Data">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Workspace" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Image DockPanel.Dock="Right" Style="{StaticResource SmallIconImage}" Source="Icons/collapse_chevron.png"/>
                                </DockPanel>
                            </Border>
                            <TabControl BorderThickness="0" Padding="6" SelectedIndex="1">
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Icons/panels.png" Width="15" Height="15" Margin="0,0,6,0"/>
                                            <TextBlock Text="Layers"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="4,8">
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                <TreeView>
                                                    <TreeViewItem IsExpanded="True">
                                                        <TreeViewItem.Header>
                                                            <StackPanel Orientation="Horizontal"><Image Source="Icons/folder.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Template" FontWeight="SemiBold"/></StackPanel>
                                                        </TreeViewItem.Header>
                                                        <TreeViewItem Header="{Binding Template.Name}"/>
                                                        <TreeViewItem Header="{Binding Template.WidthMm, StringFormat={}{0:0.##} mm}"/>
                                                        <TreeViewItem Header="{Binding Template.HeightMm, StringFormat={}{0:0.##} mm}"/>
                                                    </TreeViewItem>
                                                </TreeView>
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="Objects" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="2,0,0,6"/>
                                                    <TreeView ItemsSource="{Binding Template.Objects}">
                                                        <TreeView.ItemTemplate>
                                                            <HierarchicalDataTemplate>
                                                                <StackPanel Margin="0,2">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Type}" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}"/>
                                                                    <TextBlock Text="{Binding BindingStateDisplayText}" FontSize="10" Foreground="{StaticResource AppBlueDarkBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </HierarchicalDataTemplate>
                                                        </TreeView.ItemTemplate>
                                                    </TreeView>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Icons/database.png" Width="15" Height="15" Margin="0,0,6,0"/>
                                            <TextBlock Text="Data"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4,8">
                                    <TreeView Padding="0,0,0,8" Visibility="Collapsed">
                                        <TreeViewItem IsExpanded="True" Visibility="Collapsed">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal"><Image Source="Icons/folder.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Template"/></StackPanel>
                                            </TreeViewItem.Header>
                                            <TreeViewItem Header="{Binding Template.Name}"/>
                                            <TreeViewItem Header="{Binding Template.WidthMm, StringFormat={}{0:0.##} mm}"/>
                                            <TreeViewItem Header="{Binding Template.HeightMm, StringFormat={}{0:0.##} mm}"/>
                                        </TreeViewItem>
                                        <TreeViewItem IsExpanded="True" ItemsSource="{Binding Template.Objects}" Visibility="Collapsed">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal"><Image Source="Icons/panels.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Objects"/></StackPanel>
                                            </TreeViewItem.Header>
                                            <TreeViewItem.ItemTemplate>
                                                <HierarchicalDataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource AppMutedBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding Path="Type"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <Border Padding="6,2" Margin="0,4,0,0" CornerRadius="4" HorizontalAlignment="Left" Background="#EAF3FF">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="#EAF3FF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BindingStateDisplayText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BindingStateDisplayText}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasBindingIssue}" Value="True">
                                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BindingStateDisplayText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Setter Property="Foreground" Value="{StaticResource AppBlueDarkBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasBindingIssue}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </HierarchicalDataTemplate>
                                            </TreeViewItem.ItemTemplate>
                                        </TreeViewItem>
                                        <TreeViewItem IsExpanded="True">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal"><Image Source="Icons/database.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Database"/></StackPanel>
                                            </TreeViewItem.Header>
                                            <TreeViewItem Header="{Binding LinkedExcelSourceText}"/>
                                            <TextBlock Text="{Binding ExcelDataFreshnessText}" Foreground="{StaticResource AppMutedBrush}" FontSize="10.5" Margin="4,0,4,2" TextWrapping="Wrap"/>
                                             <TextBlock Text="{Binding ExcelLinkStatusText}" Foreground="#DC2626" FontSize="11" Margin="4,2" TextWrapping="Wrap"/>
                                             <TextBlock Text="{Binding DataTransformError}" Foreground="#DC2626" FontSize="11" Margin="4,2" TextWrapping="Wrap" Visibility="{Binding HasDataTransformError, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="🔗 Relink Excel..." Command="{Binding RelinkExcelCommand}" Margin="4,2" Padding="6,2" HorizontalAlignment="Left" Visibility="{Binding IsExcelLinkBroken, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding ExcelStaleNoticeText}" Foreground="#B45309" FontSize="11" Margin="4,2" TextWrapping="Wrap" Visibility="{Binding IsExcelDataStale, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="↻ Update Excel" Command="{Binding RefreshExcelDataCommand}" Margin="4,2" Padding="6,2" HorizontalAlignment="Left" Visibility="{Binding IsExcelDataStale, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="⛔ Unlink Excel" Click="UnlinkExcel_Click" Margin="4,2" Padding="6,2" HorizontalAlignment="Left"
                                                    ToolTip="Remove the Excel link from this template. Object bindings are kept — import Excel again to resume printing."
                                                    Visibility="{Binding HasLinkedExcelSource, Converter={StaticResource BoolToVisibility}}"/>
                                             <TreeViewItem Header="{Binding CurrentExcelRowText}"/>
                                             <TreeViewItem Header="Transforms" IsExpanded="False" Visibility="Collapsed">
                                                 <ItemsControl ItemsSource="{Binding DataTransforms}">
                                                     <ItemsControl.ItemTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Margin="4,1" FontSize="10.5" TextWrapping="Wrap">
                                                                 <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                 <Run Text=" = "/>
                                                                 <Run Text="{Binding Formula}"/>
                                                             </TextBlock>
                                                         </DataTemplate>
                                                     </ItemsControl.ItemTemplate>
                                                 </ItemsControl>
                                             </TreeViewItem>
                                         </TreeViewItem>
                                    </TreeView>
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                            Visibility="{Binding HasLinkedExcelSource, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                <Image Source="Icons/database.png" Width="18" Height="18" Margin="0,0,7,0"/>
                                                <TextBlock Text="Current data" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LinkedExcelSourceText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding LinkedExcelSourceText}"/>
                                            <TextBlock Text="{Binding CurrentExcelRowText}" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ExcelDataFreshnessText}" FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ExcelLinkStatusText}" FontSize="10.5" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <WrapPanel Margin="0,7,0,0">
                                                <Button Content="Relink Excel..." Command="{Binding RelinkExcelCommand}" Padding="7,3" Margin="0,0,5,5"
                                                        Visibility="{Binding IsExcelLinkBroken, Converter={StaticResource BoolToVisibility}}"/>
                                                <Button Content="Update Excel" Command="{Binding RefreshExcelDataCommand}" Padding="7,3" Margin="0,0,5,5"/>
                                                <Button Content="Unlink" Click="UnlinkExcel_Click" Padding="7,3" Margin="0,0,0,5"
                                                        ToolTip="Remove the Excel link while keeping object bindings."/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLinkedExcelSource}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Image Source="Icons/database.png" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                <StackPanel>
                                                    <TextBlock Text="No data linked" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Import Excel or CSV to preview rows and bind object fields." FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Click="ImportExcel_Click" HorizontalAlignment="Stretch" Padding="8,6" Background="{StaticResource AppBlueBrush}" Foreground="#FFFFFF" BorderBrush="{StaticResource AppBlueBrush}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⊞" FontSize="16" Foreground="#FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Import Excel / CSV" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0"
                                            Visibility="{Binding HasExcelData, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Excel Rows" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentExcelRowText}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DataGrid ItemsSource="{Binding ExcelDataView}"
                                                      SelectedItem="{Binding SelectedDataItem, Mode=TwoWay}"
                                                      AutoGenerateColumns="True"
                                                      Height="190"
                                                      MaxHeight="240"
                                                      MinHeight="120"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Expander Header="Data settings · Tracking, copies, transforms &amp; sources" IsExpanded="False" Margin="0,8,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}">
                                    <StackPanel>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0"
                                            Visibility="{Binding HasExcelData, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Row Tracking Key" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,4"
                                                       Text="Optional: pick a column to keep the same row selected after refresh, even if Excel rows are inserted or removed. Leave blank to track by row position."/>
                                            <ComboBox ItemsSource="{Binding KeyFieldOptions}" SelectedItem="{Binding SelectedKeyFieldName, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0"
                                            Visibility="{Binding HasExcelData, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Copies Per Record" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,4"
                                                       Text="Optional: pick a column whose value sets how many labels to print for each row in Print Preview. Leave blank for 1 copy per row (still editable by hand there)."/>
                                            <ComboBox ItemsSource="{Binding KeyFieldOptions}" SelectedItem="{Binding SelectedCopiesFieldName, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Shared Data Sources" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,4"
                                                       Text="Reuse one Excel file/sheet across multiple templates. Relinking a shared source once fixes it for every template that uses it."/>
                                            <ItemsControl ItemsSource="{Binding DataSources}" Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Manage Data Sources..." Click="ManageDataSources_Click" HorizontalAlignment="Left" Padding="6,2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Transforms" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="Calculated fields run before preview and print." FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                            <ItemsControl ItemsSource="{Binding DataTransforms}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,1" FontSize="10.5" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name}" FontWeight="SemiBold"/><Run Text=" = "/><Run Text="{Binding Formula}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    </Expander>
                                    <Border BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBindingIssues}" Value="True">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Binding checks" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="{Binding BindingIssuesSummary}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <ItemsControl ItemsSource="{Binding BindingIssues}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectBindingIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Margin="0,0,0,6"
                                                                Padding="8,7">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding MissingFieldsSummary}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding ErrorsSummary}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding IsToolboxVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Grid Grid.Column="2" Background="{StaticResource AppWorkspaceBrush}" Margin="0,12,0,0"
                  AutomationProperties.AutomationId="Shell.Canvas"
                  AutomationProperties.Name="Design surface">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,1">
                    <TextBlock Text="mm" FontSize="11" Foreground="{StaticResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <ScrollViewer x:Name="HorizontalRulerScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <Grid Margin="92,0,120,0" HorizontalAlignment="Left">
                            <controls:DesignerRuler LengthMm="{Binding Template.WidthMm}" Zoom="{Binding Zoom}" Orientation="Horizontal"
                                                    Width="{Binding ElementName=DesignerCanvas, Path=ActualWidth}" Height="26"
                                                    GuideDragStarted="Ruler_GuideDragStarted"
                                                    GuideDragging="Ruler_GuideDragging"
                                                    GuideDragCompleted="Ruler_GuideDragCompleted"
                                                    GuideDragCanceled="Ruler_GuideDragCanceled"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer x:Name="VerticalRulerScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  Focusable="False">
                        <Grid Margin="0,72,0,100" VerticalAlignment="Top">
                            <controls:DesignerRuler LengthMm="{Binding Template.HeightMm}" Zoom="{Binding Zoom}" Orientation="Vertical"
                                                    Width="38" Height="{Binding ElementName=DesignerCanvas, Path=ActualHeight}"
                                                    GuideDragStarted="Ruler_GuideDragStarted"
                                                    GuideDragging="Ruler_GuideDragging"
                                                    GuideDragCompleted="Ruler_GuideDragCompleted"
                                                    GuideDragCanceled="Ruler_GuideDragCanceled"/>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <ScrollViewer x:Name="DesignerScrollViewer"
                              Grid.Row="1" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="DesignerScrollViewer_ScrollChanged"
                              PreviewMouseWheel="DesignerScrollViewer_PreviewMouseWheel"
                              Background="{StaticResource AppWorkspaceBrush}">
                    <Grid Margin="92,72,120,100">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <controls:LabelDesignerCanvas x:Name="DesignerCanvas"
                                                          Template="{Binding Template}"
                                                          SelectedObject="{Binding SelectedObject, Mode=TwoWay}"
                                                          PreviewRow="{Binding PreviewRow}"
                                                          DrawingTool="{Binding DrawingTool, Mode=TwoWay}"
                                                          DrawingCommandText="{Binding DrawingCommandText, Mode=TwoWay}"
                                                          InteractionStatusText="{Binding StatusText, Mode=TwoWay}"
                                                          SizeChanged="DesignerCanvas_SizeChanged"
                                                          Zoom="{Binding Zoom}"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding IsPropertiesVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Border Grid.Column="4" Margin="0,12,12,12" Style="{StaticResource PanelCard}" Visibility="{Binding IsPropertiesVisible, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="Shell.Properties"
                    AutomationProperties.Name="Object Properties">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Height="42" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Object Properties" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#EAF3FF" BorderBrush="#9BC4F5" BorderThickness="1" VerticalAlignment="Center"
                                        ToolTip="NiceLabel pins Object Properties with F4; ANLAbel keeps this docked panel always available.">
                                    <TextBlock Text="docked" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                </Border>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelHeaderButton}" Command="{Binding HidePropertiesCommand}" ToolTip="Hide properties">
                                <Image Style="{StaticResource SmallIconImage}" Source="Icons/collapse_chevron.png"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel VerticalAlignment="Top" Margin="12">
                                <Border Background="#EAF3FF" BorderBrush="#9BC4F5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="5" Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Top">
                                            <Image Source="Icons/cursor_select.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="No object selected" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="Select an object to edit position, content and style." FontSize="10.5" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Image Source="Icons/folder.png" Width="18" Height="18" Margin="0,0,7,0"/>
                                            <TextBlock Text="Document" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                        </StackPanel>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Label size" Foreground="{StaticResource AppMutedBrush}"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold">
                                                <Run Text="{Binding Template.WidthMm, StringFormat={}{0:0.##}}"/><Run Text=" × "/><Run Text="{Binding Template.HeightMm, StringFormat={}{0:0.##}}"/><Run Text=" mm"/>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Margin="0,5,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Printer" Foreground="{StaticResource AppMutedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PrinterDisplayName}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#B45309" TextTrimming="CharacterEllipsis" MaxWidth="142"/>
                                        </Grid>
                                        <Grid Margin="0,5,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Data" Foreground="{StaticResource AppMutedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LinkedExcelSourceText}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" TextTrimming="CharacterEllipsis" MaxWidth="142"/>
                                        </Grid>
                                        <Button Click="PrinterSetup_Click" HorizontalAlignment="Stretch" Padding="8,6" Background="#EAF3FF" BorderBrush="#5B8DD4" Foreground="{StaticResource AppBlueDarkBrush}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Image Source="Icons/printer_setup.png" Width="16" Height="16" Margin="0,0,7,0"/>
                                                <TextBlock Text="Label &amp; printer setup" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="7,7,7,4">
                                <StackPanel.Resources>
                                    <!-- Compact controls scoped to the Properties panel only -->
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="MinHeight" Value="28"/>
                                        <Setter Property="Margin" Value="0,2,0,4"/>
                                    </Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="MinHeight" Value="28"/>
                                        <Setter Property="Margin" Value="0,2,0,4"/>
                                    </Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </Style>
                                </StackPanel.Resources>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Border Background="#EAF3FF" BorderBrush="#9BC4F5" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="4" Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Top">
                                            <Image Source="{Binding SelectedObjectIconPath}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding SelectedObjectTypeText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="{Binding SelectedObjectSummaryText}" FontSize="10.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TabControl x:Name="PropertiesModeTabs"
                                            SelectedIndex="0"
                                            Height="38"
                                            Margin="0,0,0,6"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            AutomationProperties.Name="Properties sections">
                                    <TabItem AutomationProperties.Name="Label and text properties">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="Icons/static_text.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="Label"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem AutomationProperties.Name="Layout properties">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="Icons/panels.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="Layout"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem AutomationProperties.Name="Advanced object properties">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="Icons/settings.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="Advanced"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                </TabControl>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=PropertiesModeTabs}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <Border Style="{StaticResource PropCard}" Background="#F8FAFC">
                                    <Expander IsExpanded="True" FontSize="11" Foreground="{StaticResource AppBlueDarkBrush}">
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock Text="Position &amp; size" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="10" Foreground="{StaticResource AppMutedBrush}" Margin="0,2,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:0.##}, {1:0.##} · {2:0.##} × {3:0.##} mm">
                                                            <Binding Path="SelectedObject.XMm"/>
                                                            <Binding Path="SelectedObject.YMm"/>
                                                            <Binding Path="SelectedObject.WidthMm"/>
                                                            <Binding Path="SelectedObject.HeightMm"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,6,0,0">
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Line}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="X" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.XMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Y" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.YMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Width" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.WidthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Height" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.HeightMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Line}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="X1" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.XMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Y1" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.YMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="X2" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.LineEndXMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Y2" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.LineEndYMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=PropertiesModeTabs}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <Border Style="{StaticResource PropCard}">
