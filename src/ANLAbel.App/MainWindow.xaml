                                        <TextBlock Text="{Binding BarcodeEffectiveModuleReadoutText}"
                                                   Foreground="{StaticResource AppMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   ToolTip="Effective module at the print-plan DPI (same quantize path as preflight). mil = mm/25.4×1000."/>
                                        <TextBlock Text="{Binding BarcodeApplicationValidationMessage}" Foreground="{StaticResource AppDangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <!-- Linked text & DPI: compact single row -->
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="2" Text="DPI" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                                            <TextBox Grid.Column="3" Text="{Binding SelectedObject.QrDpi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" MinHeight="22" FontSize="11"/>
                                        </Grid>
                                        <!-- Fixed Size: inline, only when not AutoSize -->
                                        <Border Margin="0,3,0,0" Padding="0" BorderThickness="0">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedObject.QrSizingMode}" Value="{x:Static barcode:QrSizingMode.AutoSizeByData}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="Fixed Size" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Version" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding QrVersionOptions}" SelectedValue="{Binding SelectedObject.QrFixedVersion, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="0,1,0,0" MaxDropDownHeight="320"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Module px" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding QrModuleSizePxOptions}" SelectedItem="{Binding SelectedObject.QrModuleSizePx, Mode=TwoWay}" Margin="0,1,0,0"/></StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding BarcodeModuleSizeWarningText}" Foreground="{StaticResource AppDangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PropCard}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Image}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Image" Style="{StaticResource PropTitle}"/>
                                        <Button Content="Choose image..." Command="{Binding ReplaceSelectedImageCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                        <TextBlock Text="Raster policy" Style="{StaticResource PropLabel}" Margin="0,4,0,1"/>
                                        <ComboBox ItemsSource="{Binding ImageRasterModes}"
                                                  SelectedItem="{Binding SelectedObject.ImageRasterMode, Mode=TwoWay}"
                                                  Margin="0,0,0,3"
                                                  ToolTip="DriverManaged keeps colour/alpha for the printer driver; monochrome modes use the same deterministic transform in the designer, preview and print."/>
                                        <TextBlock Text="Aspect ratio is preserved and the picture is centered inside its frame." FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
