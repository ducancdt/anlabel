                                                                    <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Failed}"><Setter Property="Text" Value="×"/><Setter Property="Foreground" Value="#B42318"/></DataTrigger>
