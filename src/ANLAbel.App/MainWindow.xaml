                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding ShowAllPanelsCommand}" AutomationProperties.Name="Panels restore" AutomationProperties.AutomationId="Shell.Ribbon.Panels">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/panels.png"/><TextBlock Text="Panels" Style="{StaticResource RibbonPrimaryCaption}"/><TextBlock Text="restore" Style="{StaticResource RibbonSecondaryCaption}"/></StackPanel>
                            </Button>
