<Window x:Class="ANLAbel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ANLAbel.App.Controls"
        xmlns:viewModels="clr-namespace:ANLAbel.App.ViewModels"
        xmlns:enums="clr-namespace:ANLAbel.Core.Enums;assembly=ANLAbel.Core"
        xmlns:converters="clr-namespace:ANLAbel.App.Converters"
        xmlns:barcode="clr-namespace:ANLAbel.Core.Barcode;assembly=ANLAbel.Core"
        Title="ANLAbel - Thiết kế tem v0.360"
        Icon="/ANLAbel.App;component/anlabel.ico"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        Background="#EEF2F6"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!-- NiceLabel 10 title bar: MainWindow.Chrome.cs sets the WindowChrome (caption 34 DIP, no system buttons) -->
    <Window.Resources>
        <ResourceDictionary>
        <!-- NiceLabel 10 shell styles and ANLAbel ribbon icons (Themes/Ribbon.xaml, Themes/RibbonIcons.xaml) -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/ANLAbel.App;component/Themes/Ribbon.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:EnumEqualsConverter x:Key="EnumEquals"/>
        <converters:DisplayNameConverter x:Key="DisplayName"/>
        <converters:ObjectTypeIconConverter x:Key="ObjectTypeIcon"/>
        <DataTemplate x:Key="DisplayNameItem"><TextBlock Text="{Binding Converter={StaticResource DisplayName}}"/></DataTemplate>
        <controls:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        <!-- The Data panel's lists, filtered by its search box on their own views (NiceLabel 10 Data explorer) -->
        <CollectionViewSource x:Key="DataTreePromptsSource" Source="{Binding Template.PromptVariables}" Filter="DataTreeSource_Filter"/>
        <CollectionViewSource x:Key="DataTreeFieldsSource" Source="{Binding ExcelHeaders}" Filter="DataTreeSource_Filter"/>
        <CollectionViewSource x:Key="DataTreeFunctionsSource" Source="{Binding Template.DataTransforms}" Filter="DataTreeSource_Filter"/>
        <CollectionViewSource x:Key="GroupedBarcodeSymbologies" Source="{Binding BarcodeSymbologyOptions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Color x:Key="ColorText">#1E293B</Color>
        <Color x:Key="ColorMuted">#5B6B80</Color>
        <Color x:Key="ColorLine">#D9E2EC</Color>
        <Color x:Key="ColorPanel">#FFFFFF</Color>
        <Color x:Key="ColorPanelAlt">#F8FAFC</Color>
        <Color x:Key="ColorWorkspace">#EEF2F6</Color>
        <Color x:Key="ColorBlue">#1464D2</Color>
        <Color x:Key="ColorBlueDark">#0F4EA8</Color>
        <Color x:Key="ColorBlueSoft">#EAF3FF</Color>
        <Color x:Key="ColorDanger">#EF4444</Color>

        <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource ColorText}"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource ColorMuted}"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource ColorLine}"/>
        <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource ColorPanel}"/>
        <SolidColorBrush x:Key="AppPanelAltBrush" Color="{StaticResource ColorPanelAlt}"/>
        <SolidColorBrush x:Key="AppWorkspaceBrush" Color="{StaticResource ColorWorkspace}"/>
        <SolidColorBrush x:Key="AppBlueBrush" Color="{StaticResource ColorBlue}"/>
        <SolidColorBrush x:Key="AppBlueDarkBrush" Color="{StaticResource ColorBlueDark}"/>
        <SolidColorBrush x:Key="AppBlueSoftBrush" Color="{StaticResource ColorBlueSoft}"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource ColorDanger}"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#334155"/>
        <DropShadowEffect x:Key="LabelShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#334155"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBlueSoftBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B7D7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconImage" TargetType="Image">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="SmallIconImage" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

<Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DFE8F2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="PanelHeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppBlueDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBlueSoftBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBlueDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0B3F86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExcelVerificationButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Checking}">
                    <Setter Property="Background" Value="#EAF4FF"/><Setter Property="BorderBrush" Value="#8CC5FF"/><Setter Property="Foreground" Value="#1267C4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Verified}">
                    <Setter Property="Background" Value="#ECFDF3"/><Setter Property="BorderBrush" Value="#86D8A2"/><Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Stale}">
                    <Setter Property="Background" Value="#FFF7E6"/><Setter Property="BorderBrush" Value="#F3C56B"/><Setter Property="Foreground" Value="#A15C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExcelLinkVerificationState}" Value="{x:Static viewModels:ExcelLinkVerificationState.Failed}">
                    <Setter Property="Background" Value="#FFF1F0"/><Setter Property="BorderBrush" Value="#F3A7A1"/><Setter Property="Foreground" Value="#B42318"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Properties panel: unified section card -->
        <Style x:Key="PropCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C7D2DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Properties panel: section title with colored accent bar -->
        <Style x:Key="PropTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AppBlueDarkBrush}"/>
            <Setter Property="Padding" Value="7,2,0,3"/>
            <Setter Property="Margin" Value="-7,-5,-7,5"/>
            <Setter Property="Background" Value="#EAF3FF"/>
        </Style>

        <!-- Properties panel: field caption (darker for readability) -->
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,3,0,1"/>
        </Style>

        <!-- Properties panel: compact chip button (formula builder, layer order) -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <Style x:Key="FontToolbarCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AlignIconRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FontStyleIcon" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#16304A"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DCEBFF"/>
                    <Setter Property="Foreground" Value="#1464D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EDF5"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F6"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- NiceLabel 10 ribbon tabs (docs/NICELABEL_10_UI_LAYOUT.md) -->
        <converters:RibbonTabConverter x:Key="RibbonTabConverter"/>
        <converters:IndexToVisibilityConverter x:Key="IndexToVisibility"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:EmptyTextConverter x:Key="EmptyText"/>
        <Style x:Key="RibbonIconRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RadioRoot" Background="#FFFFFF" BorderBrush="#E5EAF1" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioRoot" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioRoot" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="RadioRoot" Property="BorderBrush" Value="#1464D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TextSizingItem">
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Xuống dòng, giữ cỡ phông"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:TextSizingMode.ShrinkFont}"><Setter Property="Text" Value="Đổi cỡ phông cho vừa khung"/></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:TextSizingMode.ScaleWidth}"><Setter Property="Text" Value="Co giãn chiều ngang chữ cho vừa"/></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:TextSizingMode.AdjustHeight}"><Setter Property="Text" Value="Giữ chiều rộng, chiều cao theo nội dung"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!-- Flat category tabs of the Properties panel (NiceLabel 10 Source / Style / Position / General) -->
        <Style x:Key="PanelTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#1464D2"/>
                                <Setter Property="Foreground" Value="#0B4A8B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The barcode pages: four headers on one row of the Properties panel. -->
        <Style x:Key="PanelTabItemCompact" TargetType="TabItem" BasedOn="{StaticResource PanelTabItem}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <!-- Backstage "Tệp gần đây" row: file name over its folder (NiceLabel 10 Recent Files) -->
        <DataTemplate x:Key="BackstageRecentItem">
            <Button Style="{StaticResource BackstageListButton}" Click="BackstageRecent_Click" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource RibbonCaptionBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Không tìm thấy tệp ở đường dẫn này" FontSize="11" Foreground="#B91C1C"
                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <!-- NiceLabel 10 contextual Arrange group, repeated on each object tab (no AutomationIds: the Design tab owns them) -->
        <DataTemplate x:Key="RibbonArrangeGroup">
            <controls:RibbonGroupPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:RibbonSplitButton controls:Ribbon.Icon="{StaticResource Icon.BringForward32}" Content="Đưa&#10;lên ▾" Command="{Binding BringForwardCommand}"
                                                ToolTip="Đưa đối tượng lên một lớp, PgUp (▾: lên trên cùng, Ctrl+PgUp)" AutomationProperties.Name="Bring forward">
                        <controls:RibbonSplitButton.DropDown>
                            <ContextMenu>
                                <MenuItem Header="Lên trên cùng" Command="{Binding BringToFrontCommand}" InputGestureText="Ctrl+PgUp"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.BringToFront16}"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Lên một lớp" Command="{Binding BringForwardCommand}" InputGestureText="PgUp"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.BringForward16}"/></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </controls:RibbonSplitButton.DropDown>
                    </controls:RibbonSplitButton>
                    <controls:RibbonSplitButton controls:Ribbon.Icon="{StaticResource Icon.SendBackward32}" Content="Đưa&#10;xuống ▾" Command="{Binding SendBackwardCommand}"
                                                ToolTip="Đưa đối tượng xuống một lớp, PgDn (▾: xuống dưới cùng, Ctrl+PgDn)" AutomationProperties.Name="Send backward">
                        <controls:RibbonSplitButton.DropDown>
                            <ContextMenu>
                                <MenuItem Header="Xuống một lớp" Command="{Binding SendBackwardCommand}" InputGestureText="PgDn"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.SendBackward16}"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Xuống dưới cùng" Command="{Binding SendToBackCommand}" InputGestureText="Ctrl+PgDn"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.SendToBack16}"/></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </controls:RibbonSplitButton.DropDown>
                    </controls:RibbonSplitButton>
                    <StackPanel Style="{StaticResource RibbonColumn}">
                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Group16}" Content="Nhóm đối tượng" Click="GroupObjects_Click"
                                ToolTip="Nhóm các đối tượng đang chọn: chọn và di chuyển cùng nhau (Ctrl+G)" AutomationProperties.Name="Group objects"/>
                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Ungroup16}" Content="Bỏ nhóm" Click="UngroupObjects_Click"
                                ToolTip="Bỏ nhóm các đối tượng đang chọn (Ctrl+Shift+G)" AutomationProperties.Name="Ungroup objects"/>
                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Align16}" Content="Căn chỉnh ▾"
                                ToolTip="Căn và phân bố các đối tượng đang chọn" AutomationProperties.Name="Align objects">
                            <controls:Ribbon.DropDown>
                                <ContextMenu>
                                    <MenuItem Header="Căn trái" Tag="Left" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignLeft16}"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Căn giữa theo chiều ngang" Tag="HorizontalCenter" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignCenterH16}"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Căn phải" Tag="Right" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignRight16}"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Căn trên" Tag="Top" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignTop16}"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Căn giữa theo chiều dọc" Tag="VerticalCenter" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignCenterV16}"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Căn dưới" Tag="Bottom" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignBottom16}"/></MenuItem.Icon></MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Phân bố đều theo chiều ngang" Tag="HorizontalGaps" Click="ArrangeDistribute_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.DistributeH16}"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Phân bố đều theo chiều dọc" Tag="VerticalGaps" Click="ArrangeDistribute_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.DistributeV16}"/></MenuItem.Icon></MenuItem>
                                </ContextMenu>
                            </controls:Ribbon.DropDown>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Sắp xếp"/>
            </controls:RibbonGroupPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Shell regions map: docs/NICELABEL_DESIGNER_SHELL_RESEARCH.md. NiceLabel 10 shell (docs/NICELABEL_10_UI_LAYOUT.md,
             "Shell rebuild"): quick access in the navy title bar, File + tabs on the same navy, grey ribbon body. -->
        <!-- Tab order follows the screen: title bar, ribbon, workspace, then the status bar (declared earlier for docking) -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="34" Background="{StaticResource RibbonChromeBrush}"
                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Width="16" Height="16" Margin="10,0,6,0" Source="/ANLAbel.App;component/anlabel.ico"
                       RenderOptions.BitmapScalingMode="HighQuality" WindowChrome.IsHitTestVisibleInChrome="True"
                       MouseLeftButtonDown="AppIcon_MouseLeftButtonDown" ToolTip="Menu cửa sổ (Alt + phím cách)"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Shell.QuickAccess" AutomationProperties.Name="Quick access">
                    <Button Style="{StaticResource QuickAccessButton}" Click="New_Click" ToolTip="Tạo tem mới (Ctrl+N)" AutomationProperties.Name="New label" AutomationProperties.AutomationId="Shell.QuickAccess.New">
                        <TextBlock Style="{StaticResource ChromeGlyph}" Text="&#xE8A5;"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessButton}" Click="OpenBackstage_Click" ToolTip="Mở tem (Ctrl+O)" AutomationProperties.Name="Open label" AutomationProperties.AutomationId="Shell.QuickAccess.Open">
                        <TextBlock Style="{StaticResource ChromeGlyph}" Text="&#xE838;"/>
                    </Button>
                    <Border Width="1" Height="16" Margin="3,0" Background="#3B4BA0"/>
                    <Button Style="{StaticResource QuickAccessButton}" Click="Save_Click" ToolTip="Lưu tem (Ctrl+S)" AutomationProperties.Name="Save label" AutomationProperties.AutomationId="Shell.QuickAccess.Save">
                        <TextBlock Style="{StaticResource ChromeGlyph}" Text="&#xE74E;"/>
                    </Button>
                    <Border Width="1" Height="16" Margin="3,0" Background="#3B4BA0"/>
                    <Button x:Name="UndoButton" Style="{StaticResource QuickAccessButton}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" AutomationProperties.Name="Undo" AutomationProperties.AutomationId="Shell.QuickAccess.Undo">
                        <TextBlock Style="{StaticResource ChromeGlyph}" Text="&#xE7A7;"/>
                    </Button>
                    <!-- NiceLabel's Undo ▾: the named steps, to take back several at once -->
                    <Button Style="{StaticResource QuickAccessDropDownButton}" Tag="Undo" Click="HistoryList_Click" IsEnabled="{Binding IsEnabled, ElementName=UndoButton}"
                            ToolTip="Danh sách thao tác: hoàn tác nhiều bước một lần" AutomationProperties.Name="Undo list" AutomationProperties.AutomationId="Shell.QuickAccess.UndoList"/>
                    <Button x:Name="RedoButton" Style="{StaticResource QuickAccessButton}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" AutomationProperties.Name="Redo" AutomationProperties.AutomationId="Shell.QuickAccess.Redo">
                        <TextBlock Style="{StaticResource ChromeGlyph}" Text="&#xE7A6;"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessDropDownButton}" Tag="Redo" Click="HistoryList_Click" IsEnabled="{Binding IsEnabled, ElementName=RedoButton}"
                            ToolTip="Danh sách thao tác: làm lại nhiều bước một lần" AutomationProperties.Name="Redo list" AutomationProperties.AutomationId="Shell.QuickAccess.RedoList"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Grid.ColumnSpan="4" Margin="240,0,240,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                    <Setter Property="Foreground" Value="#AEB6DC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click" ToolTip="Thu nhỏ" AutomationProperties.Name="Minimize" AutomationProperties.AutomationId="Shell.Window.Minimize">
                        <TextBlock Style="{StaticResource ChromeGlyph}" FontSize="10" Text="&#xE921;"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeRestoreWindow_Click" ToolTip="Phóng to" AutomationProperties.Name="Maximize" AutomationProperties.AutomationId="Shell.Window.Maximize">
                        <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource ChromeGlyph}" FontSize="10" Text="&#xE922;"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="CloseWindow_Click" ToolTip="Đóng" AutomationProperties.Name="Close" AutomationProperties.AutomationId="Shell.Window.Close">
                        <TextBlock Style="{StaticResource ChromeGlyph}" FontSize="10" Text="&#xE8BB;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Everything under the title bar; the backstage (Tệp) covers it -->
        <Grid x:Name="ShellBody">
        <DockPanel LastChildFill="True">
        <Border x:Name="RibbonBar" DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2"
                Background="{StaticResource RibbonBodyBrush}" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="0,0,0,1"
                AutomationProperties.AutomationId="Shell.Ribbon"
                AutomationProperties.Name="Ribbon" TextOptions.TextFormattingMode="Ideal">
            <Border.Resources>
                <Style TargetType="ComboBox" BasedOn="{StaticResource RibbonComboBox}"/>
                <Style TargetType="TextBox" BasedOn="{StaticResource RibbonTextBox}"/>
                <Style TargetType="CheckBox" BasedOn="{StaticResource RibbonCheckBox}"/>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=FrameworkElement}}"/>
                </Style>
            </Border.Resources>
            <DockPanel>
                <!-- Tab row: Tệp | Trang chủ | Dữ liệu | Xem | Trợ giúp | contextual tabs (NiceLabel 10 order) -->
                <Border DockPanel.Dock="Top" Background="{StaticResource RibbonChromeBrush}" Padding="2,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FileMenuButton" Style="{StaticResource RibbonFileTab}" Content="Tệp" Click="FileMenu_Click"
                                AutomationProperties.Name="File" AutomationProperties.AutomationId="Shell.Ribbon.File"
                                ToolTip="Tệp: bắt đầu, mới, mở, lưu, in, phiên bản, tùy chọn và giới thiệu"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="Trang chủ" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Home"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Home}"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="Dữ liệu" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Data"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Data}"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="Xem" AutomationProperties.AutomationId="Shell.Ribbon.Tab.View"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=View}"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="Trợ giúp" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Help"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Help}"/>
                        <RadioButton Style="{StaticResource RibbonContextTab}" Content="Thiết kế" Margin="10,2,1,0" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Design"
                                     Visibility="{Binding HasSelectedObject, Converter={StaticResource BoolToVisibility}}"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Design}"/>
                        <RadioButton Style="{StaticResource RibbonContextTab}" Content="Chữ" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Text"
                                     Visibility="{Binding IsTextObjectSelected, Converter={StaticResource BoolToVisibility}}"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Text}"/>
                        <RadioButton Style="{StaticResource RibbonContextTab}" Content="Mã vạch" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Barcode"
                                     Visibility="{Binding IsBarcodeObjectSelected, Converter={StaticResource BoolToVisibility}}"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Barcode}"/>
                        <RadioButton Style="{StaticResource RibbonContextTab}" Content="Hình ảnh" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Picture"
                                     Visibility="{Binding IsImageObjectSelected, Converter={StaticResource BoolToVisibility}}"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Picture}"/>
                        <RadioButton Style="{StaticResource RibbonContextTab}" Content="Hình dạng" AutomationProperties.AutomationId="Shell.Ribbon.Tab.Shape"
                                     Visibility="{Binding IsShapeObjectSelected, Converter={StaticResource BoolToVisibility}}"
                                     IsChecked="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Shape}"/>
                    </StackPanel>
                </Border>

                <Grid Height="92">
                    <!-- Trang chủ: Bộ nhớ tạm · Phông chữ · Thao tác · Quản lý · Căn chỉnh · Đối tượng -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Home}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel IsEnabled="{Binding IsEditingAllowed}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Paste32}" Content="Dán" Click="Paste_Click"
                                            ToolTip="Dán (Ctrl+V)" AutomationProperties.Name="Paste" AutomationProperties.AutomationId="Shell.Ribbon.Paste"/>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Cut16}" Content="Cắt" Click="Cut_Click"
                                                IsEnabled="{Binding HasSelectedObject}" ToolTip="Cắt (Ctrl+X)" AutomationProperties.Name="Cut" AutomationProperties.AutomationId="Shell.Ribbon.Cut"/>
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Copy16}" Content="Sao chép" Click="Copy_Click"
                                                IsEnabled="{Binding HasSelectedObject}" ToolTip="Sao chép (Ctrl+C)" AutomationProperties.Name="Copy" AutomationProperties.AutomationId="Shell.Ribbon.Copy"/>
                                        <ToggleButton x:Name="FormatPainterToggle" Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.FormatPainter16}" Content="Sao định dạng"
                                                      Checked="FormatPainter_Checked" IsEnabled="{Binding HasSelectedObject}"
                                                      ToolTip="Sao định dạng: chọn đối tượng mẫu, bấm nút này rồi bấm đối tượng cần áp kiểu (Ctrl+Shift+C / Ctrl+Shift+V)"
                                                      AutomationProperties.Name="Format painter" AutomationProperties.AutomationId="Shell.Ribbon.FormatPainter"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Bộ nhớ tạm"/>
                            </controls:RibbonGroupPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel IsEnabled="{Binding IsTextObjectEditable}" AutomationProperties.AutomationId="Shell.Ribbon.Font">
                                <controls:RibbonGroupPanel.Style>
                                    <Style TargetType="controls:RibbonGroupPanel" BasedOn="{StaticResource {x:Type controls:RibbonGroupPanel}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRichTextObjectSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:RibbonGroupPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <ComboBox Width="150" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding RibbonFontFamily, Mode=TwoWay}"
                                              IsTextSearchEnabled="True" AutomationProperties.Name="Ribbon font family" ToolTip="Phông chữ">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Width="52" Margin="3,0,2,0" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding RibbonFontSize, Mode=TwoWay}"
                                              AutomationProperties.Name="Ribbon font size" ToolTip="Cỡ chữ (pt)"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.GrowFont16}" Click="FontGrow_Click" ToolTip="Tăng cỡ chữ" AutomationProperties.Name="Grow font"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.ShrinkFont16}" Click="FontShrink_Click" ToolTip="Giảm cỡ chữ" AutomationProperties.Name="Shrink font"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Bold, Mode=TwoWay}" ToolTip="Đậm (Ctrl+B)" AutomationProperties.Name="Ribbon bold">
                                        <TextBlock Text="B" FontWeight="Bold"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Italic, Mode=TwoWay}" ToolTip="Nghiêng (Ctrl+I)" AutomationProperties.Name="Ribbon italic">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Underline, Mode=TwoWay}" ToolTip="Gạch chân (Ctrl+U)" AutomationProperties.Name="Ribbon underline">
                                        <TextBlock Text="U" TextDecorations="Underline"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Strikethrough, Mode=TwoWay}" ToolTip="Gạch ngang" AutomationProperties.Name="Strikethrough">
                                        <TextBlock Text="S" TextDecorations="Strikethrough"/>
                                    </ToggleButton>
                                    <Border Width="6"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignLeft16}" GroupName="RibbonTextAlign" ToolTip="Căn trái" AutomationProperties.Name="Ribbon align left"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Left}}"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignCenter16}" GroupName="RibbonTextAlign" ToolTip="Căn giữa" AutomationProperties.Name="Ribbon align center"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Center}}"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignRight16}" GroupName="RibbonTextAlign" ToolTip="Căn phải" AutomationProperties.Name="Ribbon align right"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Right}}"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextJustify16}" GroupName="RibbonTextAlign" ToolTip="Căn đều hai bên" AutomationProperties.Name="Ribbon justify"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Justify}}"/>
                                    <Border Width="6"/>
                                    <ComboBox Width="44" ItemsSource="{Binding TextColorOptions}" SelectedItem="{Binding SelectedObject.Style.StrokeColor, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource RibbonTextColorItem}" ToolTip="Màu chữ" AutomationProperties.Name="Text colour"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Phông chữ"/>
                            </controls:RibbonGroupPanel>
                            <!-- NiceLabel 10: with a Rich Text Box selected the Font group formats its RTF content -
                                 the text selected in the Properties editor, or all of it when nothing is selected. -->
                            <controls:RibbonGroupPanel IsEnabled="{Binding IsEditingAllowed}" Visibility="{Binding IsRichTextObjectSelected, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="Shell.Ribbon.RichFont">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <ComboBox x:Name="RichFontFamilyBox" Width="150" ItemsSource="{Binding FontFamilies}" SelectionChanged="RichFontFamily_Changed"
                                              IsTextSearchEnabled="True" AutomationProperties.Name="Rich text font family" ToolTip="Phông chữ của Chữ định dạng">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox x:Name="RichFontSizeBox" Width="52" Margin="3,0,2,0" ItemsSource="{Binding FontSizes}" SelectionChanged="RichFontSize_Changed"
                                              AutomationProperties.Name="Rich text font size" ToolTip="Cỡ chữ (pt)"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.GrowFont16}" Click="RichFormat_Click" Tag="Grow" ToolTip="Tăng cỡ chữ" AutomationProperties.Name="Rich text grow font"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.ShrinkFont16}" Click="RichFormat_Click" Tag="Shrink" ToolTip="Giảm cỡ chữ" AutomationProperties.Name="Rich text shrink font"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource RibbonIconButton}" Click="RichFormat_Click" Tag="Bold" ToolTip="Đậm" AutomationProperties.Name="Rich text bold"><TextBlock Text="B" FontWeight="Bold"/></Button>
                                    <Button Style="{StaticResource RibbonIconButton}" Click="RichFormat_Click" Tag="Italic" ToolTip="Nghiêng" AutomationProperties.Name="Rich text italic"><TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/></Button>
                                    <Button Style="{StaticResource RibbonIconButton}" Click="RichFormat_Click" Tag="Underline" ToolTip="Gạch chân" AutomationProperties.Name="Rich text underline"><TextBlock Text="U" TextDecorations="Underline"/></Button>
                                    <Button Style="{StaticResource RibbonIconButton}" Click="RichFormat_Click" Tag="Strikethrough" ToolTip="Gạch ngang" AutomationProperties.Name="Rich text strikethrough"><TextBlock Text="S" TextDecorations="Strikethrough"/></Button>
                                    <Border Width="6"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignLeft16}" Click="RichFormat_Click" Tag="Left" ToolTip="Căn trái" AutomationProperties.Name="Rich text align left"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignCenter16}" Click="RichFormat_Click" Tag="Center" ToolTip="Căn giữa" AutomationProperties.Name="Rich text align center"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignRight16}" Click="RichFormat_Click" Tag="Right" ToolTip="Căn phải" AutomationProperties.Name="Rich text align right"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextJustify16}" Click="RichFormat_Click" Tag="Justify" ToolTip="Căn đều hai bên" AutomationProperties.Name="Rich text justify"/>
                                    <Border Width="6"/>
                                    <ComboBox x:Name="RichColorBox" Width="44" ItemsSource="{Binding TextColorOptions}" SelectionChanged="RichColor_Changed"
                                              ItemTemplate="{StaticResource RibbonTextColorItem}" ToolTip="Màu chữ" AutomationProperties.Name="Rich text colour"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Phông chữ"/>
                            </controls:RibbonGroupPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Print32}" Content="In" Click="PrintPreview_Click"
                                            ToolTip="In: xem trước, chọn dòng và số bản, kiểm tra rồi in (Ctrl+P)" AutomationProperties.Name="Print" AutomationProperties.AutomationId="Shell.Ribbon.Preview"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.PrintOptions32}" Content="Tùy chỉnh&#10;in ▾"
                                            ToolTip="In nhanh dòng hiện tại hoặc mọi dòng, in thử, lịch sử in" AutomationProperties.Name="Customize print" AutomationProperties.AutomationId="Shell.Ribbon.PrintMore">
                                        <controls:Ribbon.DropDown>
                                            <ContextMenu>
                                                <MenuItem Header="In dòng hiện tại" Click="PrintCurrent_Click" AutomationProperties.AutomationId="Shell.Ribbon.PrintCurrent"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.PrintCurrent16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="In mọi dòng" Click="PrintAllRows_Click" AutomationProperties.AutomationId="Shell.Ribbon.PrintAllRows"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.PrintAll16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="In thử (tem hiệu chỉnh)" Command="{Binding PrintCalibrationCommand}" AutomationProperties.AutomationId="Shell.Ribbon.TestPrint"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.TestPrint16}"/></MenuItem.Icon></MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Lịch sử in…" Click="PrintHistory_Click" AutomationProperties.AutomationId="Shell.Ribbon.PrintHistory"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.PrintHistory16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Xuất lịch sử in ra Excel…" Click="ExportPrintHistory_Click" AutomationProperties.AutomationId="Shell.Ribbon.ExportExcel"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.ExportExcel16}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </controls:Ribbon.DropDown>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Thao tác"/>
                            </controls:RibbonGroupPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <controls:RibbonSplitButton controls:Ribbon.Icon="{StaticResource Icon.DataManager32}" Content="Quản lý&#10;dữ liệu ▾" Click="DataSources_Click"
                                                                ToolTip="Quản lý dữ liệu: biến nhập khi in, hàm, bộ đếm và cơ sở dữ liệu của tem (▾: mở thẳng một mục)"
                                                                AutomationProperties.Name="Data manager" AutomationProperties.AutomationId="Shell.Ribbon.DataSources">
                                        <controls:RibbonSplitButton.DropDown>
                                            <ContextMenu>
                                                <MenuItem Header="Biến nhập khi in…" Tag="Prompts" Click="DataManagerPage_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.Variable16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Hàm…" Tag="Functions" Click="DataManagerPage_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.Function16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Bộ đếm Serial…" Tag="Counter" Click="DataManagerPage_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.Counter16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Cơ sở dữ liệu…" Tag="Database" Click="DataManagerPage_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.Database16}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </controls:RibbonSplitButton.DropDown>
                                    </controls:RibbonSplitButton>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.DocumentProperties32}" Content="Thuộc tính&#10;tem" Click="PrinterSetup_Click"
                                            ToolTip="Thuộc tính tem: máy in, kích thước tem, giấy và vật liệu" AutomationProperties.Name="Document properties" AutomationProperties.AutomationId="Shell.Ribbon.PrinterSetup"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Quản lý"/>
                            </controls:RibbonGroupPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel AutomationProperties.AutomationId="Shell.Ribbon.Align" IsEnabled="{Binding IsEditingAllowed}">
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0" IsEnabled="{Binding HasSelectedObject}">
                                    <StackPanel>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.AlignLeft16}" Tag="Left" Click="ArrangeAlign_Click" ToolTip="Căn trái" AutomationProperties.Name="Align left objects"/>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.AlignTop16}" Tag="Top" Click="ArrangeAlign_Click" ToolTip="Căn trên" AutomationProperties.Name="Align top objects"/>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.DistributeH16}" Tag="HorizontalGaps" Click="ArrangeDistribute_Click" ToolTip="Phân bố đều theo chiều ngang" AutomationProperties.Name="Distribute horizontally"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.AlignCenterH16}" Tag="HorizontalCenter" Click="ArrangeAlign_Click" ToolTip="Căn giữa theo chiều ngang" AutomationProperties.Name="Center objects horizontally"/>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.AlignCenterV16}" Tag="VerticalCenter" Click="ArrangeAlign_Click" ToolTip="Căn giữa theo chiều dọc" AutomationProperties.Name="Center objects vertically"/>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.DistributeV16}" Tag="VerticalGaps" Click="ArrangeDistribute_Click" ToolTip="Phân bố đều theo chiều dọc" AutomationProperties.Name="Distribute vertically"/>
                                    </StackPanel>
                                    <Border Width="1" Margin="3,2" Background="{StaticResource RibbonLineBrush}"/>
                                    <StackPanel>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.AlignRight16}" Tag="Right" Click="ArrangeAlign_Click" ToolTip="Căn phải" AutomationProperties.Name="Align right objects"/>
                                        <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.AlignBottom16}" Tag="Bottom" Click="ArrangeAlign_Click" ToolTip="Căn dưới" AutomationProperties.Name="Align bottom objects"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Căn chỉnh"/>
                            </controls:RibbonGroupPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel IsEnabled="{Binding IsEditingAllowed}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.GroupObjects32}" Content="Nhóm&#10;đối tượng ▾"
                                            IsEnabled="{Binding HasSelectedObject}" ToolTip="Nhóm hoặc bỏ nhóm các đối tượng đang chọn" AutomationProperties.Name="Group objects" AutomationProperties.AutomationId="Shell.Ribbon.GroupMenu">
                                        <controls:Ribbon.DropDown>
                                            <ContextMenu>
                                                <MenuItem Header="Nhóm" Click="GroupObjects_Click" InputGestureText="Ctrl+G" ToolTip="Nhóm các đối tượng đang chọn: chọn và di chuyển cùng nhau (Ctrl+G)"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.Group16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Bỏ nhóm" Click="UngroupObjects_Click" InputGestureText="Ctrl+Shift+G"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.Ungroup16}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </controls:Ribbon.DropDown>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Arrange32}" Content="Sắp xếp&#10;▾"
                                            IsEnabled="{Binding HasSelectedObject}" ToolTip="Đưa đối tượng lên trên hoặc xuống dưới các đối tượng khác" AutomationProperties.Name="Arrange" AutomationProperties.AutomationId="Shell.Ribbon.Arrange">
                                        <controls:Ribbon.DropDown>
                                            <ContextMenu>
                                                <MenuItem Header="Lên trên cùng" Command="{Binding BringToFrontCommand}" InputGestureText="Ctrl+PgUp"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.BringToFront16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Lên một lớp" Command="{Binding BringForwardCommand}" InputGestureText="PgUp" AutomationProperties.AutomationId="Shell.Ribbon.BringForward"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.BringForward16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Xuống một lớp" Command="{Binding SendBackwardCommand}" InputGestureText="PgDn" AutomationProperties.AutomationId="Shell.Ribbon.SendBackward"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.SendBackward16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Xuống dưới cùng" Command="{Binding SendToBackCommand}" InputGestureText="Ctrl+PgDn"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.SendToBack16}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </controls:Ribbon.DropDown>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Delete32}" Content="Xóa"
                                            Command="controls:LabelDesignerCanvas.DeleteSelectionCommand" CommandTarget="{Binding ElementName=DesignerCanvas}"
                                            ToolTip="Xóa các đối tượng đang chọn (phím Del)" AutomationProperties.Name="Delete Selection" AutomationProperties.AutomationId="Shell.Ribbon.DeleteSelection"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Đối tượng"/>
                            </controls:RibbonGroupPanel>
                        </StackPanel>
                    </Viewbox>

                    <!-- Dữ liệu: Cơ sở dữ liệu (NiceLabel's database wizard) · Quản lý nguồn dữ liệu -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Data}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Excel32}" Content="Excel" Click="ImportExcel_Click"
                                            ToolTip="Liên kết sổ làm việc Excel (.xlsx, .xlsm) làm cơ sở dữ liệu của tem" AutomationProperties.Name="Import Excel" AutomationProperties.AutomationId="Shell.Ribbon.ImportExcel"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.TextFile32}" Content="Tệp&#10;văn bản" Click="ImportTextFile_Click"
                                            ToolTip="Liên kết tệp văn bản CSV làm cơ sở dữ liệu của tem" AutomationProperties.Name="Import text file" AutomationProperties.AutomationId="Shell.Ribbon.ImportTextFile"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.EditDatabase32}" Content="Sửa cơ sở&#10;dữ liệu" Click="EditDatabase_Click"
                                            IsEnabled="{Binding HasLinkedExcelSource}" ToolTip="Đổi tệp, trang tính và các trường dùng trên tem của cơ sở dữ liệu đã liên kết"
                                            AutomationProperties.Name="Edit database" AutomationProperties.AutomationId="Shell.Ribbon.EditDatabase"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.RefreshDatabase32}" Content="Nạp lại&#10;dữ liệu" Command="{Binding RefreshExcelDataCommand}"
                                            ToolTip="Đọc lại tệp dữ liệu đã liên kết sau khi tệp được sửa" AutomationProperties.Name="Update Excel" AutomationProperties.AutomationId="Shell.Ribbon.UpdateExcel"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.DeleteDatabase32}" Content="Xóa cơ sở&#10;dữ liệu" Click="UnlinkExcel_Click"
                                            IsEnabled="{Binding HasLinkedExcelSource}" ToolTip="Bỏ liên kết cơ sở dữ liệu khỏi tem; đối tượng vẫn giữ trường đã gắn"
                                            AutomationProperties.Name="Delete database" AutomationProperties.AutomationId="Shell.Ribbon.DeleteDatabase"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Cơ sở dữ liệu"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.DataManager32}" Content="Quản lý&#10;dữ liệu" Click="DataSources_Click"
                                            ToolTip="Quản lý dữ liệu: biến nhập khi in, trường cơ sở dữ liệu, bộ đếm và hàm của tem" AutomationProperties.Name="Data source manager" AutomationProperties.AutomationId="Shell.Ribbon.DataManager"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.ImportDataSources32}" Content="Nhập nguồn&#10;dữ liệu" Click="ImportDataSources_Click"
                                            ToolTip="Lấy biến nhập khi in và hàm từ một tem khác (ANLAbel hoặc NiceLabel)" AutomationProperties.Name="Import data sources" AutomationProperties.AutomationId="Shell.Ribbon.ImportDataSources"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.PromptOrder32}" Content="Thứ tự&#10;nhắc" Click="PromptOrder_Click"
                                            ToolTip="Thứ tự các câu hỏi hiện ra khi in" AutomationProperties.Name="Prompt order" AutomationProperties.AutomationId="Shell.Ribbon.PromptOrder"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.SharedSources32}" Content="Nguồn&#10;dùng chung" Click="SharedDataSources_Click"
                                            ToolTip="Nguồn Excel dùng chung giữa các mẫu tem: thêm, kiểm tra, liên kết lại, dọn dẹp" AutomationProperties.Name="Shared data sources" AutomationProperties.AutomationId="Shell.Ribbon.SharedDataSources"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Quản lý nguồn dữ liệu"/>
                            </controls:RibbonGroupPanel>
                        </StackPanel>
                    </Viewbox>

                    <!-- Xem: Thu phóng · Hiện dấu đối tượng · Căn và lưới · Xoay · Bảng -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=View}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.ZoomToDocument32}" Content="Vừa&#10;tài liệu" Click="ZoomToDocument_Click"
                                            ToolTip="Thu phóng vừa tem" AutomationProperties.Name="Zoom to document" AutomationProperties.AutomationId="Shell.Ribbon.ZoomToDocument"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.ZoomToObjects32}" Content="Vừa&#10;đối tượng" Click="ZoomToObjects_Click"
                                            ToolTip="Thu phóng vừa các đối tượng trên tem" AutomationProperties.Name="Zoom to objects" AutomationProperties.AutomationId="Shell.Ribbon.ZoomToObjects"/>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.ZoomIn16}" Content="Phóng to" Command="{Binding ZoomInCommand}"
                                                ToolTip="Phóng to (Ctrl + lăn chuột, Ctrl+dấu cộng)" AutomationProperties.Name="Ribbon zoom in" AutomationProperties.AutomationId="Shell.Ribbon.ZoomIn"/>
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.ZoomOut16}" Content="Thu nhỏ" Command="{Binding ZoomOutCommand}"
                                                ToolTip="Thu nhỏ (Ctrl + lăn chuột, Ctrl+dấu trừ)" AutomationProperties.Name="Ribbon zoom out" AutomationProperties.AutomationId="Shell.Ribbon.ZoomOut"/>
                                        <StackPanel Orientation="Horizontal" Height="22">
                                            <Image Source="{StaticResource Icon.Zoom16}" Width="16" Height="16" Margin="4,0,5,0"/>
                                            <ComboBox x:Name="ZoomPercentBox" Width="72" IsEditable="True" Text="{Binding ZoomPercent, Mode=OneWay, StringFormat={}{0}%}"
                                                      SelectionChanged="ZoomPercentBox_SelectionChanged" KeyDown="ZoomPercentBox_KeyDown" LostKeyboardFocus="ZoomPercentBox_LostKeyboardFocus"
                                                      ToolTip="Tỉ lệ thu phóng (25–400 %; Ctrl+0: 100 %)" AutomationProperties.Name="Zoom percent" AutomationProperties.AutomationId="Shell.Ribbon.Zoom100">
                                                <ComboBoxItem Content="25%"/>
                                                <ComboBoxItem Content="50%"/>
                                                <ComboBoxItem Content="75%"/>
                                                <ComboBoxItem Content="100%"/>
                                                <ComboBoxItem Content="150%"/>
                                                <ComboBoxItem Content="200%"/>
                                                <ComboBoxItem Content="300%"/>
                                                <ComboBoxItem Content="400%"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Thu phóng"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel AutomationProperties.AutomationId="Shell.Ribbon.ObjectMarkers">
                                <StackPanel Style="{StaticResource RibbonColumn}">
                                    <CheckBox Content="Tên đối tượng" IsChecked="{Binding ElementName=DesignerCanvas, Path=ShowObjectNames, Mode=TwoWay}"
                                              ToolTip="Hiện tên đối tượng đang chọn phía trên nó" AutomationProperties.Name="Show object names"/>
                                    <CheckBox Content="Nguồn dữ liệu" IsChecked="{Binding ElementName=DesignerCanvas, Path=ShowDataSourceMarkers, Mode=TwoWay}"
                                              ToolTip="Đánh dấu các đối tượng lấy dữ liệu từ trường hoặc biến" AutomationProperties.Name="Show data source markers"/>
                                    <CheckBox Content="Đối tượng khóa" IsChecked="{Binding ElementName=DesignerCanvas, Path=ShowLockedMarkers, Mode=TwoWay}"
                                              ToolTip="Hiện dấu khóa trên các đối tượng đã khóa vị trí" AutomationProperties.Name="Show locked markers"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Hiện dấu đối tượng"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Gridlines32}" Content="Lưới&#10;▾"
                                            ToolTip="Hiện hoặc ẩn lưới, chọn bước lưới" AutomationProperties.Name="Gridlines" AutomationProperties.AutomationId="Shell.Ribbon.Gridlines">
                                        <controls:Ribbon.DropDown>
                                            <ContextMenu x:Name="GridlinesMenu" Opened="GridlinesMenu_Opened">
                                                <MenuItem x:Name="ShowGridMenuItem" Header="Hiện lưới" IsCheckable="True" Click="ShowGridMenuItem_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Bước lưới 0,5 mm" Tag="0.5" IsCheckable="True" Click="GridStepMenuItem_Click"/>
                                                <MenuItem Header="Bước lưới 1 mm" Tag="1" IsCheckable="True" Click="GridStepMenuItem_Click"/>
                                                <MenuItem Header="Bước lưới 2 mm" Tag="2" IsCheckable="True" Click="GridStepMenuItem_Click"/>
                                                <MenuItem Header="Bước lưới 5 mm" Tag="5" IsCheckable="True" Click="GridStepMenuItem_Click"/>
                                                <MenuItem Header="Bước lưới 10 mm" Tag="10" IsCheckable="True" Click="GridStepMenuItem_Click"/>
                                            </ContextMenu>
                                        </controls:Ribbon.DropDown>
                                    </Button>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <ToggleButton Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.SnapObjects16}" Content="Căn theo đối tượng"
                                                      IsChecked="{Binding ElementName=DesignerCanvas, Path=IsSnapToObjectsEnabled, Mode=TwoWay}"
                                                      ToolTip="Căn theo đối tượng: dính cạnh và tâm đối tượng khi kéo. Giữ Alt để tạm bỏ qua."
                                                      AutomationProperties.Name="Snap to objects" AutomationProperties.AutomationId="Shell.Ribbon.SnapObjects"/>
                                        <ToggleButton Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.SnapGrid16}" Content="Căn theo lưới"
                                                      IsChecked="{Binding ElementName=DesignerCanvas, Path=IsSnapToGridEnabled, Mode=TwoWay}"
                                                      ToolTip="Căn theo lưới: dính cạnh đối tượng theo bước lưới vật lý đã đặt. Kéo từ thước để tạo đường gióng cố định; chuột phải lên khung vẽ để khóa/xóa đường gióng hoặc chọn bước; giữ Alt để tạm bỏ qua."
                                                      AutomationProperties.Name="Snap to grid" AutomationProperties.AutomationId="Shell.Ribbon.SnapGrid"/>
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.DoNotSnap16}" Content="Không căn" Click="DoNotAlign_Click"
                                                ToolTip="Tắt căn theo đối tượng và theo lưới" AutomationProperties.Name="Do not align" AutomationProperties.AutomationId="Shell.Ribbon.DoNotAlign"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Căn và lưới"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.RotateView32}" Content="Xoay&#10;khung nhìn" Click="RotateView_Click"
                                        ToolTip="{Binding ViewRotation, StringFormat='Xoay khung nhìn 90° (đang {0}°): chỉ xoay màn hình, không đổi tem hay bản in'}"
                                        AutomationProperties.Name="Rotate view" AutomationProperties.AutomationId="Shell.Ribbon.RotateView"/>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Xoay"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Panels32}" Content="Hiện lại&#10;bảng" Command="{Binding ShowAllPanelsCommand}"
                                        ToolTip="Hiện lại Hộp công cụ, Dữ liệu và Thuộc tính đã ẩn" AutomationProperties.Name="Panels restore" AutomationProperties.AutomationId="Shell.Ribbon.Panels"/>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Bảng"/>
                            </controls:RibbonGroupPanel>
                        </StackPanel>
                    </Viewbox>

                    <!-- Trợ giúp: Trợ giúp · Sản phẩm -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Help}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Help32}" Content="Trợ giúp" Click="Help_Click"
                                            ToolTip="Hướng dẫn sử dụng ANLAbel (F1)" AutomationProperties.Name="Help" AutomationProperties.AutomationId="Shell.Ribbon.Help"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.UserGuide32}" Content="Tài liệu&#10;hướng dẫn" Click="UserGuides_Click"
                                            ToolTip="Mở thư mục tài liệu hướng dẫn đi kèm bản cài" AutomationProperties.Name="User guides" AutomationProperties.AutomationId="Shell.Ribbon.UserGuides"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.SampleFiles32}" Content="Tệp mẫu" Click="TemplateLibrary_Click"
                                            ToolTip="Thư viện mẫu tem có sẵn" AutomationProperties.Name="Templates" AutomationProperties.AutomationId="Shell.Ribbon.Templates"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Support32}" Content="Hỗ trợ&#10;kỹ thuật" Click="TechnicalSupport_Click"
                                            ToolTip="Báo lỗi hoặc đề nghị hỗ trợ trên trang dự án" AutomationProperties.Name="Technical support" AutomationProperties.AutomationId="Shell.Ribbon.Support"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Trợ giúp"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.About32}" Content="Giới thiệu" Click="About_Click"
                                            ToolTip="Phiên bản, giấy phép GPL-3.0 và tác giả" AutomationProperties.Name="About" AutomationProperties.AutomationId="Shell.Ribbon.About"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.HomePage32}" Content="Trang chủ" Click="HomePage_Click"
                                            ToolTip="Mở trang dự án ANLAbel" AutomationProperties.Name="Home page" AutomationProperties.AutomationId="Shell.Ribbon.HomePage"/>
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.CheckUpdates32}" Content="Kiểm tra&#10;cập nhật" Click="CheckUpdates_Click"
                                            ToolTip="Kiểm tra bản cập nhật mới từ các bản phát hành trên GitHub" AutomationProperties.Name="Check for Updates" AutomationProperties.AutomationId="Shell.Ribbon.CheckUpdates"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Sản phẩm"/>
                            </controls:RibbonGroupPanel>
                        </StackPanel>
                    </Viewbox>

                    <!-- Thiết kế (ngữ cảnh): Chung · Vị trí · Sắp xếp -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Design}" IsEnabled="{Binding IsEditingAllowed}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <CheckBox Content="Không in" IsChecked="{Binding SelectionNotPrinted, Mode=TwoWay}"
                                                  ToolTip="Đối tượng vẫn hiện khi thiết kế nhưng không có trong bản in và xem trước" AutomationProperties.Name="Design not printable" AutomationProperties.AutomationId="Shell.Ribbon.NotPrintable"/>
                                        <CheckBox Content="Hiển thị" IsChecked="{Binding SelectionShown, Mode=TwoWay}" AutomationProperties.Name="Design visible"/>
                                        <ToggleButton x:Name="VisibilityConditionToggle" Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.VisibilitySettings16}" Content="Điều kiện hiển thị ▾"
                                                      ToolTip="Chỉ in đối tượng ở những dòng thỏa điều kiện" AutomationProperties.Name="Visibility condition" AutomationProperties.AutomationId="Shell.Ribbon.VisibilityCondition"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=VisibilityConditionToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=VisibilityConditionToggle}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="1" Padding="12,10" Width="300">
                                                <StackPanel>
                                                    <TextBlock Text="Điều kiện hiển thị" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}"/>
                                                    <TextBlock Text="Trường hoặc công thức, ví dụ {Lô} hoặc EQUALS(FIELD(&quot;Loại&quot;), &quot;QR&quot;). Đối tượng chỉ in ở dòng có giá trị khác rỗng, 0, false, không. Để trống: luôn in."
                                                               TextWrapping="Wrap" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,3,0,6"/>
                                                    <TextBox Text="{Binding SelectedObject.VisibilityCondition, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AutomationProperties.Name="Visibility condition expression" AutomationProperties.AutomationId="Shell.Ribbon.VisibilityConditionText"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    <ToggleButton x:Name="ObjectNameToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.ObjectName32}" Content="Tên&#10;▾"
                                                  ToolTip="Đổi tên đối tượng" AutomationProperties.Name="Design name menu" AutomationProperties.AutomationId="Shell.Ribbon.ObjectName"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=ObjectNameToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ObjectNameToggle}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="1" Padding="12,10" Width="260">
                                            <StackPanel>
                                                <TextBlock Text="Tên đối tượng" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}"/>
                                                <TextBox Margin="0,6,0,0" Text="{Binding SelectedObjectName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Design name"/>
                                                <!-- A taken or empty name is refused; this says why -->
                                                <TextBlock Text="{Binding ObjectNameMessage}" Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ObjectNameMessage}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Chung"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="AnchorPointToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.AnchorPoint32}" Content="Điểm&#10;neo ▾"
                                                  ToolTip="Điểm neo: điểm đứng yên khi đối tượng đổi kích thước theo nội dung" AutomationProperties.Name="Anchor point" AutomationProperties.AutomationId="Shell.Ribbon.AnchorPoint"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=AnchorPointToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AnchorPointToggle}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="1" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="Điểm neo" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}" Margin="0,0,0,6"/>
                                                <UniformGrid Columns="3" Rows="3" HorizontalAlignment="Left">
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo trên trái" AutomationProperties.Name="Anchor TopLeft"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.TopLeft}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo trên giữa" AutomationProperties.Name="Anchor TopCenter"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.TopCenter}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo trên phải" AutomationProperties.Name="Anchor TopRight"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.TopRight}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo giữa trái" AutomationProperties.Name="Anchor MiddleLeft"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.MiddleLeft}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo giữa" AutomationProperties.Name="Anchor Center"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.Center}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo giữa phải" AutomationProperties.Name="Anchor MiddleRight"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.MiddleRight}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo dưới trái" AutomationProperties.Name="Anchor BottomLeft"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.BottomLeft}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo dưới giữa" AutomationProperties.Name="Anchor BottomCenter"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.BottomCenter}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                    <RadioButton Style="{StaticResource RibbonIconRadio}" Width="24" Height="24" GroupName="RibbonAnchor" ToolTip="Neo dưới phải" AutomationProperties.Name="Anchor BottomRight"
                                                                 IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.BottomRight}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <CheckBox Content="Giữ tỉ lệ" IsChecked="{Binding SelectionKeepsAspectRatio, Mode=TwoWay}"
                                                  ToolTip="Kéo khung luôn giữ tỉ lệ rộng/cao" AutomationProperties.Name="Keep aspect ratio" AutomationProperties.AutomationId="Shell.Ribbon.KeepAspectRatio"/>
                                        <CheckBox Content="Khóa vị trí" IsChecked="{Binding SelectionLocked, Mode=TwoWay}" AutomationProperties.Name="Design lock"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Vị trí"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <controls:RibbonSplitButton controls:Ribbon.Icon="{StaticResource Icon.BringForward32}" Content="Đưa&#10;lên ▾" Command="{Binding BringForwardCommand}"
                                                                ToolTip="Đưa đối tượng lên một lớp, PgUp (▾: lên trên cùng, Ctrl+PgUp)" AutomationProperties.Name="Design bring forward">
                                        <controls:RibbonSplitButton.DropDown>
                                            <ContextMenu>
                                                <MenuItem Header="Lên trên cùng" Command="{Binding BringToFrontCommand}" InputGestureText="Ctrl+PgUp"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.BringToFront16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Lên một lớp" Command="{Binding BringForwardCommand}" InputGestureText="PgUp"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.BringForward16}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </controls:RibbonSplitButton.DropDown>
                                    </controls:RibbonSplitButton>
                                    <controls:RibbonSplitButton controls:Ribbon.Icon="{StaticResource Icon.SendBackward32}" Content="Đưa&#10;xuống ▾" Command="{Binding SendBackwardCommand}"
                                                                ToolTip="Đưa đối tượng xuống một lớp, PgDn (▾: xuống dưới cùng, Ctrl+PgDn)" AutomationProperties.Name="Design send backward">
                                        <controls:RibbonSplitButton.DropDown>
                                            <ContextMenu>
                                                <MenuItem Header="Xuống một lớp" Command="{Binding SendBackwardCommand}" InputGestureText="PgDn"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.SendBackward16}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Xuống dưới cùng" Command="{Binding SendToBackCommand}" InputGestureText="Ctrl+PgDn"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.SendToBack16}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </controls:RibbonSplitButton.DropDown>
                                    </controls:RibbonSplitButton>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Group16}" Content="Nhóm đối tượng" Click="GroupObjects_Click"
                                                ToolTip="Nhóm các đối tượng đang chọn: chọn và di chuyển cùng nhau (Ctrl+G)" AutomationProperties.Name="Design group objects" AutomationProperties.AutomationId="Shell.Ribbon.Group"/>
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Ungroup16}" Content="Bỏ nhóm" Click="UngroupObjects_Click"
                                                ToolTip="Bỏ nhóm các đối tượng đang chọn (Ctrl+Shift+G)" AutomationProperties.Name="Design ungroup objects" AutomationProperties.AutomationId="Shell.Ribbon.Ungroup"/>
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.Align16}" Content="Căn chỉnh ▾"
                                                ToolTip="Căn và phân bố các đối tượng đang chọn" AutomationProperties.Name="Align menu" AutomationProperties.AutomationId="Shell.Ribbon.AlignMore">
                                            <controls:Ribbon.DropDown>
                                                <ContextMenu>
                                                    <MenuItem Header="Căn trái" Tag="Left" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignLeft16}"/></MenuItem.Icon></MenuItem>
                                                    <MenuItem Header="Căn giữa theo chiều ngang" Tag="HorizontalCenter" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignCenterH16}"/></MenuItem.Icon></MenuItem>
                                                    <MenuItem Header="Căn phải" Tag="Right" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignRight16}"/></MenuItem.Icon></MenuItem>
                                                    <MenuItem Header="Căn trên" Tag="Top" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignTop16}"/></MenuItem.Icon></MenuItem>
                                                    <MenuItem Header="Căn giữa theo chiều dọc" Tag="VerticalCenter" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignCenterV16}"/></MenuItem.Icon></MenuItem>
                                                    <MenuItem Header="Căn dưới" Tag="Bottom" Click="ArrangeAlign_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.AlignBottom16}"/></MenuItem.Icon></MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Phân bố đều theo chiều ngang" Tag="HorizontalGaps" Click="ArrangeDistribute_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.DistributeH16}"/></MenuItem.Icon></MenuItem>
                                                    <MenuItem Header="Phân bố đều theo chiều dọc" Tag="VerticalGaps" Click="ArrangeDistribute_Click"><MenuItem.Icon><Image Style="{StaticResource RibbonMenuIcon}" Source="{StaticResource Icon.DistributeV16}"/></MenuItem.Icon></MenuItem>
                                                </ContextMenu>
                                            </controls:Ribbon.DropDown>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Sắp xếp"/>
                            </controls:RibbonGroupPanel>
                        </StackPanel>
                    </Viewbox>

                    <!-- Chữ (ngữ cảnh): Định dạng · Thiết lập chữ · Hiệu ứng -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Text}" IsEnabled="{Binding IsEditingAllowed}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <ComboBox Width="150" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding RibbonFontFamily, Mode=TwoWay}"
                                              AutomationProperties.Name="Text tab font family" ToolTip="Phông chữ">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Width="52" Margin="3,0,2,0" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding RibbonFontSize, Mode=TwoWay}"
                                              AutomationProperties.Name="Text tab font size" ToolTip="Cỡ chữ (pt)"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.GrowFont16}" Click="FontGrow_Click" ToolTip="Tăng cỡ chữ" AutomationProperties.Name="Text tab grow font"/>
                                    <Button Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.ShrinkFont16}" Click="FontShrink_Click" ToolTip="Giảm cỡ chữ" AutomationProperties.Name="Text tab shrink font"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Bold, Mode=TwoWay}" ToolTip="Đậm" AutomationProperties.Name="Text tab bold"><TextBlock Text="B" FontWeight="Bold"/></ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Italic, Mode=TwoWay}" ToolTip="Nghiêng" AutomationProperties.Name="Text tab italic"><TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/></ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Underline, Mode=TwoWay}" ToolTip="Gạch chân" AutomationProperties.Name="Text tab underline"><TextBlock Text="U" TextDecorations="Underline"/></ToggleButton>
                                    <ToggleButton Style="{StaticResource RibbonIconButton}" IsChecked="{Binding SelectedObject.Style.Strikethrough, Mode=TwoWay}" ToolTip="Gạch ngang" AutomationProperties.Name="Text tab strikethrough"><TextBlock Text="S" TextDecorations="Strikethrough"/></ToggleButton>
                                    <Border Width="6"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignLeft16}" GroupName="TextTabAlign" ToolTip="Căn trái" AutomationProperties.Name="Text tab align left"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Left}}"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignCenter16}" GroupName="TextTabAlign" ToolTip="Căn giữa" AutomationProperties.Name="Text tab align center"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Center}}"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextAlignRight16}" GroupName="TextTabAlign" ToolTip="Căn phải" AutomationProperties.Name="Text tab align right"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Right}}"/>
                                    <RadioButton Style="{StaticResource RibbonIconButton}" controls:Ribbon.Icon="{StaticResource Icon.TextJustify16}" GroupName="TextTabAlign" ToolTip="Căn đều hai bên" AutomationProperties.Name="Text tab justify"
                                                 IsChecked="{Binding SelectedObject.Style.Alignment, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:TextAlignmentMode.Justify}}"/>
                                    <Border Width="6"/>
                                    <ComboBox Width="44" ItemsSource="{Binding TextColorOptions}" SelectedItem="{Binding SelectedObject.Style.StrokeColor, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource RibbonTextColorItem}" ToolTip="Màu chữ" AutomationProperties.Name="Text tab colour"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Định dạng"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Text}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Co giãn chữ ngang (%)" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,0,0,2"/>
                                        <TextBox Width="110" Text="{Binding SelectedObject.Style.FontScalePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" AutomationProperties.Name="Text tab font scaling"
                                                 ToolTip="Như co giãn chữ trong NiceLabel: 100 là chữ gốc, dưới 100 hẹp lại, trên 100 giãn rộng ra."/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.TextBox}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Vừa trong khung" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,0,0,2"/>
                                        <ComboBox Width="230" ItemsSource="{Binding TextBoxSizingModes}" SelectedItem="{Binding SelectedObject.Style.TextSizing, Mode=TwoWay}" AutomationProperties.Name="Text tab sizing"
                                                  ItemTemplate="{StaticResource TextSizingItem}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Thiết lập chữ"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Style="{StaticResource RibbonColumn}">
                                    <CheckBox Content="Soi gương" IsChecked="{Binding SelectedObject.Style.MirrorText, Mode=TwoWay}"
                                              ToolTip="In chữ ngược trái-phải (dán sau kính, in chuyển nhiệt)" AutomationProperties.Name="Mirror text" AutomationProperties.AutomationId="Shell.Ribbon.MirrorText"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Hiệu ứng"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RibbonArrangeGroup}"/>
                        </StackPanel>
                    </Viewbox>

                    <!-- Mã vạch (ngữ cảnh): Mã vạch · Thiết lập · Sắp xếp (NiceLabel 10 Barcode tab) -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Barcode}" IsEnabled="{Binding IsEditingAllowed}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Icon.Barcode32}" Width="32" Height="32" Margin="2,3,8,0" VerticalAlignment="Top"/>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Loại mã" Width="52" VerticalAlignment="Center" Foreground="{StaticResource RibbonCaptionBrush}"/>
                                            <ComboBox Width="196" ItemsSource="{Binding Source={StaticResource GroupedBarcodeSymbologies}}" SelectedValue="{Binding SelectedObject.BarcodeSymbology, Mode=TwoWay}"
                                                      SelectedValuePath="Value" DisplayMemberPath="DisplayName" ToolTip="Chuẩn mã vạch" AutomationProperties.Name="Barcode tab symbology">
                                                <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#EAF3FF" Padding="6,3" Margin="0,4,0,2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Dữ liệu" Width="52" VerticalAlignment="Center" Foreground="{StaticResource RibbonCaptionBrush}"/>
                                            <TextBox Width="196" Text="{Binding SelectedObject.Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Barcode tab data"/>
                                        </StackPanel>
                                        <CheckBox Content="Hiện chữ dưới mã" Margin="52,0,0,0" IsChecked="{Binding SelectedObject.ShowBarcodeText, Mode=TwoWay}" AutomationProperties.Name="Barcode tab human readable"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Mã vạch"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BearerBarToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.BearerBar32}" Content="Vạch bao&#10;▾"
                                                  ToolTip="Vạch bao (bảo vệ) cho mã vạch tuyến tính, ví dụ ITF-14" AutomationProperties.Name="Bearer bar" AutomationProperties.AutomationId="Shell.Ribbon.BearerBar"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=BearerBarToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BearerBarToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="280">
                                            <StackPanel>
                                                <TextBlock Text="Vạch bao" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}"/>
                                                <TextBlock Text="Kiểu" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <ComboBox ItemsSource="{Binding BearerBarStyleOptions}" ItemTemplate="{StaticResource DisplayNameItem}" SelectedItem="{Binding SelectedObject.BearerBarStyle, Mode=TwoWay}"
                                                          AutomationProperties.Name="Kiểu vạch bao"/>
                                                <TextBlock Text="Độ dày (mm)" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <TextBox Text="{Binding SelectedObject.BearerBarThicknessMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" AutomationProperties.Name="Độ dày vạch bao"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <ToggleButton x:Name="BarcodeDetailsToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.BarcodeDetails32}" Content="Chi tiết&#10;mã ▾"
                                                  ToolTip="Chữ dưới mã, số kiểm tra, độ rộng vạch hẹp" AutomationProperties.Name="Barcode details" AutomationProperties.AutomationId="Shell.Ribbon.BarcodeDetails"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=BarcodeDetailsToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BarcodeDetailsToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="320">
                                            <StackPanel>
                                                <TextBlock Text="Chi tiết mã" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}"/>
                                                <TextBlock Text="Vị trí chữ dưới mã" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <ComboBox ItemsSource="{Binding BarcodeHriPlacementOptions}" ItemTemplate="{StaticResource DisplayNameItem}" SelectedItem="{Binding SelectedObject.BarcodeHriPlacement, Mode=TwoWay}"
                                                          AutomationProperties.Name="Vị trí chữ dưới mã"/>
                                                <TextBlock Text="Cỡ chữ dưới mã (pt)" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <TextBox Text="{Binding SelectedObject.BarcodeTextFontSizePt, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" AutomationProperties.Name="Cỡ chữ dưới mã"/>
                                                <TextBlock Text="Phông chữ dưới mã" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedObject.BarcodeHriFontFamily, Mode=TwoWay}" AutomationProperties.Name="Phông chữ dưới mã"/>
                                                <CheckBox Content="Chữ dưới mã in đậm" Margin="0,6,0,0" IsChecked="{Binding SelectedObject.BarcodeHriBold, Mode=TwoWay}" AutomationProperties.Name="Chữ dưới mã in đậm"/>
                                                <TextBlock Text="Số kiểm tra" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <ComboBox ItemsSource="{Binding BarcodeCheckDigitPolicyOptions}" ItemTemplate="{StaticResource DisplayNameItem}" SelectedItem="{Binding SelectedObject.BarcodeCheckDigitPolicy, Mode=TwoWay}"
                                                          AutomationProperties.Name="Số kiểm tra"/>
                                                <CheckBox Content="Hiện số kiểm tra trong chữ dưới mã" Margin="0,6,0,0" IsChecked="{Binding SelectedObject.BarcodeHriShowCheckDigit, Mode=TwoWay}"/>
                                                <TextBlock Text="Độ rộng vạch hẹp (mm)" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <TextBox Text="{Binding SelectedObject.BarcodeModuleWidthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" AutomationProperties.Name="Độ rộng vạch hẹp"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <ToggleButton x:Name="Barcode2DToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Barcode2D32}" Content="Chi tiết&#10;2D ▾"
                                                  ToolTip="QR, Data Matrix, PDF417: cách tính kích thước, mức sửa lỗi, vùng yên" AutomationProperties.Name="2D barcode details" AutomationProperties.AutomationId="Shell.Ribbon.Barcode2D"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=Barcode2DToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Barcode2DToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="300">
                                            <StackPanel>
                                                <TextBlock Text="Chi tiết mã 2D" FontWeight="SemiBold" Foreground="{StaticResource RibbonTextBrush}"/>
                                                <TextBlock Text="Cách tính kích thước" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <ComboBox ItemsSource="{Binding QrSizingModeOptions}" SelectedValue="{Binding SelectedObject.QrSizingMode, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                                          AutomationProperties.Name="Cách tính kích thước mã 2D"/>
                                                <TextBlock Text="Mức sửa lỗi (ECC)" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <ComboBox ItemsSource="{Binding QrErrorCorrectionOptions}" SelectedValue="{Binding SelectedObject.QrErrorCorrection, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                                          AutomationProperties.Name="Mức sửa lỗi"/>
                                                <TextBlock Text="Vùng yên (mô-đun)" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                <ComboBox ItemsSource="{Binding QrQuietZoneModuleOptions}" SelectedItem="{Binding SelectedObject.QrQuietZoneModules, Mode=TwoWay}" AutomationProperties.Name="Vùng yên"/>
                                                <StackPanel>
                                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedObject.BarcodeSymbology}" Value="{x:Static enums:BarcodeSymbology.DataMatrix}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                    <TextBlock Text="Khổ Data Matrix" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,8,0,2"/>
                                                    <ComboBox ItemsSource="{Binding DataMatrixSymbolSizeOptions}" ItemTemplate="{StaticResource DisplayNameItem}" SelectedItem="{Binding SelectedObject.DataMatrixSymbolSize, Mode=TwoWay}"
                                                              AutomationProperties.Name="Khổ Data Matrix" AutomationProperties.AutomationId="Shell.Ribbon.DataMatrixSize"
                                                              ToolTip="Tự động: khổ vuông nhỏ nhất chứa được dữ liệu. Khổ cố định (vuông hoặc chữ nhật cho tem hẹp): dữ liệu dài hơn khổ thì báo lỗi, không tự nới."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Thiết lập"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RibbonArrangeGroup}"/>
                        </StackPanel>
                    </Viewbox>

                    <!-- Hình ảnh (ngữ cảnh): Hình ảnh · Sắp xếp (NiceLabel 10 Picture tab: Resize, Arrange) -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Picture}" IsEnabled="{Binding IsEditingAllowed}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.ReplacePicture32}" Content="Thay ảnh" Command="{Binding ReplaceSelectedImageCommand}"
                                            ToolTip="Chọn tệp ảnh khác cho đối tượng này" AutomationProperties.Name="Replace picture"/>
                                    <ToggleButton x:Name="PictureSizingToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.PictureSize32}" Content="Cỡ ảnh&#10;▾"
                                                  ToolTip="Co giãn theo tỉ lệ, kéo đầy khung hoặc giữ cỡ gốc của ảnh" AutomationProperties.Name="Picture sizing" AutomationProperties.AutomationId="Shell.Ribbon.PictureSizing"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=PictureSizingToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=PictureSizingToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="200">
                                            <ListBox ItemsSource="{Binding PictureSizings}" ItemTemplate="{StaticResource DisplayNameItem}" SelectedItem="{Binding SelectedObject.PictureSizing, Mode=TwoWay}"
                                                     BorderThickness="0" AutomationProperties.Name="Cỡ ảnh"/>
                                        </Border>
                                    </Popup>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <CheckBox Content="Giữ tỉ lệ" IsChecked="{Binding SelectionKeepsAspectRatio, Mode=TwoWay}" ToolTip="Kéo khung luôn giữ tỉ lệ rộng/cao" AutomationProperties.Name="Picture keep aspect ratio"/>
                                        <CheckBox Content="Lật ngang" IsChecked="{Binding SelectedObject.PictureFlipHorizontal, Mode=TwoWay}" ToolTip="Lật ảnh trái sang phải" AutomationProperties.Name="Flip picture horizontal"/>
                                        <CheckBox Content="Lật dọc" IsChecked="{Binding SelectedObject.PictureFlipVertical, Mode=TwoWay}" ToolTip="Lật ảnh trên xuống dưới" AutomationProperties.Name="Flip picture vertical"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <Button Style="{StaticResource RibbonSmallButton}" controls:Ribbon.Icon="{StaticResource Icon.OriginalSize16}" Content="Về cỡ gốc" Command="{Binding ResetPictureSizeCommand}"
                                                ToolTip="Đặt khung ảnh bằng cỡ gốc của ảnh (theo điểm ảnh và độ phân giải)" AutomationProperties.Name="Revert to original picture size"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Hình ảnh"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RibbonArrangeGroup}"/>
                        </StackPanel>
                    </Viewbox>

                    <!-- Hình dạng (ngữ cảnh): Đường viền · Tô nền · Sắp xếp (NiceLabel 10 Shape tab) -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Visibility="{Binding SelectedRibbonTab, Converter={StaticResource RibbonTabConverter}, ConverterParameter=Shape}" IsEnabled="{Binding IsEditingAllowed}">
                        <StackPanel Style="{StaticResource RibbonPanel}">
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="OutlineStyleToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.OutlineStyle32}" Content="Kiểu viền&#10;▾"
                                                  ToolTip="Nét liền, nét đứt hoặc không viền" AutomationProperties.Name="Outline style" AutomationProperties.AutomationId="Shell.Ribbon.OutlineStyle"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=OutlineStyleToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OutlineStyleToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="200">
                                            <ListBox ItemsSource="{Binding OutlineStyles}" ItemTemplate="{StaticResource DisplayNameItem}" SelectedItem="{Binding SelectedObject.Style.OutlineStyle, Mode=TwoWay}"
                                                     BorderThickness="0" AutomationProperties.Name="Kiểu viền"/>
                                        </Border>
                                    </Popup>
                                    <ToggleButton x:Name="OutlineColorToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.OutlineColor32}" Content="Màu viền&#10;▾"
                                                  ToolTip="Màu đường viền" AutomationProperties.Name="Outline colour" AutomationProperties.AutomationId="Shell.Ribbon.OutlineColor"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=OutlineColorToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OutlineColorToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="236">
                                            <StackPanel>
                                                <ListBox ItemsSource="{Binding TextColorOptions}" SelectedItem="{Binding SelectedObject.Style.StrokeColor, Mode=TwoWay}" ItemTemplate="{StaticResource RibbonColorSwatch}"
                                                         ItemsPanel="{StaticResource RibbonSwatchPanel}" BorderThickness="0" AutomationProperties.Name="Bảng màu viền"/>
                                                <TextBlock Text="Mã màu" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,6,0,2"/>
                                                <TextBox Text="{Binding SelectedObject.Style.StrokeColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Mã màu viền"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <StackPanel Style="{StaticResource RibbonColumn}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="Độ dày (mm)" Width="78" VerticalAlignment="Center" Foreground="{StaticResource RibbonCaptionBrush}"/>
                                            <TextBox Width="64" Text="{Binding SelectedObject.Style.BorderThicknessMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" AutomationProperties.Name="Shape tab outline"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Bo góc (mm)" Width="78" VerticalAlignment="Center" Foreground="{StaticResource RibbonCaptionBrush}"/>
                                            <TextBox Width="64" Text="{Binding SelectedObject.Style.CornerRadiusMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" AutomationProperties.Name="Shape tab corner radius"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Đường viền"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <controls:RibbonGroupPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="FillStyleToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.FillStyle32}" Content="Kiểu tô&#10;▾"
                                                  ToolTip="Không tô, tô kín hoặc gạch chéo" AutomationProperties.Name="Fill style" AutomationProperties.AutomationId="Shell.Ribbon.FillStyle"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=FillStyleToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FillStyleToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="200">
                                            <ListBox ItemsSource="{Binding FillStyles}" ItemTemplate="{StaticResource DisplayNameItem}" SelectedItem="{Binding SelectedObject.Style.FillStyle, Mode=TwoWay}"
                                                     BorderThickness="0" AutomationProperties.Name="Kiểu tô nền"/>
                                        </Border>
                                    </Popup>
                                    <ToggleButton x:Name="FillColorToggle" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.FillColor32}" Content="Màu tô&#10;▾"
                                                  ToolTip="Màu tô nền" AutomationProperties.Name="Fill colour" AutomationProperties.AutomationId="Shell.Ribbon.FillColor"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=FillColorToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FillColorToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource RibbonPopupPanel}" Width="236">
                                            <StackPanel>
                                                <ListBox ItemsSource="{Binding TextColorOptions}" SelectedItem="{Binding SelectedObject.Style.FillColor, Mode=TwoWay}" ItemTemplate="{StaticResource RibbonColorSwatch}"
                                                         ItemsPanel="{StaticResource RibbonSwatchPanel}" BorderThickness="0" AutomationProperties.Name="Bảng màu tô"/>
                                                <TextBlock Text="Mã màu" Foreground="{StaticResource RibbonCaptionBrush}" Margin="0,6,0,2"/>
                                                <TextBox Text="{Binding SelectedObject.Style.FillColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Mã màu tô"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Tô nền"/>
                            </controls:RibbonGroupPanel>
                            <Border Style="{StaticResource RibbonGroupSeparator}"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RibbonArrangeGroup}"/>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- NiceLabel 10 status bar: messages on the left; printer, label size and zoom on the right -->
        <Border DockPanel.Dock="Bottom" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="4" Height="28" Background="{StaticResource RibbonBodyBrush}" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="0,1,0,0"
                AutomationProperties.AutomationId="Shell.Status"
                AutomationProperties.Name="Printer and status bar">
            <Border.Resources>
                <Style x:Key="StatusIconButton" TargetType="Button" BasedOn="{StaticResource RibbonIconButton}">
                    <Setter Property="Width" Value="26"/>
                </Style>
            </Border.Resources>
            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Warning chips keep their room; a long status message trims instead of covering them -->
                <DockPanel VerticalAlignment="Center" LastChildFill="True" Margin="0,0,12,0">
                    <Button DockPanel.Dock="Right" Click="PrinterQueueWarning_Click"
                            Visibility="{Binding HasPrinterQueueWarning, Converter={StaticResource BoolToVisibility}}"
                            Margin="10,0,0,0"
                            Padding="7,1"
                            MinHeight="0"
                            Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            Foreground="#B91C1C"
                            ToolTip="{Binding PrinterQueueStatusMessage}">
                        <TextBlock Text="{Binding PrinterQueueStatusText}" FontWeight="SemiBold" Foreground="#B91C1C"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Click="ReviewPrintRecovery_Click"
                            Visibility="{Binding HasPendingPrintRecovery, Converter={StaticResource BoolToVisibility}}"
                            Margin="10,0,0,0"
                            Padding="7,1"
                            MinHeight="0"
                            Background="#FFF7ED"
                            BorderBrush="#FDBA74"
                            Foreground="#9A3412"
                            ToolTip="Xem xét lệnh in chưa chắc chắn; tự động thử lại đã tắt">
                        <TextBlock Text="{Binding PrintRecoveryStatusText}" FontWeight="SemiBold" Foreground="#9A3412"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Click="MissingResources_Click"
                            Visibility="{Binding HasMissingResources, Converter={StaticResource BoolToVisibility}}"
                            Margin="10,0,0,0"
                            Padding="7,1"
                            MinHeight="0"
                            Background="#FFFBEB"
                            BorderBrush="#FCD34D"
                            Foreground="#92400E"
                            AutomationProperties.AutomationId="Shell.Status.MissingResources"
                            ToolTip="{Binding MissingResourcesDetail}">
                        <TextBlock Text="{Binding MissingResourcesText}" FontWeight="SemiBold" Foreground="#92400E"/>
                    </Button>
                    <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <!-- NiceLabel 10 status bar: printer selector, zoom to document / objects, zoom slider, percentage -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.AutomationId="Shell.Status.Zoom">
                    <Image Source="{StaticResource Icon.Printer16}" Width="16" Height="16" Margin="0,0,5,0"/>
                    <Button Click="PrinterSetup_Click" Height="22" MinHeight="0" Padding="6,0" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#ABADB3"
                            ToolTip="Máy in của tem — bấm để chọn máy in trong Thuộc tính tem" AutomationProperties.Name="Status printer" AutomationProperties.AutomationId="Shell.Status.Printer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource RibbonTextBrush}" VerticalAlignment="Center" MinWidth="150" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Template.PrinterProfile.PrinterName, Mode=OneWay, Converter={StaticResource EmptyText}, ConverterParameter=Chưa chọn máy in, FallbackValue=Chưa chọn máy in}"/>
                            <TextBlock Text="▾" Margin="6,0,0,0" Foreground="{StaticResource RibbonCaptionBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="PrinterSetup_Click" Height="22" MinHeight="0" Padding="6,0" Margin="0,0,8,0" Background="Transparent" BorderBrush="Transparent"
                            ToolTip="Kích thước tem — bấm để đổi trong Thuộc tính tem" AutomationProperties.Name="Status label size" AutomationProperties.AutomationId="Shell.Status.LabelSize">
                        <TextBlock Foreground="{StaticResource RibbonTextBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding Template.WidthMm, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" × "/><Run Text="{Binding Template.HeightMm, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" mm"/>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource StatusIconButton}" controls:Ribbon.Icon="{StaticResource Icon.ZoomToDocument16}" Click="ZoomToDocument_Click"
                            ToolTip="Thu phóng vừa tem" AutomationProperties.Name="Status zoom to document" AutomationProperties.AutomationId="Shell.Status.ZoomToDocument"/>
                    <Button Style="{StaticResource StatusIconButton}" controls:Ribbon.Icon="{StaticResource Icon.ZoomToObjects16}" Click="ZoomToObjects_Click" Margin="0,0,6,0"
                            ToolTip="Thu phóng vừa các đối tượng" AutomationProperties.Name="Status zoom to objects" AutomationProperties.AutomationId="Shell.Status.ZoomToObjects"/>
                    <Button Style="{StaticResource StatusIconButton}" Command="{Binding ZoomOutCommand}" ToolTip="Thu nhỏ (Ctrl+dấu trừ)" AutomationProperties.Name="Status zoom out">
                        <TextBlock Text="−" FontSize="14" Margin="0,-2,0,0"/>
                    </Button>
                    <Slider Width="120" Minimum="0.25" Maximum="4" SmallChange="0.1" LargeChange="0.25" Value="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Zoom" AutomationProperties.AutomationId="Shell.Status.ZoomSlider"/>
                    <Button Style="{StaticResource StatusIconButton}" Command="{Binding ZoomInCommand}" ToolTip="Phóng to (Ctrl+dấu cộng)" AutomationProperties.Name="Status zoom in">
                        <TextBlock Text="+" FontSize="14" Margin="0,-2,0,0"/>
                    </Button>
                    <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}" Foreground="{StaticResource RibbonTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="38" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ShellGrid" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="3">
            <Grid.Background>
                <VisualBrush TileMode="Tile" Viewport="0,0,600,300" ViewportUnits="Absolute">
                    <VisualBrush.Visual>
                        <TextBlock Text="cre: Đức An" FontSize="56" FontWeight="Bold" Foreground="#5B6B80" Opacity="0.18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsToolboxVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=268}"/>
                <ColumnDefinition Width="{Binding IsToolboxVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=6}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding IsPropertiesDocked, Converter={StaticResource BoolToGridLength}, ConverterParameter=6}"/>
                <ColumnDefinition Width="{Binding IsPropertiesDocked, Converter={StaticResource BoolToGridLength}, ConverterParameter=300}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12,12,0,12" Style="{StaticResource PanelCard}" Visibility="{Binding IsToolboxVisible, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="Shell.LeftColumn"
                    AutomationProperties.Name="Objects and workspace">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="Auto" MinHeight="150"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0"
                            AutomationProperties.AutomationId="Shell.Toolbox"
                            AutomationProperties.Name="Insert objects">
                        <DockPanel>
                            <TextBlock Text="{Binding Ui.InsertObjects}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelHeaderButton}" Command="{Binding HideToolboxCommand}" ToolTip="Ẩn hộp công cụ">
                                <Image Style="{StaticResource SmallIconImage}" Source="{StaticResource Icon.ChevronUp16}"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="8,8,8,8" IsEnabled="{Binding IsEditingAllowed}">
                        <UniformGrid Columns="3" Rows="3">
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.Text32}" Content="Chữ" Command="{Binding AddTextCommand}" AutomationProperties.Name="Insert Text" ToolTip="Chữ (một dòng, nội dung tự sở hữu)"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.TextBox32}" Content="Ô chữ" Command="{Binding AddTextBoxCommand}" AutomationProperties.Name="Insert Text Box"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.RichText32}" Content="Chữ RTF" Command="{Binding AddRichTextBoxCommand}" AutomationProperties.Name="Insert Rich Text" ToolTip="Chữ định dạng (RTF): nhiều kiểu chữ trong một khung"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.Barcode32}" Content="Mã vạch" Command="{Binding AddBarcodeCommand}" AutomationProperties.Name="Insert Barcode"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.Picture32}" Content="Hình ảnh" Command="{Binding AddImageCommand}" AutomationProperties.Name="Insert Picture"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.Rectangle32}" Content="Chữ nhật" Command="{Binding AddRectangleCommand}" AutomationProperties.Name="Insert Rectangle" ToolTip="Hình chữ nhật"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.Line32}" Content="Đường kẻ" Command="{Binding AddLineCommand}" AutomationProperties.Name="Insert Line"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.Ellipse32}" Content="Bầu dục" Command="{Binding AddEllipseCommand}" AutomationProperties.Name="Insert Ellipse" ToolTip="Hình bầu dục"/>
                            <Button Style="{StaticResource ToolboxTile}" controls:Ribbon.Icon="{StaticResource Icon.Inverse32}" Content="Đảo màu" Command="{Binding AddInverseCommand}" AutomationProperties.Name="Insert Inverse" ToolTip="Đảo màu: vùng in đảo ngược đen và trắng bên dưới"/>
                        </UniformGrid>

                        <TextBlock Text="{Binding DrawingCommandText}" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" TextWrapping="Wrap" Margin="4,8,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDrawingTool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                    <GridSplitter Grid.Row="2"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#EEF2F6"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True"/>

                    <Border Grid.Row="3" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" MinHeight="160"
                            AutomationProperties.AutomationId="Shell.Workspace"
                            AutomationProperties.Name="Workspace Layers and Data">
                        <DockPanel>
                            <TabControl x:Name="WorkspaceTabs" BorderThickness="0" Padding="6" SelectedIndex="0">
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource Icon.Database16}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Dữ liệu"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4,8">
                                    <!-- NiceLabel 10 Data explorer: a search box over the tree, and Add new variable (here a prompt or a function) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DataTreeSearch" TextChanged="DataTreeSearch_TextChanged" ToolTip="Tìm biến nhập khi in, cột dữ liệu hoặc hàm theo tên" AutomationProperties.Name="Data search"/>
                                        <TextBlock Text="Tìm…" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AppMutedBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DataTreeSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
