                                <Button Style="{StaticResource RibbonSecondaryButton}" Command="{Binding PrintCalibrationCommand}" ToolTip="Print a calibration label" AutomationProperties.Name="Test print" AutomationProperties.AutomationId="Shell.Ribbon.TestPrint">
