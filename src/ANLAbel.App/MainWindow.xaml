<Window x:Class="ANLAbel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ANLAbel.App.Controls"
        xmlns:enums="clr-namespace:ANLAbel.Core.Enums;assembly=ANLAbel.Core"
        xmlns:barcode="clr-namespace:ANLAbel.Core.Barcode;assembly=ANLAbel.Core"
        Title="ANLAbel - Label Designer v0.045"
        Icon="/ANLAbel.App;component/anlabel.ico"
        Height="800" Width="1440"
        MinHeight="430" MinWidth="720"
        Background="#EEF2F6"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <controls:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        <CollectionViewSource x:Key="GroupedBarcodeSymbologies" Source="{Binding BarcodeSymbologyOptions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Color x:Key="ColorText">#1E293B</Color>
        <Color x:Key="ColorMuted">#64748B</Color>
        <Color x:Key="ColorLine">#D9E2EC</Color>
        <Color x:Key="ColorPanel">#FFFFFF</Color>
        <Color x:Key="ColorPanelAlt">#F8FAFC</Color>
        <Color x:Key="ColorWorkspace">#EEF2F6</Color>
        <Color x:Key="ColorBlue">#1464D2</Color>
        <Color x:Key="ColorBlueDark">#0F4EA8</Color>
        <Color x:Key="ColorBlueSoft">#EAF3FF</Color>
        <Color x:Key="ColorDanger">#EF4444</Color>

        <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource ColorText}"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource ColorMuted}"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource ColorLine}"/>
        <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource ColorPanel}"/>
        <SolidColorBrush x:Key="AppPanelAltBrush" Color="{StaticResource ColorPanelAlt}"/>
        <SolidColorBrush x:Key="AppWorkspaceBrush" Color="{StaticResource ColorWorkspace}"/>
        <SolidColorBrush x:Key="AppBlueBrush" Color="{StaticResource ColorBlue}"/>
        <SolidColorBrush x:Key="AppBlueDarkBrush" Color="{StaticResource ColorBlueDark}"/>
        <SolidColorBrush x:Key="AppBlueSoftBrush" Color="{StaticResource ColorBlueSoft}"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource ColorDanger}"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#334155"/>
        <DropShadowEffect x:Key="LabelShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#334155"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBlueSoftBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B7D7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconImage" TargetType="Image">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="SmallIconImage" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DFE8F2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PanelHeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppBlueDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBlueSoftBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBlueDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DCEBFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0B3F86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EDF5"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F6"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Height="40" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" Background="{StaticResource AppBlueBrush}" CornerRadius="5" Margin="0,0,10,0">
                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ANLAbel - Label Designer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="7,2" Background="#EAF3FF" BorderBrush="{StaticResource AppBlueBrush}" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center">
                        <TextBlock Text="closebeta v0.045" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Style="{StaticResource SmallIconImage}" Source="Icons/printer_setup.png" Width="18" Height="18" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Template.PrinterProfile.PrinterName, TargetNullValue=Printer not selected, FallbackValue=Printer not selected}" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,24,0"/>
                    <Image Style="{StaticResource SmallIconImage}" Source="Icons/table.png" Width="18" Height="18" Margin="0,0,7,0"/>
                    <TextBlock FontWeight="SemiBold" Foreground="#334155">
                        <Run Text="Paper: "/>
                        <Run Text="{Binding Template.WidthMm, StringFormat={}{0:0.##}}"/>
                        <Run Text=" x "/>
                        <Run Text="{Binding Template.HeightMm, StringFormat={}{0:0.##}}"/>
                        <Run Text=" mm"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Click="New_Click">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/new.png"/><TextBlock Text="New" TextAlignment="Center"/><TextBlock Text="Ctrl+N" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Click="Open_Click">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/open.png"/><TextBlock Text="Open" TextAlignment="Center"/><TextBlock Text="Ctrl+O" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Click="Save_Click">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/save.png"/><TextBlock Text="Save" TextAlignment="Center"/><TextBlock Text="Ctrl+S" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="File"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding UndoCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/undo.png"/><TextBlock Text="Undo" TextAlignment="Center"/><TextBlock Text="Ctrl+Z" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding RedoCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/redo.png"/><TextBlock Text="Redo" TextAlignment="Center"/><TextBlock Text="Ctrl+Y" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Edit"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Click="ImportExcel_Click">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/import_excel.png"/><TextBlock Text="Import" TextAlignment="Center"/><TextBlock Text="Excel" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding RefreshExcelDataCommand}" ToolTip="Reload data from the linked Excel file and sheet">
                                <StackPanel><TextBlock Text="↻" FontSize="24" TextAlignment="Center"/><TextBlock Text="Update" TextAlignment="Center"/><TextBlock Text="Excel" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Data"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Click="PrinterSetup_Click">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/printer_setup.png"/><TextBlock Text="Printer" TextAlignment="Center"/><TextBlock Text="Setup" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Click="PrintPreview_Click">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/preview.png"/><TextBlock Text="Preview" TextAlignment="Center"/><TextBlock Text="Ctrl+P" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding PrintCurrentRowCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/print_current.png"/><TextBlock Text="Print" TextAlignment="Center"/><TextBlock Text="Current" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding PrintAllRowsCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/print_all_rows.png"/><TextBlock Text="Print" TextAlignment="Center"/><TextBlock Text="All Rows" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Click="PrintHistory_Click" ToolTip="Open the single print history Excel file">
                                <StackPanel><TextBlock Text="H" FontSize="22" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="Print" TextAlignment="Center"/><TextBlock Text="History" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding PrintCalibrationCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/test_print.png"/><TextBlock Text="Test" TextAlignment="Center"/><TextBlock Text="Print" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Printer"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <Button Style="{StaticResource RibbonButton}" Command="{Binding ShowAllPanelsCommand}">
                            <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/panels.png"/><TextBlock Text="Panels" TextAlignment="Center"/><TextBlock Text="restore" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="View"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <Button Style="{StaticResource RibbonButton}" Command="controls:LabelDesignerCanvas.DeleteSelectionCommand">
                            <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/delete_selection.png"/><TextBlock Text="Delete" TextAlignment="Center"/><TextBlock Text="Selection" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Edit object"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel>
                        <Button Style="{StaticResource RibbonButton}" Click="Help_Click">
                            <StackPanel><TextBlock Text="?" FontSize="24" FontWeight="Bold" TextAlignment="Center" Foreground="#2563EB"/><TextBlock Text="Help" TextAlignment="Center"/><TextBlock Text="F1" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center"/></StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Help"/>
                    </StackPanel>

                    <Border Width="1" Background="#E5EAF1" Margin="10,3"/>
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                            <Button Command="{Binding ZoomOutCommand}" Width="38" Height="38" Padding="6">
                                <Image Source="Icons/zoom_minus.png" Stretch="Uniform"/>
                            </Button>
                            <Border Width="58" Height="38" Margin="6,0" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>
                            <Button Command="{Binding ZoomInCommand}" Width="38" Height="38" Padding="6">
                                <Image Source="Icons/zoom_plus.png" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Zoom"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="30" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ZoomPercent, StringFormat=Zoom: {0}%}" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Image Style="{StaticResource SmallIconImage}" Source="Icons/zoom_minus.png"/>
                    <Slider Width="132" Minimum="0.25" Maximum="4" SmallChange="0.1" LargeChange="0.25" Value="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                    <Image Style="{StaticResource SmallIconImage}" Source="Icons/zoom_plus.png"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.Background>
                <VisualBrush TileMode="Tile" Viewport="0,0,600,300" ViewportUnits="Absolute">
                    <VisualBrush.Visual>
                        <TextBlock Text="cre: Duc An" FontSize="56" FontWeight="Bold" Foreground="#64748B" Opacity="0.18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsToolboxVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=294}"/>
                <ColumnDefinition Width="{Binding IsToolboxVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=6}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding IsPropertiesVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=6}"/>
                <ColumnDefinition Width="{Binding IsPropertiesVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=280}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12,12,0,12" Style="{StaticResource PanelCard}" Visibility="{Binding IsToolboxVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="318" MinHeight="260"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                        <DockPanel>
                            <TextBlock Text="Tools / Data" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelHeaderButton}" Command="{Binding HideToolboxCommand}" ToolTip="Hide toolbox">
                                <Image Style="{StaticResource SmallIconImage}" Source="Icons/collapse_chevron.png"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="8,8,8,8">
                        <UniformGrid Columns="2" Rows="3">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddTextCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/static_text.png"/><TextBlock Text="Static Text" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddTextBoxCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/text_box.png"/><TextBlock Text="Text Box" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddBarcodeCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/barcode.png"/><TextBlock Text="Barcode" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddLineCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/line.png"/><TextBlock Text="Line" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddRectangleCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/rectangle.png"/><TextBlock Text="Rectangle" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddEllipseCommand}">
                                <StackPanel><Image Style="{StaticResource IconImage}" Source="Icons/ellipse.png"/><TextBlock Text="Ellipse" TextAlignment="Center" FontSize="12"/></StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="{Binding DrawingCommandText}" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" TextWrapping="Wrap" Margin="4,8,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDrawingTool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                    <GridSplitter Grid.Row="2"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#EEF2F6"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True"/>

                    <Border Grid.Row="3" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" MinHeight="160">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Objects / Data Sources" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Image DockPanel.Dock="Right" Style="{StaticResource SmallIconImage}" Source="Icons/collapse_chevron.png"/>
                                </DockPanel>
                            </Border>
                            <TabControl BorderThickness="0" Padding="6">
                                <TabItem Header="Data Sources">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4,8">
                                    <TreeView Padding="0,0,0,8">
                                        <TreeViewItem IsExpanded="True">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal"><Image Source="Icons/folder.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Template"/></StackPanel>
                                            </TreeViewItem.Header>
                                            <TreeViewItem Header="{Binding Template.Name}"/>
                                            <TreeViewItem Header="{Binding Template.WidthMm, StringFormat={}{0:0.##} mm}"/>
                                            <TreeViewItem Header="{Binding Template.HeightMm, StringFormat={}{0:0.##} mm}"/>
                                        </TreeViewItem>
                                        <TreeViewItem IsExpanded="True" ItemsSource="{Binding Template.Objects}">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal"><Image Source="Icons/panels.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Objects"/></StackPanel>
                                            </TreeViewItem.Header>
                                            <TreeViewItem.ItemTemplate>
                                                <HierarchicalDataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource AppMutedBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding Path="Type"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <Border Padding="6,2" Margin="0,4,0,0" CornerRadius="4" HorizontalAlignment="Left" Background="#EAF3FF">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="#EAF3FF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BindingStateDisplayText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BindingStateDisplayText}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasBindingIssue}" Value="True">
                                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BindingStateDisplayText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Setter Property="Foreground" Value="{StaticResource AppBlueDarkBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasBindingIssue}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </HierarchicalDataTemplate>
                                            </TreeViewItem.ItemTemplate>
                                        </TreeViewItem>
                                        <TreeViewItem IsExpanded="True">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal"><Image Source="Icons/database.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Database"/></StackPanel>
                                            </TreeViewItem.Header>
                                            <TreeViewItem Header="{Binding LinkedExcelSourceText}"/>
                                            <TreeViewItem Header="{Binding CurrentExcelRowText}"/>
                                        </TreeViewItem>
                                    </TreeView>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <TextBlock Text="Use Import Excel on the top ribbon to choose a workbook and manage label fields." FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0"
                                            Visibility="{Binding HasExcelData, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Excel Rows" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentExcelRowText}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DataGrid ItemsSource="{Binding ExcelDataView}"
                                                      SelectedItem="{Binding SelectedDataItem, Mode=TwoWay}"
                                                      AutoGenerateColumns="True"
                                                      Height="190"
                                                      MaxHeight="240"
                                                      MinHeight="120"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Binding Issues" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                            <TextBlock Text="{Binding BindingIssuesSummary}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <ItemsControl ItemsSource="{Binding BindingIssues}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectBindingIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Margin="0,0,0,6"
                                                                Padding="8,7">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding MissingFieldsSummary}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding ErrorsSummary}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding IsToolboxVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Grid Grid.Column="2" Background="{StaticResource AppWorkspaceBrush}" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,1">
                    <TextBlock Text="mm" FontSize="11" Foreground="{StaticResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" IsHitTestVisible="False">
                        <Grid Margin="92,0,120,0" HorizontalAlignment="Left">
                            <controls:DesignerRuler LengthMm="{Binding Template.WidthMm}" Zoom="{Binding Zoom}" Orientation="Horizontal"
                                                    Width="{Binding ElementName=DesignerCanvas, Path=ActualWidth}" Height="26"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Focusable="False" IsHitTestVisible="False">
                        <Grid Margin="0,72,0,100" VerticalAlignment="Top">
                            <controls:DesignerRuler LengthMm="{Binding Template.HeightMm}" Zoom="{Binding Zoom}" Orientation="Vertical"
                                                    Width="38" Height="{Binding ElementName=DesignerCanvas, Path=ActualHeight}"/>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <ScrollViewer x:Name="DesignerScrollViewer"
                              Grid.Row="1" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="DesignerScrollViewer_PreviewMouseWheel"
                              Background="{StaticResource AppWorkspaceBrush}">
                    <Grid Margin="92,72,120,100">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <controls:LabelDesignerCanvas x:Name="DesignerCanvas"
                                                          Template="{Binding Template}"
                                                          SelectedObject="{Binding SelectedObject, Mode=TwoWay}"
                                                          PreviewRow="{Binding PreviewRow}"
                                                          DrawingTool="{Binding DrawingTool, Mode=TwoWay}"
                                                          DrawingCommandText="{Binding DrawingCommandText, Mode=TwoWay}"
                                                          Zoom="{Binding Zoom}"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding IsPropertiesVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Border Grid.Column="4" Margin="0,12,12,12" Style="{StaticResource PanelCard}" Visibility="{Binding IsPropertiesVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Height="42" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <DockPanel>
                            <TextBlock Text="Properties" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelHeaderButton}" Command="{Binding HidePropertiesCommand}" ToolTip="Hide properties">
                                <Image Style="{StaticResource SmallIconImage}" Source="Icons/collapse_chevron.png"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8" Background="#FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ZoomPercent, StringFormat=Zoom: {0}%}" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="-" Command="{Binding ZoomOutCommand}" Width="26" Height="26" Padding="0"/>
                            <Slider Grid.Column="2" Minimum="0.25" Maximum="4" SmallChange="0.1" LargeChange="0.25" Value="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="+" Command="{Binding ZoomInCommand}" Width="26" Height="26" Padding="0"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="240">
                                <Image Source="Icons/cursor_select.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="No object selected" FontWeight="SemiBold" FontSize="15" TextAlignment="Center"/>
                                <TextBlock Text="Select an object on the canvas to view and edit its properties." Foreground="{StaticResource AppMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Border Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,3" Margin="0,0,0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedObjectTypeText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/>
                                        <TextBlock Text="{Binding SelectedObjectSummaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,0,2">
                                    <StackPanel>
                                        <TextBlock Text="Content" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding LinkedExcelSourceText}" Foreground="{StaticResource AppMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        <TextBlock Text="Source" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/>
                                        <ComboBox x:Name="ContentSourceComboBox" SelectionChanged="ContentSourceComboBox_SelectionChanged" SelectedIndex="0" Margin="0,1,0,2">
                                            <ComboBoxItem Content="Text" Tag="Static"/>
                                            <ComboBoxItem Content="Excel Field" Tag="Excel"/>
                                        </ComboBox>
                                        <StackPanel>
                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=ContentSourceComboBox}" Value="Excel"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=ContentSourceComboBox}" Value="Binding"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                            <TextBlock Text="Text" Foreground="{StaticResource AppMutedBrush}"/>
                                            <TextBox x:Name="ObjectTextBox" Text="{Binding SelectedObject.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,3,0,0" PreviewTextInput="ObjectTextBox_PreviewTextInput"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=ContentSourceComboBox}" Value="Excel"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                            <TextBlock Text="Excel field" Foreground="{StaticResource AppMutedBrush}"/>
                                            <ComboBox x:Name="ExcelFieldComboBox"
                                                      ItemsSource="{Binding LabelDatabaseFields}"
                                                      SelectedItem="{Binding SelectedLabelDatabaseField, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="ExcelFieldComboBox_SelectionChanged"
                                                      Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BarcodeValidationMessage}" Foreground="{StaticResource AppDangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,0,2">
                                    <StackPanel>
                                        <TextBlock Text="Transform" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Rotation" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/>
                                        <ComboBox SelectedValue="{Binding SelectedObject.Rotation, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,1,0,0">
                                            <ComboBoxItem Content="0°" Tag="0"/>
                                            <ComboBoxItem Content="90°" Tag="90"/>
                                            <ComboBoxItem Content="180°" Tag="180"/>
                                            <ComboBoxItem Content="270°" Tag="270"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Text}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.TextBox}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Text Style" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Font" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/>
                                        <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedObject.Style.FontFamily, Mode=TwoWay}" Margin="0,1,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Size" Foreground="{StaticResource AppMutedBrush}" FontSize="11"/>
                                                <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedObject.Style.FontSizePt, Mode=TwoWay}" Margin="0,2,0,5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Align" Foreground="{StaticResource AppMutedBrush}" FontSize="11"/>
                                                <ComboBox ItemsSource="{Binding TextAlignments}" SelectedItem="{Binding SelectedObject.Style.Alignment, Mode=TwoWay}" Margin="0,2,0,5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,0">
                                                <CheckBox Content="Bold" IsChecked="{Binding SelectedObject.Style.Bold, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <CheckBox Content="Italic" IsChecked="{Binding SelectedObject.Style.Italic, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <CheckBox Content="Underline" IsChecked="{Binding SelectedObject.Style.Underline, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding TextBoxValidationMessage}" Foreground="{StaticResource AppDangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,0,2">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.BarcodeCode128}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.QRCode}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.DataMatrix}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Barcode" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <StackPanel Grid.ColumnSpan="3"><TextBlock Text="Standard" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding Source={StaticResource GroupedBarcodeSymbologies}}" SelectedValue="{Binding SelectedObject.BarcodeSymbology, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="0,1,0,3"><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#EAF3FF" Padding="6,3" Margin="0,4,0,2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox></StackPanel>
                                            <StackPanel Grid.Row="1"><TextBlock Text="QR mode" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding QrSizingModeOptions}" SelectedValue="{Binding SelectedObject.QrSizingMode, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="0,1,0,0"/></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="EC level" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding QrErrorCorrectionOptions}" SelectedValue="{Binding SelectedObject.QrErrorCorrection, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="0,1,0,0"/></StackPanel>
                                        </Grid>
                                        <!-- Text & DPI: compact single row -->
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="Text" IsChecked="{Binding SelectedObject.ShowBarcodeText, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="Pt" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                                            <TextBox Grid.Column="2" Text="{Binding SelectedObject.BarcodeTextFontSizePt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Width="30" MinHeight="22" FontSize="11"/>
                                            <TextBlock Grid.Column="4" Text="DPI" Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                                            <TextBox Grid.Column="5" Text="{Binding SelectedObject.QrDpi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" MinHeight="22" FontSize="11"/>
                                        </Grid>
                                        <!-- Fixed Size: inline, only when not AutoSize -->
                                        <Border Margin="0,3,0,0" Padding="0" BorderThickness="0">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedObject.QrSizingMode}" Value="{x:Static barcode:QrSizingMode.AutoSizeByData}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="Fixed Size" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Version" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding QrVersionOptions}" SelectedValue="{Binding SelectedObject.QrFixedVersion, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="0,1,0,0" MaxDropDownHeight="320"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Module px" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding QrModuleSizePxOptions}" SelectedItem="{Binding SelectedObject.QrModuleSizePx, Mode=TwoWay}" Margin="0,1,0,0"/></StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedBinding}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Binding" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedBindingKindText, StringFormat=Source type: {0}}" FontSize="10" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedBindingStatusText}" FontSize="10" Foreground="{StaticResource AppBlueDarkBrush}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                        <TextBlock Text="Preview" Foreground="{StaticResource AppMutedBrush}" FontSize="10"/>
                                        <TextBox Text="{Binding SelectedBindingPreviewValue, Mode=OneWay}" IsReadOnly="True" MinHeight="22" Margin="0,1,0,2"/>
                                        <TextBlock Text="{Binding SelectedBindingUsedFieldsSummary}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedBindingMissingFieldsSummary}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding SelectedBindingErrorsText}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5" Margin="0,0,0,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedBindingFormula}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Formula Output" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppBlueDarkBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Output" Foreground="{StaticResource AppMutedBrush}" FontSize="11"/>
                                        <TextBox Text="{Binding FormulaPreviewValue, Mode=OneWay}" IsReadOnly="True" MinHeight="26" Margin="0,2,0,4"/>
                                        <TextBlock Text="{Binding FormulaPreviewUsedFields, StringFormat=Used fields: {0}}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FormulaPreviewErrors}" FontSize="11" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
