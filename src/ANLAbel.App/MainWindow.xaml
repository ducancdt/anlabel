                                    <TabItem AutomationProperties.Name="Source properties">
                                        <!-- NiceLabel 10 shows no Source page for a shape (line, rectangle, ellipse, inverse) -->
                                        <TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource PanelTabItem}"><Style.Triggers><DataTrigger Binding="{Binding IsShapeObjectSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabItem.Style>
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Nguồn"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem AutomationProperties.Name="Style properties">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- A barcode's page is "Mã vạch", as NiceLabel 10 names it (Source · Barcode · Position · General). -->
                                                <TextBlock>
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Kiểu"/><Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.BarcodeCode128}"><Setter Property="Text" Value="Mã vạch"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.QRCode}"><Setter Property="Text" Value="Mã vạch"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.DataMatrix}"><Setter Property="Text" Value="Mã vạch"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Image}"><Setter Property="Text" Value="Đổi cỡ"/></DataTrigger>
                                                    </Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem AutomationProperties.Name="Position properties">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Vị trí"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem AutomationProperties.Name="General properties">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Chung"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                </TabControl>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=PropertiesModeTabs}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <Border Style="{StaticResource PropCard}" Background="#F8FAFC">
                                    <Expander IsExpanded="True" FontSize="11" Foreground="{StaticResource AppBlueDarkBrush}">
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock Text="Vị trí &amp; kích thước" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="10" Foreground="{StaticResource AppMutedBrush}" Margin="0,2,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:0.##}, {1:0.##} · {2:0.##} × {3:0.##} mm">
                                                            <Binding Path="SelectedObject.XMm"/>
                                                            <Binding Path="SelectedObject.YMm"/>
                                                            <Binding Path="SelectedObject.WidthMm"/>
                                                            <Binding Path="SelectedObject.HeightMm"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,6,0,0">
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Line}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="X" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.XMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Y" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.YMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Rộng" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.WidthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Cao" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.HeightMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding SelectedObject.Rotation, StringFormat=Xoay (hiện tại: {0}°)}" Style="{StaticResource PropLabel}" Margin="0,6,0,1"/>
                                            <UniformGrid Columns="4" Margin="0,0,0,2">
                                                <Button Content="0°" Command="{Binding SetRotationCommand}" CommandParameter="0" Padding="4,5" FontSize="11" Margin="0,0,2,0"/>
                                                <Button Content="90°" Command="{Binding SetRotationCommand}" CommandParameter="90" Padding="4,5" FontSize="11" Margin="2,0,2,0"/>
                                                <Button Content="180°" Command="{Binding SetRotationCommand}" CommandParameter="180" Padding="4,5" FontSize="11" Margin="2,0,2,0"/>
                                                <Button Content="270°" Command="{Binding SetRotationCommand}" CommandParameter="270" Padding="4,5" FontSize="11" Margin="2,0,0,0"/>
                                            </UniformGrid>
                                            <TextBlock Text="Điểm neo" Style="{StaticResource PropLabel}" Margin="0,6,0,1"/>
                                            <UniformGrid Columns="3" Rows="3" HorizontalAlignment="Left" ToolTip="Điểm đứng yên khi đối tượng đổi kích thước theo nội dung">
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo trên trái" AutomationProperties.Name="Properties anchor TopLeft" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.TopLeft}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo trên giữa" AutomationProperties.Name="Properties anchor TopCenter" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.TopCenter}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo trên phải" AutomationProperties.Name="Properties anchor TopRight" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.TopRight}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo giữa trái" AutomationProperties.Name="Properties anchor MiddleLeft" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.MiddleLeft}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo giữa" AutomationProperties.Name="Properties anchor Center" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.Center}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo giữa phải" AutomationProperties.Name="Properties anchor MiddleRight" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.MiddleRight}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo dưới trái" AutomationProperties.Name="Properties anchor BottomLeft" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.BottomLeft}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo dưới giữa" AutomationProperties.Name="Properties anchor BottomCenter" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.BottomCenter}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                                <RadioButton Style="{StaticResource RibbonIconRadio}" Width="20" Height="20" GroupName="PropertiesAnchor" ToolTip="Neo dưới phải" AutomationProperties.Name="Properties anchor BottomRight" IsChecked="{Binding SelectedObject.AnchorPoint, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static enums:ObjectAnchorPoint.BottomRight}}"><Ellipse Width="6" Height="6" Fill="#1F4E8C"/></RadioButton>
                                            </UniformGrid>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedObject.Type}" Value="{x:Static enums:ObjectType.Line}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="X1" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.XMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Y1" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.YMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="X2" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.LineEndXMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Y2" Style="{StaticResource PropLabel}"/>
                                                    <TextBox Text="{Binding SelectedObject.LineEndYMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="PositionSizeTextBox_KeyDown"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <!-- NiceLabel 10 Position page: the position lock and the aspect ratio sit with the position. -->
                                        <WrapPanel Margin="0,8,0,0">
                                            <CheckBox Content="Khóa vị trí" IsChecked="{Binding SelectionLocked, Mode=TwoWay}" Margin="0,0,18,0"
                                                      ToolTip="Không kéo hay đổi cỡ được trên mặt thiết kế; vẫn in như thường" AutomationProperties.Name="Position locked"/>
                                            <CheckBox Content="Giữ tỉ lệ" IsChecked="{Binding SelectionKeepsAspectRatio, Mode=TwoWay}"
                                                      ToolTip="Kéo khung luôn giữ tỉ lệ rộng/cao" AutomationProperties.Name="Keep aspect ratio"/>
                                        </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=PropertiesModeTabs}" Value="3">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <!-- NiceLabel 10 General page: the name, printing and visibility of the object. -->
                                <Border Style="{StaticResource PropCard}">
                                    <StackPanel>
                                        <TextBlock Text="Chung" Style="{StaticResource PropTitle}"/>
                                        <TextBlock Text="Tên" Style="{StaticResource PropLabel}"/>
                                        <TextBox Text="{Binding SelectedObjectName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="PositionSizeTextBox_KeyDown" AutomationProperties.Name="Object name"/>
                                        <TextBlock Text="{Binding ObjectNameMessage}" Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ObjectNameMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ObjectNameMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,8,0,0">
                                            <CheckBox Content="Không in" IsChecked="{Binding SelectionNotPrinted, Mode=TwoWay}" Margin="0,0,18,0"
                                                      ToolTip="Đối tượng vẫn hiện khi thiết kế nhưng không có trong bản in và xem trước" AutomationProperties.Name="Not printable"/>
                                            <CheckBox Content="Hiển thị" IsChecked="{Binding SelectionShown, Mode=TwoWay}" AutomationProperties.Name="Visible"/>
                                        </WrapPanel>
                                        <TextBlock Text="Điều kiện hiển thị" Style="{StaticResource PropLabel}" Margin="0,8,0,1"/>
                                        <TextBox Text="{Binding SelectedObject.VisibilityCondition, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="PositionSizeTextBox_KeyDown"
                                                 AutomationProperties.Name="Visibility condition in Properties"/>
                                        <TextBlock Text="Trường hoặc công thức, ví dụ {Lô} hoặc EQUALS(FIELD(&quot;Loại&quot;), &quot;QR&quot;). Đối tượng chỉ in ở dòng có giá trị khác rỗng, 0, false, không. Để trống: luôn in."
                                                   TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource AppMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PropCard}">
                                    <Expander IsExpanded="False" FontSize="11" Foreground="{StaticResource AppBlueDarkBrush}">
                                    <Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="Nâng cao" FontWeight="SemiBold"/>
                                            <TextBlock Text="Căn · sắp xếp · lớp" FontSize="10" Foreground="{StaticResource AppMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Mốc căn chỉnh" Style="{StaticResource PropLabel}" Margin="0,0,0,1"/>
                                        <ComboBox x:Name="ArrangeReferenceCombo" SelectedIndex="0" Margin="0,0,0,4">
                                            <ComboBoxItem Content="Khung vùng chọn" Tag="SelectionBounds"/>
                                            <ComboBoxItem Content="Đối tượng mốc (đang chọn)" Tag="KeyObject"/>
                                            <ComboBoxItem Content="Khung tem" Tag="Canvas"/>
                                        </ComboBox>
                                        <TextBlock Text="Căn đối tượng" Style="{StaticResource PropLabel}"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,3">
                                            <Button Content="Trái" Tag="Left" Click="ArrangeAlign_Click" Padding="3,4" FontSize="10" Margin="0,0,2,0"/>
                                            <Button Content="Giữa" Tag="HorizontalCenter" Click="ArrangeAlign_Click" Padding="3,4" FontSize="10" Margin="1,0,1,0"/>
                                            <Button Content="Phải" Tag="Right" Click="ArrangeAlign_Click" Padding="3,4" FontSize="10" Margin="2,0,0,0"/>
                                            <Button Content="Trên" Tag="Top" Click="ArrangeAlign_Click" Padding="3,4" FontSize="10" Margin="0,2,2,0"/>
                                            <Button Content="Giữa (dọc)" Tag="VerticalCenter" Click="ArrangeAlign_Click" Padding="3,4" FontSize="10" Margin="1,2,1,0"/>
                                            <Button Content="Dưới" Tag="Bottom" Click="ArrangeAlign_Click" Padding="3,4" FontSize="10" Margin="2,2,0,0"/>
                                        </UniformGrid>
                                        <Button Content="Căn đường cơ sở chữ" Click="ArrangeBaseline_Click" Padding="3,4" FontSize="10" Margin="0,0,0,3" ToolTip="Căn đường cơ sở đầu tiên của các đối tượng Chữ/Ô chữ đã chọn theo đối tượng chữ mốc"/>
                                        <Button Content="Tâm mực quang học" Click="ArrangeOptical_Click" Padding="3,4" FontSize="10" Margin="0,0,0,3" ToolTip="Căn rõ tâm mực nét chữ nhìn thấy; khác với căn theo khung hoặc đường cơ sở"/>
                                        <TextBlock Text="Phân bố (3+ đối tượng)" Style="{StaticResource PropLabel}" Margin="0,4,0,1"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,4">
                                            <Button Content="Tâm theo chiều ngang" Tag="HorizontalCenters" Click="ArrangeDistribute_Click" Padding="3,4" FontSize="10" Margin="0,0,2,0"/>
                                            <Button Content="Tâm theo chiều dọc" Tag="VerticalCenters" Click="ArrangeDistribute_Click" Padding="3,4" FontSize="10" Margin="2,0,0,0"/>
                                            <Button Content="Khoảng cách ngang" Tag="HorizontalGaps" Click="ArrangeDistribute_Click" Padding="3,4" FontSize="10" Margin="0,2,2,0"/>
                                            <Button Content="Khoảng cách dọc" Tag="VerticalGaps" Click="ArrangeDistribute_Click" Padding="3,4" FontSize="10" Margin="2,2,0,0"/>
                                        </UniformGrid>
                                        <TextBlock Text="Thứ tự lớp" Style="{StaticResource PropLabel}"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Command="{Binding BringToFrontCommand}" Padding="6,5" FontSize="11" AutomationProperties.Name="Lên trên cùng"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.BringToFront16}" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Lên trên cùng" VerticalAlignment="Center"/></StackPanel></Button>
                                            <Button Grid.Column="2" Command="{Binding SendToBackCommand}" Padding="6,5" FontSize="11" AutomationProperties.Name="Xuống dưới cùng"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.SendToBack16}" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Xuống dưới cùng" VerticalAlignment="Center"/></StackPanel></Button>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Content="Đưa lên trước" Command="{Binding BringForwardCommand}" Padding="6,5" FontSize="11"/>
                                            <Button Grid.Column="2" Content="Đưa ra sau" Command="{Binding SendBackwardCommand}" Padding="6,5" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                    </Expander>
                                </Border>
                                </StackPanel>

                                <!-- Shapes have no content or data source (NiceLabel 10 shows no Source page for them) -->
                                <!-- NiceLabel 10 picture Source: the picture is embedded; its pixels, resolution and original size -->
                                <Border AutomationProperties.AutomationId="Shell.Properties.PictureSource">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PropCard}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedIndex, ElementName=PropertiesModeTabs}" Value="0"/>
                                                        <Condition Binding="{Binding IsImageObjectSelected}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Nguồn ảnh" Style="{StaticResource PropTitle}"/>
                                        <TextBlock Text="{Binding SelectedPictureSourceText}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource AppMutedBrush}" Margin="0,0,0,6"/>
                                        <Button Content="Chọn hình ảnh..." Command="{Binding ReplaceSelectedImageCommand}" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Chính sách ảnh điểm" Style="{StaticResource PropLabel}" Margin="0,8,0,1"/>
                                        <ComboBox ItemsSource="{Binding ImageRasterModes}" ItemTemplate="{StaticResource DisplayNameItem}"
