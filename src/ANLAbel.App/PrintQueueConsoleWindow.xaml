<Window x:Class="ANLAbel.App.PrintQueueConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel - Print Queue Console"
        Width="1120" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.AutomationId="CC.P2.QueueConsole.Root" AutomationProperties.Name="Print queue console">
    <Window.Resources>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#D9E2EC"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="#64748B"/>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" MinWidth="100" Content="{Binding RefreshButtonText}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"
                    AutomationProperties.AutomationId="CC.P2.QueueConsole.Refresh" AutomationProperties.Name="Refresh printer queues"/>
            <StackPanel>
                <TextBlock Text="Print Queue Console" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="Read-only Local and Connections discovery. A default marker never selects a queue or enables a command." Margin="0,4,0,0" Foreground="{StaticResource AppMutedBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0" AutomationProperties.AutomationId="CC.P2.QueueConsole.Status">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/><TextBlock Text="  •  " Foreground="{StaticResource AppMutedBrush}"/><TextBlock Text="{Binding RefreshedAtText}" Foreground="{StaticResource AppMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                    AutomationProperties.AutomationId="CC.P2.QueueConsole.Filters" AutomationProperties.Name="Queue filters">
                <StackPanel>
                    <TextBlock Text="Filters" FontWeight="SemiBold" FontSize="15"/>
                    <TextBox Margin="0,10,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search queue name or driver"
                             AutomationProperties.AutomationId="CC.P2.QueueConsole.Search" AutomationProperties.Name="Search printer queues"/>
                    <ListBox Margin="0,10,0,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"/>
                    <Separator Margin="0,12,0,12"/>
                    <TextBlock Text="Queue commands" FontWeight="SemiBold"/>
                    <TextBlock Text="Unavailable until a separate capability, confirmation, timeout and durable-outcome contract exists." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource AppMutedBrush}"
                               AutomationProperties.AutomationId="CC.P2.QueueConsole.Commands" AutomationProperties.Name="Queue commands unavailable"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                          AutomationProperties.AutomationId="CC.P2.QueueConsole.QueueTable" AutomationProperties.Name="Discovered printer queues">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Queue" Binding="{Binding QueueName}" Width="*"/>
                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="180"/>
                        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="70"/>
                        <DataGridTextColumn Header="Saved relation" Binding="{Binding SavedRelation}" Width="155"/>
                        <DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="130"/>
                        <DataGridTextColumn Header="Observed" Binding="{Binding ObservedAtUtc, StringFormat={}{0:HH:mm:ss}}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8"
                        AutomationProperties.AutomationId="CC.P2.QueueConsole.Detail" AutomationProperties.Name="Selected queue evidence">
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Foreground="{StaticResource AppMutedBrush}"/>
                </Border>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" MinWidth="84" Click="Close_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Printer Setup" Margin="0,0,8,0" Click="PrinterSetup_Click" AutomationProperties.AutomationId="CC.P2.QueueConsole.OpenPrinterSetup" AutomationProperties.Name="Open Printer Setup"/>
                <Button Content="Print Center" Margin="0,0,8,0" Click="PrintCenter_Click" AutomationProperties.AutomationId="CC.P2.QueueConsole.OpenPrintCenter" AutomationProperties.Name="Open Print Center"/>
                <Button Content="Print History" Click="History_Click" AutomationProperties.AutomationId="CC.P2.QueueConsole.OpenHistory" AutomationProperties.Name="Open Print History"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
