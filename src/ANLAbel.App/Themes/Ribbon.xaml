<!-- NiceLabel 10 shell look (docs/NICELABEL_10_UI_LAYOUT.md, "Shell rebuild"): navy title bar and
     tab row, light grey ribbon body, 32 DIP large buttons with the caption under the icon,
     16 DIP small buttons with the caption beside it, group captions on the bottom edge.
     Colours were measured on NiceLabel 10 screenshots; the selected-tab text and the
     contextual-tab fill are darkened to reach WCAG AA 4.5:1. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ANLAbel.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ANLAbel.App;component/Themes/RibbonIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="RibbonChromeBrush" Color="#0E1D77"/>
    <SolidColorBrush x:Key="RibbonChromeHoverBrush" Color="#2A3A93"/>
    <SolidColorBrush x:Key="RibbonChromePressedBrush" Color="#3A4CA6"/>
    <SolidColorBrush x:Key="RibbonChromeTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RibbonFileTabTextBrush" Color="#94D7F0"/>
    <SolidColorBrush x:Key="RibbonContextTabBrush" Color="#3D6FC4"/>
    <SolidColorBrush x:Key="RibbonContextTabHoverBrush" Color="#5281CF"/>
    <SolidColorBrush x:Key="RibbonBodyBrush" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="RibbonLineBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="RibbonTextBrush" Color="#262626"/>
    <SolidColorBrush x:Key="RibbonCaptionBrush" Color="#666666"/>
    <SolidColorBrush x:Key="RibbonDisabledTextBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="RibbonSelectedTabTextBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="RibbonHoverBrush" Color="#DCEAF8"/>
    <SolidColorBrush x:Key="RibbonHoverBorderBrush" Color="#A5C8EA"/>
    <SolidColorBrush x:Key="RibbonPressedBrush" Color="#BCD6F1"/>
    <SolidColorBrush x:Key="RibbonPressedBorderBrush" Color="#77A9DB"/>
    <SolidColorBrush x:Key="RibbonCheckedBrush" Color="#C6DEF5"/>
    <SolidColorBrush x:Key="RibbonCheckedBorderBrush" Color="#7FAEDB"/>

    <!-- Tabs ............................................................................ -->
    <Style x:Key="RibbonTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource RibbonChromeTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,2,1,0"/>
        <Setter Property="Padding" Value="13,3,13,4"/>
        <Setter Property="GroupName" Value="RibbonTabs"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonBodyBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonLineBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource RibbonSelectedTabTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Contextual tabs (Thiết kế, Chữ, Mã vạch, ...): a lighter blue block, as in NiceLabel 10 -->
    <Style x:Key="RibbonContextTab" TargetType="RadioButton" BasedOn="{StaticResource RibbonTab}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource RibbonContextTabBrush}" BorderBrush="{StaticResource RibbonContextTabBrush}" BorderThickness="1,1,1,0"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonContextTabHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonBodyBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonLineBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource RibbonSelectedTabTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Tệp": NiceLabel's File tab opens the backstage; light cyan text on the navy row -->
    <Style x:Key="RibbonFileTab" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource RibbonFileTabTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,2,1,0"/>
        <Setter Property="Padding" Value="15,3,15,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromeHoverBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar: quick access glyphs and the window buttons ............................ -->
    <Style x:Key="ChromeGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="QuickAccessButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource RibbonChromeTextBrush}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,1,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource RibbonChromeTextBrush}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1707A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon body ............................................................................ -->
    <Style x:Key="RibbonPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="3,3,3,0"/>
    </Style>

    <Style TargetType="controls:RibbonGroupPanel">
        <Setter Property="GroupHeight" Value="86"/>
        <Setter Property="Margin" Value="3,0,3,0"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>

    <Style x:Key="RibbonGroupCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource RibbonCaptionBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,1,4,3"/>
    </Style>

    <Style x:Key="RibbonGroupSeparator" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{StaticResource RibbonLineBrush}"/>
        <Setter Property="Margin" Value="1,2,1,5"/>
    </Style>

    <!-- A column of small items (three rows of 22 DIP, as in NiceLabel) -->
    <Style x:Key="RibbonColumn" TargetType="StackPanel">
        <Setter Property="Margin" Value="1,1,1,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- Large button: 32 DIP icon over a one- or two-line caption ("Tùy chỉnh&#10;in ▾") -->
    <Style x:Key="RibbonLargeButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Height" Value="66"/>
        <Setter Property="Margin" Value="1,1,1,0"/>
        <Setter Property="Padding" Value="4,0,4,1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel>
                            <Image x:Name="Icon" Source="{TemplateBinding controls:Ribbon.Icon}" Width="32" Height="32" Margin="0,2,0,1" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                       TextAlignment="Center" LineHeight="14" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonCheckedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonCheckedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonPressedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.38"/>
                            <Setter Property="Foreground" Value="{StaticResource RibbonDisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large split button: the icon runs the command, the caption with ▾ opens the menu -->
    <Style TargetType="controls:RibbonSplitButton">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Height" Value="66"/>
        <Setter Property="Margin" Value="1,1,1,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:RibbonSplitButton">
                    <Border x:Name="Frame" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="Main" DockPanel.Dock="Top" Background="Transparent" Padding="4,2,4,0">
                                <Image x:Name="Icon" Source="{TemplateBinding controls:Ribbon.Icon}" Width="32" Height="32" HorizontalAlignment="Center"/>
                            </Border>
                            <Button x:Name="PART_DropDown" Focusable="False" Foreground="{TemplateBinding Foreground}"
                                    AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}: tùy chọn}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Part" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,1,0,0" Padding="4,0,4,1">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Part" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                                                <Setter TargetName="Part" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Part" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                                           TextAlignment="Center" LineHeight="14" LineStackingStrategy="BlockLineHeight"/>
                            </Button>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger SourceName="Main" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Main" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Main" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.38"/>
                            <Setter Property="Foreground" Value="{StaticResource RibbonDisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small button: 16 DIP icon and the caption beside it, 22 DIP high -->
    <Style x:Key="RibbonSmallButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="3,0,6,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <Image x:Name="Icon" Source="{TemplateBinding controls:Ribbon.Icon}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonCheckedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonCheckedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonPressedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.38"/>
                            <Setter Property="Foreground" Value="{StaticResource RibbonDisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only small button (Căn chỉnh grid, B / I / U / S, alignment): 24 x 22 DIP -->
    <Style x:Key="RibbonIconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
                        <Grid>
                            <Image x:Name="Icon" Source="{TemplateBinding controls:Ribbon.Icon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonCheckedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonCheckedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonPressedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.38"/>
                            <Setter Property="Foreground" Value="{StaticResource RibbonDisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="2,0,8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource RibbonDisabledTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RibbonComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="5,1,4,1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#ABADB3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RibbonTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="#ABADB3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 16 DIP icon in a drop-down menu item -->
    <Style x:Key="RibbonMenuIcon" TargetType="Image">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- Font colour drop-down (NiceLabel 10 Font group): an "A" over the colour bar -->
    <DataTemplate x:Key="RibbonTextColorItem">
        <StackPanel Width="18" Margin="0,1,0,0">
            <TextBlock Text="A" FontSize="11" FontWeight="SemiBold" Foreground="#262626" HorizontalAlignment="Center" LineHeight="11" LineStackingStrategy="BlockLineHeight"/>
            <Border Height="4" Margin="1,1,1,0" Background="{Binding}" BorderBrush="#8C8C8C" BorderThickness="0.5"/>
        </StackPanel>
    </DataTemplate>

    <!-- Backstage (Tệp), NiceLabel 10 / DevExpress backstage: navy item list on the left, pages on #F1F1F1 -->
    <SolidColorBrush x:Key="BackstagePageBrush" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="BackstageItemHoverBrush" Color="#25368F"/>
    <SolidColorBrush x:Key="BackstageItemCheckedBrush" Color="#3249AC"/>

    <Style x:Key="BackstageBackButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="18,14,0,18"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="#FFFFFF" StrokeThickness="2" Fill="Transparent"/>
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource BackstageItemCheckedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackstageCommand" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="22,9,22,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackstageItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackstageItemCheckedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#8F9AD0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackstageTab" TargetType="RadioButton" BasedOn="{StaticResource BackstageCommand}">
        <Setter Property="GroupName" Value="BackstagePages"/>
    </Style>

    <Style x:Key="BackstageSeparator" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#3B4BA0"/>
        <Setter Property="Margin" Value="22,8,22,8"/>
    </Style>

    <Style x:Key="BackstagePageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Light"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="BackstageCard" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#DCDCE2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style x:Key="BackstageCardHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#606472"/>
    </Style>

    <!-- Landing-page action: 24 DIP icon and a bold caption, frameless -->
    <Style x:Key="BackstageLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="6,6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{TemplateBinding controls:Ribbon.Icon}" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Backstage page tile (NiceLabel Open → Browse): 48 DIP icon, title and a line of description (Tag) -->
    <Style x:Key="BackstageTileButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="Width" Value="380"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{TemplateBinding controls:Ribbon.Icon}" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource RibbonCaptionBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackstagePrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource RibbonChromeBrush}"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonChromePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackstageSecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Recent document row: frameless, highlighted on hover -->
    <Style x:Key="BackstageListButton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down panel of a ribbon ▾ toggle (Vạch bao, Chi tiết mã, Màu viền, ...) -->
    <Style x:Key="RibbonPopupPanel" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource RibbonLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>

    <ItemsPanelTemplate x:Key="RibbonSwatchPanel">
        <WrapPanel/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="RibbonColorSwatch">
        <Border Width="20" Height="20" Margin="1" Background="{Binding}" BorderBrush="#8C8C8C" BorderThickness="1" ToolTip="{Binding}"/>
    </DataTemplate>

    <!-- Toolbox tile (NiceLabel 10 toolbox): a 32 DIP icon over its name, flat until hovered -->
    <Style x:Key="ToolboxTile" TargetType="ButtonBase" BasedOn="{StaticResource RibbonLargeButton}">
        <Setter Property="Height" Value="62"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
</ResourceDictionary>
