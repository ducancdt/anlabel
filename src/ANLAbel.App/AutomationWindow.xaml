<Window x:Class="ANLAbel.App.AutomationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Tự động cục bộ" Width="900" Height="600" MinWidth="720" MinHeight="460" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" AutomationProperties.AutomationId="CC.P8.Automation.Root" AutomationProperties.Name="Local automation">
<Window.Resources><SolidColorBrush x:Key="Border" Color="#D9E2EC"/><SolidColorBrush x:Key="Muted" Color="#64748B"/><Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Làm mới bằng chứng" Click="Refresh_Click" AutomationProperties.AutomationId="CC.P8.Automation.Refresh"/><StackPanel><TextBlock Text="Tự động cục bộ" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Chỉ bảng bằng chứng — không theo dõi, không tiêu thụ tệp, không gọi hàng đợi hay in tự động" Margin="0,5,0,0" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
<ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Vòng đời" FontWeight="SemiBold"/><TextBlock Text="{Binding LifecycleStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.StatusFilter"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cấu hình kích hoạt" FontWeight="SemiBold"/><TextBlock Text="{Binding ConfigurationStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.Configuration"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bằng chứng yêu cầu bền" FontWeight="SemiBold"/><TextBlock Text="{Binding EventStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.EventList"/><ItemsControl ItemsSource="{Binding RecentEvents}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding LocalTime}"/><Run Text=" · "/><Run Text="{Binding State}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding EventFingerprint}"/><Run Text=" · "/><Run Text="{Binding Reason}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding EventDetail}" Margin="0,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.EventDetail"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Background="#FFF7ED" BorderBrush="#FDBA74"><StackPanel><TextBlock Text="Ranh giới điều phối" FontWeight="SemiBold"/><TextBlock Text="Khởi động bộ theo dõi cục bộ, di chuyển/cách ly tệp, chọn tài liệu hoặc hàng đợi, và điều phối lệnh in được cố ý vô hiệu cho tới khi có quyết định chủ sở hữu và tích hợp chính sách in dùng chung." Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></ScrollViewer>
<DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Đóng" DockPanel.Dock="Right" Click="Close_Click"/><Button Content="Bắt đầu theo dõi chỉ phát hiện" Click="Start_Click" AutomationProperties.AutomationId="CC.P8.Automation.Start"/><Button Content="Dừng theo dõi" Margin="8,0,0,0" Click="Stop_Click" AutomationProperties.AutomationId="CC.P8.Automation.Stop"/><Button Content="Nhận bằng chứng đã phát hiện" Margin="8,0,0,0" Click="Claim_Click" AutomationProperties.AutomationId="CC.P8.Automation.Claim"/><Button Content="Kiểm tra chính sách mẫu tem" Margin="8,0,0,0" Click="ValidateTemplate_Click" AutomationProperties.AutomationId="CC.P8.Automation.ValidateTemplate"/><Button Content="Cấu hình kích hoạt cục bộ" Margin="8,0,0,0" Click="Configure_Click" AutomationProperties.AutomationId="CC.P8.Automation.Configure"/><Button Content="Mở Lịch sử" Margin="8,0,0,0" Click="History_Click" AutomationProperties.AutomationId="CC.P8.Automation.OpenHistory"/><Button Content="Mở Trung tâm in" Margin="8,0,0,0" Click="PrintCenter_Click" AutomationProperties.AutomationId="CC.P8.Automation.OpenPrintCenter"/></DockPanel></Grid></Window>
