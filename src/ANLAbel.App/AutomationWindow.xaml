<Window x:Class="ANLAbel.App.AutomationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Local Automation" Width="900" Height="600" MinWidth="720" MinHeight="460" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" AutomationProperties.AutomationId="CC.P8.Automation.Root" AutomationProperties.Name="Local automation">
<Window.Resources><SolidColorBrush x:Key="Border" Color="#D9E2EC"/><SolidColorBrush x:Key="Muted" Color="#64748B"/><Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Refresh evidence" Click="Refresh_Click" AutomationProperties.AutomationId="CC.P8.Automation.Refresh"/><StackPanel><TextBlock Text="Local Automation" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Evidence console only — no watcher, file consumption, queue call or automatic print" Margin="0,5,0,0" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
<ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Lifecycle" FontWeight="SemiBold"/><TextBlock Text="{Binding LifecycleStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.StatusFilter"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Trigger configuration" FontWeight="SemiBold"/><TextBlock Text="{Binding ConfigurationStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.Configuration"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Durable claim evidence" FontWeight="SemiBold"/><TextBlock Text="{Binding EventStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.EventList"/><ItemsControl ItemsSource="{Binding RecentEvents}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding LocalTime}"/><Run Text=" · "/><Run Text="{Binding State}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding EventFingerprint}"/><Run Text=" · "/><Run Text="{Binding Reason}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding EventDetail}" Margin="0,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P8.Automation.EventDetail"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Background="#FFF7ED" BorderBrush="#FDBA74"><StackPanel><TextBlock Text="Dispatch boundary" FontWeight="SemiBold"/><TextBlock Text="Starting a local watcher, moving/quarantining files, selecting a document or queue, and dispatching a print job are deliberately unavailable until their owner decisions and shared print-policy integration are implemented." Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></ScrollViewer>
<DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Close" DockPanel.Dock="Right" Click="Close_Click"/><Button Content="Start detect-only watcher" Click="Start_Click" AutomationProperties.AutomationId="CC.P8.Automation.Start"/><Button Content="Stop watcher" Margin="8,0,0,0" Click="Stop_Click" AutomationProperties.AutomationId="CC.P8.Automation.Stop"/><Button Content="Claim detected evidence" Margin="8,0,0,0" Click="Claim_Click" AutomationProperties.AutomationId="CC.P8.Automation.Claim"/><Button Content="Validate template policy" Margin="8,0,0,0" Click="ValidateTemplate_Click" AutomationProperties.AutomationId="CC.P8.Automation.ValidateTemplate"/><Button Content="Configure local trigger" Margin="8,0,0,0" Click="Configure_Click" AutomationProperties.AutomationId="CC.P8.Automation.Configure"/><Button Content="Open History" Margin="8,0,0,0" Click="History_Click" AutomationProperties.AutomationId="CC.P8.Automation.OpenHistory"/><Button Content="Open Print Center" Margin="8,0,0,0" Click="PrintCenter_Click" AutomationProperties.AutomationId="CC.P8.Automation.OpenPrintCenter"/></DockPanel></Grid></Window>
