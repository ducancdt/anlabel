<Window x:Class="ANLAbel.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel - Help and User Guide"
        Height="700" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#0D237A" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="GuideTitle" Text="📖 User Guide" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton x:Name="LangEn" Content="English" IsChecked="True" Foreground="White" FontSize="11" Margin="0,0,10,0" Checked="LangEn_Checked"/>
                            <RadioButton x:Name="LangVi" Content="Tiếng Việt" Foreground="White" FontSize="11" Checked="LangVi_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ListBox x:Name="NavListBox" SelectionChanged="NavListBox_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         FontSize="12" Padding="0,4">
                    <ListBoxItem Padding="10,7" IsSelected="True" Tag="overview">🏠 Overview</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="quickstart">⚡ Quick Start</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="ribbon">🔧 Ribbon Toolbar</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="canvas">🎨 Design Canvas</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="objects">📦 Objects</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="properties">🎛️ Properties Panel</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="barcode">📊 Barcode &amp; QR</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="binding">🔗 Data Binding</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="excel">📑 Excel Data</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="printer">🖨️ Printing</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="calibration">🎯 Calibration</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="shortcuts">⌨️ Keyboard Shortcuts</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="faq">❓ FAQ</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="about">ℹ️ About</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel x:Name="ContentStack">
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>