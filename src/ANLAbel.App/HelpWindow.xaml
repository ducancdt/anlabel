<Window x:Class="ANLAbel.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel - Hướng dẫn sử dụng"
        Height="700" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource AppPrimaryBrush}" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="GuideTitle" Text="📖 Hướng dẫn sử dụng" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="NavListBox" SelectionChanged="NavListBox_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         FontSize="12" Padding="0,4">
                    <ListBoxItem Padding="10,7" IsSelected="True" Tag="overview">🏠 Tổng quan</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="quickstart">⚡ Hướng dẫn nhanh</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="ribbon">🔧 Thanh công cụ</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="canvas">🎨 Bảng thiết kế</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="objects">📦 Đối tượng</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="properties">🎛️ Bảng thuộc tính</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="barcode">📊 Mã vạch &amp; QR</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="binding">🔗 Liên kết dữ liệu</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="excel">📑 Dữ liệu Excel</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="printer">🖨️ In ấn</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="calibration">🎯 Hiệu chỉnh</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="shortcuts">⌨️ Phím tắt</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="faq">❓ Hỏi đáp</ListBoxItem>
                    <ListBoxItem Padding="10,7" Tag="about">ℹ️ Giới thiệu</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel x:Name="ContentStack">
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
