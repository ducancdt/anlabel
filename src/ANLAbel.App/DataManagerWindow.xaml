<Window x:Class="ANLAbel.App.DataManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ANLAbel.App.Controls"
        xmlns:enums="clr-namespace:ANLAbel.Core.Enums;assembly=ANLAbel.Core"
        Title="Quản lý dữ liệu" Width="1000" Height="660" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F1F1F1">
    <!-- NiceLabel 10 Dynamic Data Manager (datasources/view/datasourcesdialogview.xaml): a small ribbon,
         the label's data in a tree on the left, the selected item's settings on the right, OK / Cancel.
         Prompt variables, functions and the counter are edited on a draft that OK applies as one undo step. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ANLAbel.App;component/Themes/Ribbon.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="EditorTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontFamily" Value="Segoe UI Light"/>
                <Setter Property="Foreground" Value="#262626"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="EditorHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#5B6B80"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="EditorLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#262626"/>
                <Setter Property="Margin" Value="0,10,0,3"/>
            </Style>
            <Style x:Key="EditorSection" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1F4E79"/>
                <Setter Property="Margin" Value="0,18,0,0"/>
            </Style>
            <Style x:Key="EditorNote" TargetType="Border">
                <Setter Property="Background" Value="#F4F7FB"/>
                <Setter Property="BorderBrush" Value="#D6E2F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,14,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Small ribbon: Thêm · Sửa · Cơ sở dữ liệu · Biến · Nhập -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RibbonBodyBrush}" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="0,0,0,1"
                TextOptions.TextFormattingMode="Ideal">
            <StackPanel Style="{StaticResource RibbonPanel}">
                <controls:RibbonGroupPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.AddVariable32}" Content="Biến&#10;nhập khi in" Click="AddVariable_Click"
                                ToolTip="Thêm một giá trị người in nhập mỗi lần in ({?Tên})" AutomationProperties.AutomationId="DataManager.AddVariable"/>
                        <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.AddFunction32}" Content="Hàm" Click="AddFunction_Click"
                                ToolTip="Thêm một trường tính từ dữ liệu khác ({Tên})" AutomationProperties.AutomationId="DataManager.AddFunction"/>
                        <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Counter32}" Content="Bộ đếm&#10;Serial" Click="Counter_Click"
                                ToolTip="Bật và đặt bộ đếm Serial của tem ({#SERIAL})" AutomationProperties.AutomationId="DataManager.Counter"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Thêm"/>
                </controls:RibbonGroupPanel>
                <Border Style="{StaticResource RibbonGroupSeparator}"/>
                <controls:RibbonGroupPanel>
                    <Button x:Name="DeleteButton" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Delete32}" Content="Xóa" Click="Delete_Click"
                            ToolTip="Xóa biến hoặc hàm đang chọn; với bộ đếm: tắt bộ đếm" AutomationProperties.AutomationId="DataManager.Delete"/>
                    <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Sửa"/>
                </controls:RibbonGroupPanel>
                <Border Style="{StaticResource RibbonGroupSeparator}"/>
                <controls:RibbonGroupPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.Excel32}" Content="Excel" Click="Excel_Click"
                                ToolTip="Liên kết sổ làm việc Excel làm cơ sở dữ liệu của tem" AutomationProperties.AutomationId="DataManager.Excel"/>
                        <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.TextFile32}" Content="Tệp&#10;văn bản" Click="TextFile_Click"
                                ToolTip="Liên kết tệp CSV làm cơ sở dữ liệu của tem" AutomationProperties.AutomationId="DataManager.TextFile"/>
                        <Button x:Name="EditDatabaseButton" Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.EditDatabase32}" Content="Sửa cơ sở&#10;dữ liệu" Click="EditDatabase_Click"
                                ToolTip="Đổi tệp, trang tính và các trường dùng trên tem" AutomationProperties.AutomationId="DataManager.EditDatabase"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Cơ sở dữ liệu"/>
                </controls:RibbonGroupPanel>
                <Border Style="{StaticResource RibbonGroupSeparator}"/>
                <controls:RibbonGroupPanel>
                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.PromptOrder32}" Content="Thứ tự&#10;nhắc" Click="PromptOrder_Click"
                            ToolTip="Thứ tự các câu hỏi khi in" AutomationProperties.AutomationId="DataManager.PromptOrder"/>
                    <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Biến"/>
                </controls:RibbonGroupPanel>
                <Border Style="{StaticResource RibbonGroupSeparator}"/>
                <controls:RibbonGroupPanel>
                    <Button Style="{StaticResource RibbonLargeButton}" controls:Ribbon.Icon="{StaticResource Icon.ImportDataSources32}" Content="Nhập nguồn&#10;dữ liệu" Click="Import_Click"
                            ToolTip="Lấy biến nhập khi in và hàm từ một tem khác" AutomationProperties.AutomationId="DataManager.Import"/>
                    <TextBlock Style="{StaticResource RibbonGroupCaption}" Text="Nhập"/>
                </controls:RibbonGroupPanel>
            </StackPanel>
        </Border>

        <!-- OK / Hủy -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Đồng ý" MinWidth="90" IsDefault="True" Click="Ok_Click" AutomationProperties.AutomationId="DataManager.Ok"/>
                    <Button Content="Hủy" MinWidth="90" Margin="8,0,0,0" IsCancel="True" AutomationProperties.AutomationId="DataManager.Cancel"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="#5B6B80" TextTrimming="CharacterEllipsis"
                           Text="Biến, hàm và bộ đếm được lưu vào tem khi bấm Đồng ý; cơ sở dữ liệu thay đổi ngay."/>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="170"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>
            <Border Background="#FFFFFF" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="1">
                <TreeView x:Name="DataTree" BorderThickness="0" Padding="2,4" SelectedItemChanged="DataTree_SelectedItemChanged"
                          AutomationProperties.Name="Dữ liệu của tem" AutomationProperties.AutomationId="DataManager.Tree"/>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource RibbonLineBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18,14,18,18" MaxWidth="620" HorizontalAlignment="Left">
                        <!-- A category: what it is, and how to add one -->
                        <StackPanel x:Name="CategoryEditor">
                            <TextBlock x:Name="CategoryTitle" Style="{StaticResource EditorTitle}" Text="Dữ liệu của tem"/>
                            <TextBlock x:Name="CategoryHint" Style="{StaticResource EditorHint}"/>
                            <Button x:Name="CategoryAddButton" HorizontalAlignment="Left" Padding="14,5" Click="CategoryAdd_Click" AutomationProperties.AutomationId="DataManager.CategoryAdd"/>
                        </StackPanel>

                        <!-- Prompt variable -->
                        <StackPanel x:Name="PromptEditor" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource EditorTitle}" Text="Biến nhập khi in"/>
                            <TextBlock Style="{StaticResource EditorHint}"
                                       Text="Người in nhập giá trị này mỗi lần in. Đối tượng dùng nó qua {?Tên}; giá trị được ghi cùng lệnh in để in lại đúng như cũ."/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Tên"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên biến" AutomationProperties.AutomationId="DataManager.Prompt.Name"/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Câu nhắc khi in"/>
                            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Câu nhắc khi in" AutomationProperties.AutomationId="DataManager.Prompt.Prompt"/>
                            <!-- NiceLabel 10 variable data type: the input rules follow the kind of value. -->
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Kiểu giá trị"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PromptKindText" GroupName="PromptKind" Content="Chữ" Checked="PromptKind_Checked" AutomationProperties.AutomationId="DataManager.Prompt.KindText"/>
                                <RadioButton x:Name="PromptKindDate" GroupName="PromptKind" Content="Ngày (người in chọn trên lịch)" Margin="18,0,0,0" Checked="PromptKind_Checked" AutomationProperties.AutomationId="DataManager.Prompt.KindDate"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DateFormat}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource EditorLabel}" Text="Định dạng ngày khi in"/>
                                <ComboBox IsEditable="True" Width="160" HorizontalAlignment="Left" Text="{Binding DateFormat, UpdateSourceTrigger=LostFocus}"
                                          ToolTip="Người in chọn ngày trên lịch. dd/MM/yyyy in 31/12/2026; yyMMdd in 261231; yyyy-MM-dd in 2026-12-31."
                                          AutomationProperties.Name="Định dạng ngày khi in" AutomationProperties.AutomationId="DataManager.Prompt.DateFormat">
                                    <ComboBoxItem Content="dd/MM/yyyy"/>
                                    <ComboBoxItem Content="yyMMdd"/>
                                    <ComboBoxItem Content="yyyyMMdd"/>
                                    <ComboBoxItem Content="yyyy-MM-dd"/>
                                    <ComboBoxItem Content="dd.MM.yyyy"/>
                                    <ComboBoxItem Content="MM/yyyy"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource EditorHint}" Margin="0,4,0,0"
                                           Text="dd/MM/yyyy in 31/12/2026; yyMMdd in 261231; yyyy-MM-dd in 2026-12-31. Lệnh in giữ ngày dạng yyyy-MM-dd; giá trị mặc định cũng ghi như vậy hoặc dd/MM/yyyy."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Giá trị mặc định"/>
                            <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Giá trị mặc định" AutomationProperties.AutomationId="DataManager.Prompt.Default"/>
                            <CheckBox Content="Bắt buộc nhập" Margin="0,8,0,0" IsChecked="{Binding Required}"/>
                            <!-- Text rules: a date is picked, so they apply to text values only. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DateFormat}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource EditorSection}" Text="Quy tắc nhập"/>
                                <TextBlock Style="{StaticResource EditorLabel}" Text="Số ký tự (0 = không giới hạn)"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="tối thiểu" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Width="64" Text="{Binding MinLength, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Người in phải nhập ít nhất chừng này ký tự, để bắt giá trị quét hoặc gõ thiếu."
                                             AutomationProperties.Name="Số ký tự tối thiểu" AutomationProperties.AutomationId="DataManager.Prompt.MinLength"/>
                                    <TextBlock Text="tối đa" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                    <TextBox Width="64" Text="{Binding MaxLength, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="Số ký tự tối đa" AutomationProperties.AutomationId="DataManager.Prompt.MaxLength"/>
                                </StackPanel>
                                <CheckBox Content="Độ dài cố định (đúng số ký tự tối đa)" Margin="0,8,0,0" IsChecked="{Binding FixedLength}" AutomationProperties.AutomationId="DataManager.Prompt.FixedLength"/>
                                <CheckBox Content="Chỉ nhận chữ số" Margin="0,6,0,0" IsChecked="{Binding DigitsOnly}"/>
                                <TextBlock Style="{StaticResource EditorLabel}" Text="Chỉ nhận các ký tự (để trống = mọi ký tự)"/>
                                <TextBox Text="{Binding AllowedCharacters, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ký tự cho phép" AutomationProperties.AutomationId="DataManager.Prompt.AllowedCharacters"/>
                                <TextBlock Style="{StaticResource EditorLabel}" Text="Danh sách chọn (mỗi dòng một giá trị; người in chọn trong danh sách)"/>
                                <TextBox Text="{Binding PickList, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Danh sách chọn" AutomationProperties.AutomationId="DataManager.Prompt.PickList"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource EditorSection}" Text="Khi in"/>
                            <TextBlock Style="{StaticResource EditorHint}" Margin="0,2,0,0"
                                       Text="Tiền tố in trước giá trị, hậu tố in sau; chữ còn đệm được đến số ký tự tối đa."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Tiền tố"/>
                                    <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" ToolTip="In trước giá trị" AutomationProperties.Name="Tiền tố" AutomationProperties.AutomationId="DataManager.Prompt.Prefix"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Hậu tố"/>
                                    <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" ToolTip="In sau giá trị" AutomationProperties.Name="Hậu tố" AutomationProperties.AutomationId="DataManager.Prompt.Suffix"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DateFormat}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ComboBox Width="140" SelectedValue="{Binding Padding}" SelectedValuePath="Tag" AutomationProperties.Name="Đệm" AutomationProperties.AutomationId="DataManager.Prompt.Padding">
                                    <ComboBoxItem Content="Không đệm" Tag="{x:Static enums:PromptPadding.None}"/>
                                    <ComboBoxItem Content="Đệm bên trái" Tag="{x:Static enums:PromptPadding.Left}"/>
                                    <ComboBoxItem Content="Đệm bên phải" Tag="{x:Static enums:PromptPadding.Right}"/>
                                </ComboBox>
                                <TextBlock Text="bằng ký tự" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                <TextBox Width="36" MaxLength="1" Text="{Binding PadCharacter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ký tự đệm" AutomationProperties.AutomationId="DataManager.Prompt.PadCharacter">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Padding}" Value="{x:Static enums:PromptPadding.None}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                            <Border Style="{StaticResource EditorNote}">
                                <TextBlock x:Name="PromptUsageText" TextWrapping="Wrap" Foreground="#262626"/>
                            </Border>
                        </StackPanel>

                        <!-- Function -->
                        <StackPanel x:Name="FunctionEditor" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource EditorTitle}" Text="Hàm"/>
                            <TextBlock Style="{StaticResource EditorHint}"
                                       Text="Một trường tính từ dữ liệu khác, trước khi xem trước và in. Đối tượng dùng nó như một trường: {Tên}."/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Tên trường kết quả"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên hàm" AutomationProperties.AutomationId="DataManager.Function.Name"/>
                            <DockPanel>
                                <!-- NiceLabel's "Insert special character": an ISO/IEC 15434 envelope needs RS, GS and EOT -->
                                <Button DockPanel.Dock="Right" Content="Ký tự điều khiển ▾" Padding="6,1" Margin="0,8,0,2" Click="ControlCharacters_Click"
                                        ToolTip="Chèn RS, GS, EOT hay xuống dòng vào công thức, cho mã 2D theo ISO/IEC 15434 ([)&gt; RS 06 GS … RS EOT)."
                                        AutomationProperties.AutomationId="DataManager.Function.ControlCharacters">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="RS — ngăn cách bản ghi" InputGestureText="\u001E" Tag="\u001E" Click="InsertControlCharacter_Click"/>
                                            <MenuItem Header="GS — ngăn cách nhóm" InputGestureText="\u001D" Tag="\u001D" Click="InsertControlCharacter_Click"/>
                                            <MenuItem Header="EOT — kết thúc" InputGestureText="\u0004" Tag="\u0004" Click="InsertControlCharacter_Click"/>
                                            <MenuItem Header="Xuống dòng" InputGestureText="\n" Tag="\n" Click="InsertControlCharacter_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBlock Style="{StaticResource EditorLabel}" Text="Công thức"/>
                            </DockPanel>
                            <TextBox x:Name="FunctionFormulaBox" Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" MinHeight="56" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Công thức" AutomationProperties.AutomationId="DataManager.Function.Formula"/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Kết quả với dòng dữ liệu hiện tại"/>
                            <Border Style="{StaticResource EditorNote}" Margin="0,2,0,0">
                                <TextBlock x:Name="FunctionResultText" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#262626"/>
                            </Border>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Cách viết"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#262626" Margin="0,0,0,4"
                                       Text="FIELD(&quot;Tên trường&quot;) lấy một trường; CONCAT(a, b, …) nối các phần; UPPER(x), LOWER(x), TRIM(x) đổi chữ; LEFT(x, n), RIGHT(x, n), MID(x, đầu, n) cắt chuỗi; GS1CHECKDIGIT(x) thêm số kiểm tra GS1; EQUALS(a, b), NOT(x), AND(…) cho điều kiện hiển thị; DATEADD(ngày, số, đơn vị, định dạng) và DATEFORMAT(ngày, định dạng) tính và ghi ngày. Trong chuỗi, \u001E, \u001D, \u0004 là ký tự RS, GS, EOT (nút Ký tự điều khiển)."/>
                            <TextBlock TextWrapping="Wrap" FontFamily="Consolas" Foreground="#1F4F91"
                                       Text="CONCAT(FIELD(&quot;Mã&quot;), &quot;-&quot;, FIELD(&quot;Lô&quot;))"/>
                            <TextBlock x:Name="FunctionFieldsText" TextWrapping="Wrap" Foreground="#5B6B80" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Serial counter -->
                        <StackPanel x:Name="CounterEditor" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource EditorTitle}" Text="Bộ đếm Serial"/>
                            <TextBlock Style="{StaticResource EditorHint}"
                                       Text="Mỗi tem in ra một số tiếp theo, dùng qua {#SERIAL}. Số được giữ chỗ cho lệnh in trước khi in và không bao giờ dùng lại."/>
                            <CheckBox Content="Bật bộ đếm" FontWeight="SemiBold" IsChecked="{Binding Enabled}" AutomationProperties.AutomationId="DataManager.Counter.Enabled"/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Kiểu số"/>
                            <ComboBox x:Name="CounterAlphabetBox" Width="260" HorizontalAlignment="Left" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                      SelectedValue="{Binding Alphabet}" AutomationProperties.Name="Kiểu số"/>
                            <StackPanel x:Name="CustomAlphabetPanel">
                                <TextBlock Style="{StaticResource EditorLabel}" Text="Các ký tự, từ nhỏ đến lớn"/>
                                <TextBox Text="{Binding CustomAlphabet, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Các ký tự của bộ đếm"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Bắt đầu từ"/>
                                    <TextBox Text="{Binding StartValue, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Bắt đầu từ"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Bước tăng"/>
                                    <TextBox Text="{Binding Step, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Bước tăng"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Đổi số sau mỗi"/>
                                    <TextBox Text="{Binding ChangeEvery, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Đổi số sau mỗi số tem"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Nhỏ nhất"/>
                                    <TextBox Text="{Binding MinimumValue, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Giá trị nhỏ nhất"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Lớn nhất"/>
                                    <TextBox Text="{Binding MaximumValue, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Giá trị lớn nhất"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Số chữ số (0 = không đệm)"/>
                                    <TextBox Text="{Binding Digits, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Số chữ số"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Tiền tố"/>
                                    <TextBox Text="{Binding Prefix, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Tiền tố"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Hậu tố"/>
                                    <TextBox Text="{Binding Suffix, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hậu tố"/>
                                </StackPanel>
                            </UniformGrid>
                            <CheckBox Content="Quay vòng khi vượt giới hạn (không quay vòng: dừng in)" Margin="0,12,0,0" IsChecked="{Binding Rollover}"/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Thư mục dùng chung (để trống: chỉ máy này)"/>
                            <TextBox Text="{Binding SharedFolder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Thư mục dùng chung của bộ đếm"/>
                            <Border Style="{StaticResource EditorNote}">
                                <StackPanel>
                                    <TextBlock x:Name="CounterStatusText" TextWrapping="Wrap" Foreground="#262626"/>
                                    <Button Content="Bắt đầu lại dãy số…" HorizontalAlignment="Left" Padding="10,3" Margin="0,8,0,0" Click="CounterReset_Click"
                                            ToolTip="Dãy số mới bắt đầu từ giá trị Bắt đầu từ; số đã in không bị xóa khỏi lịch sử" AutomationProperties.AutomationId="DataManager.Counter.Reset"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Database -->
                        <StackPanel x:Name="DatabaseEditor" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource EditorTitle}" Text="Cơ sở dữ liệu"/>
                            <TextBlock x:Name="DatabaseSummaryText" Style="{StaticResource EditorHint}"/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Trường dùng trên tem"/>
                            <TextBlock x:Name="DatabaseFieldsText" TextWrapping="Wrap" Foreground="#262626"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Sửa cơ sở dữ liệu…" Padding="10,4" Margin="0,0,8,6" Click="EditDatabase_Click"/>
                                <Button Content="Nạp lại dữ liệu" Padding="10,4" Margin="0,0,8,6" Click="ReloadDatabase_Click"/>
                                <Button Content="Bỏ liên kết…" Padding="10,4" Margin="0,0,8,6" Click="UnlinkDatabase_Click"/>
                            </WrapPanel>
                            <Border Style="{StaticResource EditorNote}">
                                <TextBlock TextWrapping="Wrap" Foreground="#262626"
                                           Text="Thay đổi cơ sở dữ liệu áp dụng ngay cho tem, không chờ Đồng ý (như ở thẻ Dữ liệu)."/>
                            </Border>
                        </StackPanel>

                        <!-- Internal variables -->
                        <StackPanel x:Name="InternalEditor" Visibility="Collapsed">
                            <TextBlock x:Name="InternalTitle" Style="{StaticResource EditorTitle}"/>
                            <TextBlock x:Name="InternalHint" Style="{StaticResource EditorHint}"/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="Viết trên tem"/>
                            <TextBox x:Name="InternalTokenBox" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Mã biến nội bộ"/>
                            <Border Style="{StaticResource EditorNote}">
                                <TextBlock x:Name="InternalValueText" TextWrapping="Wrap" Foreground="#262626"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
