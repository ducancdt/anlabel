<Window x:Class="ANLAbel.App.PrintHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel - Lịch sử in" Width="1180" Height="720" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        AutomationProperties.AutomationId="CC.P5.History.Root" AutomationProperties.Name="Print history">
    <Window.Resources><SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="AppBorderBrush" Color="#D9E2EC"/><SolidColorBrush x:Key="AppMutedBrush" Color="#64748B"/></Window.Resources>
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="{Binding RefreshButtonText}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" AutomationProperties.AutomationId="CC.P5.History.Refresh" AutomationProperties.Name="Refresh print history"/>
            <StackPanel><TextBlock Text="Lịch sử in" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Nguồn gốc chỉ đọc theo vòng đời lưu bền, vết thao tác bổ sung và tóm tắt CSV đã che." Margin="0,4,0,0" Foreground="{StaticResource AppMutedBrush}"/><TextBlock Text="{Binding StatusText}" Margin="0,7,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="CC.P5.History.SourceStatus" AutomationProperties.Name="History source status"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Padding="10" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.AutomationId="CC.P5.History.Filters" AutomationProperties.Name="History filters"><TextBox Width="320" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm lệnh, mẫu tem, hàng đợi hoặc vòng đời" AutomationProperties.AutomationId="CC.P5.History.Search" AutomationProperties.Name="Search print history"/></Border>
            <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.AutomationId="CC.P5.History.ActivityTable" AutomationProperties.Name="Print activity"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding TimestampText}" Width="165"/><DataGridTextColumn Header="Lệnh / bản ghi" Binding="{Binding RecordId}" Width="190"/><DataGridTextColumn Header="Loại" Binding="{Binding RecordType}" Width="110"/><DataGridTextColumn Header="Mẫu tem / hàng đợi" Binding="{Binding TemplateOrQueue}" Width="*"/><DataGridTextColumn Header="Vòng đời" Binding="{Binding Lifecycle}" Width="170"/><DataGridTextColumn Header="Bằng chứng" Binding="{Binding Evidence}" Width="220"/><DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="155"/></DataGrid.Columns></DataGrid>
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.AutomationId="CC.P5.History.Detail" AutomationProperties.Name="Selected job evidence"><TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Foreground="{StaticResource AppMutedBrush}"/></Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click"/><StackPanel Orientation="Horizontal"><Button Content="Mở Trung tâm in" Click="Center_Click" AutomationProperties.AutomationId="CC.P5.History.OpenPrintCenter" AutomationProperties.Name="Open Print Center"/><TextBlock Text="Phục hồi và in lại có kiểm soát vẫn ở Trung tâm in." Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AppMutedBrush}" AutomationProperties.AutomationId="CC.P5.History.ReprintEligibility" AutomationProperties.Name="Reprint eligibility"/></StackPanel></DockPanel>
    </Grid>
</Window>
