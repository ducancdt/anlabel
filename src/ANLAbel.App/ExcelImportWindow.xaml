<Window x:Class="ANLAbel.App.ExcelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Excel / Database Fields"
        Height="640" Width="760"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F6">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E2EC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Import Excel / Database Fields" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Choose an Excel file, select a sheet, then decide which fields are allowed for label design and functions." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="96" Height="32" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="Excel file" FontWeight="SemiBold"/>
                        <TextBlock Text="Pick any .xlsx/.xlsm file from your computer." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBox x:Name="FilePathTextBox" Grid.Row="2" Text="{Binding Template.DatabaseConfig.FilePath, Mode=OneWay}" IsReadOnly="True" MinHeight="32" Padding="8,5"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Width="104" Click="Browse_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="All fields from Excel" FontWeight="SemiBold"/>
                            <TextBlock Text="Fields found in the imported sheet." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8"/>
                        </StackPanel>
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
                            <Button Content="Add &gt;" Command="{Binding AddDatabaseFieldCommand}" Margin="0,0,5,0"/>
                            <Button Content="Add all" Command="{Binding AddAllDatabaseFieldsCommand}" Margin="5,0,0,0"/>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding AvailableDatabaseFields}" SelectedItem="{Binding SelectedAvailableDatabaseField, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="{Binding SampleValue, StringFormat=Sample: {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Fields used on label" FontWeight="SemiBold"/>
                            <TextBlock Text="Only these fields appear in Properties and Function Builder." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8"/>
                        </StackPanel>
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
                            <Button Content="&lt; Remove" Command="{Binding RemoveDatabaseFieldCommand}" Margin="0,0,5,0"/>
                            <Button Content="Clear" Command="{Binding ClearDatabaseFieldsCommand}" Margin="5,0,0,0"/>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding LabelDatabaseFields}" SelectedItem="{Binding SelectedLabelDatabaseField, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="{Binding SampleValue, StringFormat=Sample: {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>