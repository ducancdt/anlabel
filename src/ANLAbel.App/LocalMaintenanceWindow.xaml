<Window x:Class="ANLAbel.App.LocalMaintenanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Bảo trì cục bộ" Width="980" Height="620" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" AutomationProperties.AutomationId="CC.P7.Maintenance.Root" AutomationProperties.Name="Local maintenance">
<Window.Resources><SolidColorBrush x:Key="Border" Color="#D9E2EC"/><SolidColorBrush x:Key="Muted" Color="#64748B"/><Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Làm mới trạng thái nguồn" Click="Refresh_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.Refresh"/><StackPanel><TextBlock Text="Bảo trì cục bộ" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Chỉ bằng chứng cục bộ và bảo trì định tuyến theo chủ sở hữu" Margin="0,5,0,0" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
<ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tùy chọn trình thiết kế" FontWeight="SemiBold"/><TextBlock Text="{Binding PreferencesStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.PreferencesStatus"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Mặc định máy in" FontWeight="SemiBold"/><TextBlock Text="Việc chọn máy in do chủ sở hữu Thiết lập máy in hiện có quản lý." Margin="0,5,8,9" Foreground="{StaticResource Muted}"/><Button Content="Mở Thiết lập máy in" HorizontalAlignment="Left" Click="PrinterSetup_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.PrinterSetup"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Nguồn dữ liệu dùng chung" FontWeight="SemiBold"/><TextBlock Text="{Binding RegistryStatus}" Margin="0,5,0,9" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.RegistryStatus"/><WrapPanel><Button Content="Quản lý nguồn dữ liệu" Click="DataSources_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.DataSources"/><Button Content="Mở dọn dẹp" Margin="8,0,0,0" Click="Cleanup_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.Cleanup"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bằng chứng cục bộ" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceStatus}" Margin="0,5,0,9" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.SourceStatus"/><WrapPanel><Button Content="Mở Lịch sử" Click="History_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.History"/><Button Content="Mở Phân tích" Margin="8,0,0,0" Click="Analytics_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.Analytics"/><Button Content="Mở Trung tâm in" Margin="8,0,0,0" Click="PrintCenter_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.PrintCenter"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}" Background="#FFF7ED" BorderBrush="#FDBA74"><StackPanel><TextBlock Text="Lưu giữ và phục hồi" FontWeight="SemiBold"/><TextBlock Text="{Binding RetentionStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.RetentionStatus"/></StackPanel></Border>
</StackPanel></ScrollViewer><Button Grid.Row="2" Content="Đóng" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/></Grid></Window>
