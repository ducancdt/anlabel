<Window x:Class="ANLAbel.App.LocalMaintenanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Local Maintenance" Width="980" Height="620" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" AutomationProperties.AutomationId="CC.P7.Maintenance.Root" AutomationProperties.Name="Local maintenance">
<Window.Resources><SolidColorBrush x:Key="Border" Color="#D9E2EC"/><SolidColorBrush x:Key="Muted" Color="#64748B"/><Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Refresh source status" Click="Refresh_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.Refresh"/><StackPanel><TextBlock Text="Local Maintenance" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Local evidence and owner-routed maintenance only" Margin="0,5,0,0" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
<ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Designer preferences" FontWeight="SemiBold"/><TextBlock Text="{Binding PreferencesStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.PreferencesStatus"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Printer defaults" FontWeight="SemiBold"/><TextBlock Text="Printer selection is managed by the existing Printer Setup owner." Margin="0,5,8,9" Foreground="{StaticResource Muted}"/><Button Content="Open Printer Setup" HorizontalAlignment="Left" Click="PrinterSetup_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.PrinterSetup"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Shared data sources" FontWeight="SemiBold"/><TextBlock Text="{Binding RegistryStatus}" Margin="0,5,0,9" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.RegistryStatus"/><WrapPanel><Button Content="Manage data sources" Click="DataSources_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.DataSources"/><Button Content="Open cleanup" Margin="8,0,0,0" Click="Cleanup_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.Cleanup"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local evidence" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceStatus}" Margin="0,5,0,9" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.SourceStatus"/><WrapPanel><Button Content="Open History" Click="History_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.History"/><Button Content="Open Analytics" Margin="8,0,0,0" Click="Analytics_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.Analytics"/><Button Content="Open Print Center" Margin="8,0,0,0" Click="PrintCenter_Click" AutomationProperties.AutomationId="CC.P7.Maintenance.PrintCenter"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}" Background="#FFF7ED" BorderBrush="#FDBA74"><StackPanel><TextBlock Text="Retention and recovery" FontWeight="SemiBold"/><TextBlock Text="{Binding RetentionStatus}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CC.P7.Maintenance.RetentionStatus"/></StackPanel></Border>
</StackPanel></ScrollViewer><Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/></Grid></Window>
