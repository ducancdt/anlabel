<Window x:Class="ANLAbel.App.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ANLAbel.App"
        xmlns:vm="clr-namespace:ANLAbel.App.ViewModels"
        Title="ANLAbel Print Preview" Height="760" Width="1200"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppCanvasBrush}">
    <Window.Resources>
        <local:BoolToCheckmarkConverter x:Key="BoolToCheckmarkConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Background="{DynamicResource AppPrimaryBrush}" Padding="16,12">
                <TextBlock Text="{Binding PreviewTitle}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
            </Border>
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentRowSummary}" TextWrapping="Wrap" Foreground="#334155" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀" Width="36" Click="PreviousPage_Click" ToolTip="Previous label"/>
                            <TextBox Text="{Binding PageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52" TextAlignment="Center" KeyDown="PageInput_KeyDown"/>
                            <TextBlock Text="{Binding PageStatusText}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                            <Button Content="▶" Width="36" Click="NextPage_Click" ToolTip="Next label"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The row list scrolls internally, so cap it to preserve the label preview on 720p displays. -->
                <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" MaxHeight="220">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,6,10,3">
                        <TextBlock Text="Excel Data" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedRowsText}" Foreground="#475569" FontSize="10" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- Row filter: find rows by value (e.g. a product code) among many rows and
                         print only the matches, without editing the source Excel file. -->
                    <Grid DockPanel.Dock="Top" Margin="10,0,10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔎" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                        <TextBox Grid.Column="1" x:Name="RowFilterBox" VerticalAlignment="Center" FontSize="11" Padding="4,3"
                                 ToolTip="Type a value (e.g. a product code) to find matching rows. Matching rows are auto-selected for printing; the rest are deselected."
                                 TextChanged="RowFilterBox_TextChanged" PreviewKeyDown="RowFilterBox_PreviewKeyDown"/>
                        <ComboBox Grid.Column="2" x:Name="RowFilterColumnCombo" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                  ToolTip="Limit the search to one column (default: all columns)"
                                  SelectionChanged="RowFilterColumnCombo_SelectionChanged"/>
                        <Button Grid.Column="3" Content="✕" Width="22" Margin="4,0,0,0" ToolTip="Clear filter (select all rows again)" Click="ClearRowFilter_Click"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" x:Name="FilterMatchCountText" Margin="10,0,10,4" FontSize="10" Foreground="#0F4C81" FontWeight="SemiBold" Visibility="Collapsed"/>
                    <!-- Header row -->
                    <Grid Background="#F1F5F9" Margin="6,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="☑ All" FontWeight="SemiBold" FontSize="9" Background="Transparent" BorderThickness="0" Margin="2,0" Click="SelectAllToggle_Click"/>
                        <TextBlock Grid.Column="1" Text="Pg#" FontWeight="SemiBold" FontSize="10" Margin="4,2"/>
                        <TextBlock Grid.Column="2" Text="Row" FontWeight="SemiBold" FontSize="10" Margin="4,2"/>
                        <TextBlock Grid.Column="3" Text="Cp" FontWeight="SemiBold" FontSize="10" Margin="4,2"/>
                        <TextBlock Grid.Column="4" Text="🖶" FontSize="9" Margin="2,2" ToolTip="Printed this session"/>
                    </Grid>
                    <!-- Virtualized row list: the outer preview panel may contain 10k source rows;
                         never put an ItemsControl inside a ScrollViewer because that disables
                         WPF item virtualization and creates every row visual eagerly. -->
                    <ListBox x:Name="TrackingList"
                             Margin="6,0,6,4"
                             FontSize="11"
                             MinHeight="80"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackingRowViewModel}">
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Clickable checkmark -->
                                            <Button Grid.Column="0"
                                                    Content="{Binding CheckmarkText}"
                                                    FontSize="14"
                                                    Padding="4,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Click="ToggleRowCheck_Click"
                                                    Tag="{Binding SourceRowNumber}"/>
                                            <!-- Page number -->
                                            <TextBlock Grid.Column="1" Text="{Binding PageNumber}" Margin="4,0"/>
                                            <!-- Row number -->
                                            <TextBlock Grid.Column="2" Text="{Binding SourceRowNumber}" Margin="4,0"/>
                                            <!-- Copies count -->
                                            <TextBlock Grid.Column="3" Text="{Binding CopiesDisplay}" Margin="4,0" TextAlignment="Center"/>
                                            <!-- Up/Down buttons -->
                                            <Button Grid.Column="4" Content="▲" FontSize="7" Width="18" Height="16"
                                                    Padding="0" Margin="0,0"
                                                    Click="CopiesUp_Click" Tag="{Binding SourceRowNumber}"/>
                                            <Button Grid.Column="5" Content="▼" FontSize="7" Width="18" Height="16"
                                                    Padding="0" Margin="1,0"
                                                    Click="CopiesDown_Click" Tag="{Binding SourceRowNumber}"/>
                                            <!-- Printed-this-session indicator -->
                                            <TextBlock Grid.Column="6" Text="{Binding PrintedIndicatorText}" FontSize="9" Margin="2,0" ToolTip="Device-confirmed completion in this session — printing again may duplicate a label"/>
                                            <!-- Excel data preview -->
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="4,0">
                                                <TextBlock Text="{Binding Col1}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Col2}" Margin="0,0,6,0" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Col3}" Margin="0,0,6,0" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Col4}" Foreground="#64748B"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </Border>

                <ScrollViewer x:Name="PreviewScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel">
                    <Grid Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}"/>
                        </Grid.LayoutTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PageStatusText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Background="White" BorderBrush="#8B95A3" BorderThickness="1" Padding="0">
                                <Grid Width="{Binding CurrentPage.Width}" Height="{Binding CurrentPage.Height}">
                                    <Image Source="{Binding CurrentPage.PreviewImage}"
                                           Width="{Binding CurrentPage.Width}"
                                           Height="{Binding CurrentPage.Height}"
                                           Stretch="Fill"
                                           SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>

        <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{DynamicResource AppPrimaryBrush}" Padding="16,12">
                    <TextBlock Text="Print Settings" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <TextBlock Text="Printer" FontWeight="SemiBold"/>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Padding="8" Margin="0,4,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding PrinterName}" TextWrapping="Wrap" Foreground="#0F172A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LabelSizeText}" Foreground="#475569" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding PrintPlanSummaryText}" Foreground="#475569" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Label size and printer setup..." Padding="8,6" Margin="0,0,0,12" Click="LabelPrinterSetup_Click"/>

                    <Border Height="1" Background="#E2E8F0" Margin="0,0,0,12"/>

                    <TextBlock Text="Print mode" FontWeight="SemiBold"/>
                    <TextBlock Text="Use checkboxes in the Excel Data table to select rows to print." TextWrapping="Wrap" Foreground="#526070" Margin="0,4,0,10"/>

                    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Padding="8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding PreflightStatusText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F4C81"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreflightIssues}" Value="True">
                                                <Setter Property="Foreground" Value="#B42318"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ProgressBar Height="6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding PreviewProgressPercent, Mode=OneWay}"
                                                 Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding PreviewProgressText}"
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Cancel"
                                        Padding="7,3"
                                        Margin="8,0,0,0"
                                        Click="CancelPreview_Click"
                                        IsEnabled="{Binding CanCancelPreview}"
                                        Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                            <Expander Header="Preflight issues" Margin="0,8,0,0">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="IsExpanded" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreflightIssues}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding PreflightIssuesSummary}" Foreground="#475569" FontSize="11" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding PreflightIssues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch"
                                                        Padding="8,6"
                                                        Margin="0,0,0,6"
                                                        Tag="{Binding RowNumber}"
                                                        Click="PreflightIssue_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11"/>
                                                        <TextBlock Text="Go to this label" Foreground="#475569" FontSize="11" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Expander Header="Label Setup" IsExpanded="False" Margin="0,12,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Label W (mm)"/>
                                    <TextBox Text="{Binding LabelTemplate.WidthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Label H (mm)"/>
                                    <TextBox Text="{Binding LabelTemplate.HeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Margin="0,4,0,10"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Apply label size" HorizontalAlignment="Right" Padding="8,5" Margin="0,4,0,0" Click="ApplyPrintSetup_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Print Method" IsExpanded="False" Margin="0,6,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Print Method" Foreground="#475569" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding PrintMethodOptions}"
                                      SelectedValue="{Binding LabelTemplate.PrinterProfile.PrintMethod, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,4,0,4"
                                      ToolTip="Application graphic (default): 100% designer parity vector/raster render. Printer native: direct thermal commands (fails closed if driver inactive)."/>
                            <TextBlock Text="Application graphic ensures 100% parity with the designer preview." Foreground="#64748B" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Calibration" IsExpanded="False" Margin="0,6,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DPI"/>
                                    <TextBox Text="{Binding LabelTemplate.PrinterProfile.Dpi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Scale X/Y"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LabelTemplate.PrinterProfile.ScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}"/>
                                        <TextBox Grid.Column="2" Text="{Binding LabelTemplate.PrinterProfile.ScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Offset X"/>
                                    <TextBox Text="{Binding LabelTemplate.PrinterProfile.OffsetXMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Offset Y"/>
                                    <TextBox Text="{Binding LabelTemplate.PrinterProfile.OffsetYMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Margin="0,4,0,10"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Print calibration" Padding="8,5" Click="PrintCalibration_Click"/>
                                <Button Grid.Column="2" Content="Reset offset/scale" Padding="8,5" Click="ResetCalibration_Click"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="Each Excel row becomes one label. Adjust copies with ▲▼ buttons." TextWrapping="Wrap" Foreground="#526070" Margin="0,14,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Close" Width="86" Margin="0,0,8,0" Padding="8,5" Click="Close_Click"/>
                        <Button Content="Print" Width="96" Padding="8,5" Click="Print_Click" IsEnabled="{Binding CanPrint}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
