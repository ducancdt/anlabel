<Window x:Class="ANLAbel.App.DataWorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Data Workspace" Width="760" Height="600" MinWidth="620" MinHeight="460" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="DataWorkspace.Root" AutomationProperties.Name="Data workspace">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Refresh sample" Click="Refresh_Click" AutomationProperties.AutomationId="DataWorkspace.Refresh"/><StackPanel><TextBlock Text="Data Workspace" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Drafts do not change preview or print until Apply." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel></DockPanel>
<Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Source fields" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding Fields}" MinHeight="120" MaxHeight="220" AutomationProperties.AutomationId="DataWorkspace.SourceFieldList"/><TextBlock Text="Committed/draft transforms" FontWeight="SemiBold" Margin="0,12,0,4"/><ListBox ItemsSource="{Binding Drafts}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" MinHeight="120" AutomationProperties.AutomationId="DataWorkspace.TransformList"/><WrapPanel Margin="0,7,0,0"><Button Content="Add" Click="Add_Click" AutomationProperties.AutomationId="DataWorkspace.AddTransform"/><Button Content="Remove" Margin="7,0,0,0" Click="Remove_Click"/></WrapPanel></StackPanel>
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Output name" FontWeight="SemiBold"/><TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DataWorkspace.TransformOutputName"/><TextBlock Text="Formula" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBox Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.AutomationId="DataWorkspace.TransformFormula"/><WrapPanel Margin="0,8,0,0"><Button Content="Validate" Click="Validate_Click" AutomationProperties.AutomationId="DataWorkspace.ValidateTransform"/><Button Content="Update draft" Margin="7,0,0,0" Click="Update_Click"/><Button Content="Apply" Margin="7,0,0,0" Click="Apply_Click" AutomationProperties.AutomationId="DataWorkspace.ApplyTransform"/></WrapPanel><Border Margin="0,14,0,0" Padding="10" Background="#F8FAFC" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="6" AutomationProperties.AutomationId="DataWorkspace.Diagnostics"><StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding Result}" FontWeight="SemiBold" Margin="0,7,0,0" AutomationProperties.AutomationId="DataWorkspace.TransformResult"/><TextBlock Text="{Binding Lineage}" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,0" AutomationProperties.AutomationId="DataWorkspace.TransformLineage"/></StackPanel></Border></StackPanel></ScrollViewer>
</Grid><Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/></Grid></Window>
