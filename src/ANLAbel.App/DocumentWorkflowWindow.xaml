<Window x:Class="ANLAbel.App.DocumentWorkflowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANLAbel - Document Workflow" Width="620" Height="460" MinWidth="520" MinHeight="380" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="CC.P4.Workflow.Root"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Document Workflow" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Margin="0,6,0,0" AutomationProperties.AutomationId="CC.P4.Workflow.Status"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="Local operator"/><TextBox Text="{Binding Actor,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Comment" Margin="0,10,0,0"/><TextBox Text="{Binding Comment,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="65"/><TextBlock Text="Available transitions" FontWeight="SemiBold" Margin="0,12,0,5"/><ItemsControl ItemsSource="{Binding Available}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Action}" Margin="0,0,0,5" Padding="8,4" Click="Transition_Click" Tag="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Close" DockPanel.Dock="Right" Click="Close_Click"/><Button Content="Refresh" Click="Refresh_Click"/></DockPanel></Grid></Window>
