<Window x:Class="ANLAbel.App.TemplateLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANLAbel - Thư viện tem nhãn"
        Height="700" Width="1000"
        MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppPrimaryBrush}" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Thư viện tem nhãn" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Foreground="#DBEAFE" FontSize="12" Margin="0,4,0,0">Chọn một mẫu, xem trước và dùng ngay trong màn thiết kế.</TextBlock>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#64748B"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="UseButton" Content="Dùng mẫu này" Click="Use_Click" IsEnabled="False"
                            Padding="16,8" Margin="0,0,8,0" Background="{DynamicResource AppPrimaryBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Đóng" Click="Close_Click" Padding="16,8" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Left filters -->
        <Border DockPanel.Dock="Left" Width="190" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="Bộ lọc" FontWeight="SemiBold" Foreground="#0F172A" Margin="14,14,0,6"/>
                <ListBox x:Name="FilterList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="Filter_SelectionChanged" Padding="6,2"/>
            </StackPanel>
        </Border>

        <!-- Gallery -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
            <ItemsControl x:Name="GalleryItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="216" Margin="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="10" Padding="0" Cursor="Hand"
                                MouseLeftButtonUp="Card_Click" MouseEnter="Card_Hover" MouseLeave="Card_Leave">
                            <StackPanel>
                                <Border Background="#F8FAFC" CornerRadius="10,10,0,0" Height="148"
                                        BorderBrush="#EEF2F6" BorderThickness="0,0,0,1" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="200" Height="140"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Margin="12,9,12,12">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="#EAF3FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#0F4EA8" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
